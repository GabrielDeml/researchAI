+        "unexpected_deviation_count": unexpected_deviation_count,
+    }
+    write_canonical_json(ROOT / "records/metrics.json", metrics)
+    make_figure(counts)
+
+    hypothesis_supported = all(
+        [
+            payload_altered == 128,
