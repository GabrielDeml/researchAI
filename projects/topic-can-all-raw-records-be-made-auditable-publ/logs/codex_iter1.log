+
+    env = os.environ.copy()
+    env["PYTHONHASHSEED"] = "0"
+    successful_workers, empty_stderr_workers = run_fresh_workers(env)
+
+    index_run = subprocess.run(
+        [str(PYTHON), str(ROOT / "index_records.py"), "--root", str(ROOT)],
