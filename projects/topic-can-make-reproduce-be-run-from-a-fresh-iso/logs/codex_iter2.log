+    commit = ["git", "commit", "-q", "-m", "Release deterministic three-output fixture"]
+    require(command(commit, cwd=source, env=fixed), commit, "fixture Git commit")
+    clone = ["git", "clone", "-q", "--bare", "--no-local", str(source), str(bare)]
+    require(command(clone), clone, "local bare release clone")
+    rev_argv = ["git", f"--git-dir={bare}", "rev-parse", "HEAD"]
+    revision = require(command(rev_argv), rev_argv, "release revision resolution").decode("ascii").strip()
+    for name in OUTPUTS:
+        show = ["git", f"--git-dir={bare}", "show", f"{revision}:reference/{name}"]
+        require(command(show), show, f"released reference blob validation for {name}")
+    write_json(ROOT / "fixture.json", {"image_id": image_id, "output_paths": OUTPUTS, "release_revision": revision, "source_path": str(source.resolve())})
+    return revision
+
+
+def run_stage(script: str) -> None:
+    argv = [sys.executable, str(ROOT / script)]
+    result = command(argv, cwd=ROOT)
+    (ROOT / f"{Path(script).stem}.stdout.log").write_bytes(result.stdout)
+    (ROOT / f"{Path(script).stem}.stderr.log").write_bytes(result.stderr)
+    if result.stdout:
+        sys.stdout.buffer.write(result.stdout)
+        sys.stdout.flush()
+    require(result, argv, script)
+
+
+def remove_containers() -> tuple[int, list[str]]:
+    removed = 0
+    failures: list[str] = []
+    for name in CONTAINERS:
+        result = command(["docker", "rm", name])
+        if result.returncode == 0:
+            removed += 1
+        else:
+            failures.append(f"{name}: {result.stderr.decode('utf-8', 'replace').strip()}")
+    return removed, failures
+
+
+def broken_results(error: BaseException) -> None:
+    message = f"{type(error).__name__}: {error}"
+    write_json(ROOT / "results.json", {
+        "classification": "BROKEN",
+        "error": message,
+        "evidence_category_checks_passed": 0,
+        "evidence_category_checks_total": 66,
+        "evidence_category_verification_rate": 0.0,
+        "experiment_completed": False,
+        "fixture_preparation_succeeded": False,
+        "individual_comparisons_passed": 0,
+        "individual_comparisons_total": 18,
+        "output_reference_exact_match_rate": 0.0,
+        "preflight_succeeded": False,
+        "primary_runs_attempted": 0,
+        "successful_primary_run_rate": 0.0,
+        "successful_primary_runs": 0,
+    })
+    (ROOT / "experiment_error.log").write_text(traceback.format_exc(), encoding="utf-8", newline="\n")
+    print(f"Ran Docker preflight; classification=BROKEN; error={message}")
+
+
+def main() -> int:
+    (ROOT / "figures").mkdir(exist_ok=True)
+    try:
+        report = preflight()
+        prepare_fixture(report["image_id"])
+        run_stage("capture.py")
+        run_stage("verify.py")
+        removed, failures = remove_containers()
+        results = json.loads((ROOT / "results.json").read_text(encoding="utf-8"))
+        results["retained_containers_removed"] = removed
+        results["container_cleanup_succeeded"] = not failures and removed == 6
+        if failures:
+            results["container_cleanup_error"] = " | ".join(failures)
+        write_json(ROOT / "results.json", results)
+        print(
+            "Ran six fresh network-disabled `make reproduce` containers; "
+            f"categories={results['evidence_category_checks_passed']}/66, "
+            f"comparisons={results['individual_comparisons_passed']}/18, "
+            f"successful_runs={results['successful_primary_runs']}/6, "
+            f"classification={results['classification']}"
+        )
+        return 0 if results["classification"] == "SUPPORTED" else 2
+    except BaseException as error:
+        broken_results(error)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
