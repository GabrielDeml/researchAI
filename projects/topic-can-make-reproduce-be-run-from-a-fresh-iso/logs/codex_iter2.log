+def regular_inventory(root: Path) -> tuple[list[str], dict[str, str]]:
+    paths: list[str] = []
+    hashes: dict[str, str] = {}
+    if not root.is_dir() or root.is_symlink():
+        return paths, hashes
+    for parent, directories, files in os.walk(root, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        directories[:] = sorted(name for name in directories if not (parent_path / name).is_symlink())
+        for name in sorted(files):
+            candidate = parent_path / name
+            if stat.S_ISREG(candidate.lstat().st_mode):
+                relative = candidate.relative_to(root).as_posix()
+                paths.append(relative)
+                hashes[relative] = digest(candidate.read_bytes())
+    paths.sort()
+    return paths, {name: hashes[name] for name in paths}
+
+
+def released_hashes(bare: Path, revision: str) -> dict[str, str]:
+    hashes: dict[str, str] = {}
+    for name in EXPECTED:
+        blob = checked(["git", f"--git-dir={bare}", "show", f"{revision}:reference/{name}"])
+        hashes[name] = digest(blob)
+    return hashes
+
