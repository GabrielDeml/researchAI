# Fresh isolated `make reproduce` experiment

This workspace creates a deterministic synthetic Git release, captures six
primary reproductions and six descriptive baseline runs in fresh
network-disabled containers, independently reruns and verifies every primary
record, and generates a 1600-by-900 evidence figure.

Prerequisites are Git, a Docker-compatible `docker` CLI, and the official
`python:3.12.8-bookworm` image already present locally. The experiment never
pulls an image. Run it with:

```sh
python3 -m venv .venv
.venv/bin/pip install matplotlib==3.9.2
.venv/bin/python run_experiment.py
```

The immutable image ID is resolved before release creation and written to
`study_config.json`. Final scalar metrics are in `results.json`; full checks and
mismatches are in `verification_results.json`.
#!/usr/bin/env python3
"""Run the complete fresh-checkout reproduction experiment."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import traceback


ROOT = Path(__file__).resolve().parent


def run(script: str) -> None:
    result = subprocess.run(
        [sys.executable, str(ROOT / script)],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no subprocess diagnostics"
        raise RuntimeError(f"{script} exited {result.returncode}: {detail}")
    if result.stdout:
        print(result.stdout, end="")


def write_failure(error: BaseException) -> None:
    message = f"{type(error).__name__}: {error}"
    results = {
        "error": message,
        "experiment_completed": False,
        "hypothesis_decision": "REFUTED",
        "hypothesis_supported": False,
    }
    (ROOT / "results.json").write_text(
        json.dumps(results, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    (ROOT / "experiment_error.log").write_text(traceback.format_exc(), encoding="utf-8", newline="\n")
    print(
        "Experiment could not execute the required container protocol; "
        f"decision=REFUTED, error={message}"
    )


def main() -> int:
    (ROOT / "figures").mkdir(exist_ok=True)
    try:
        run("prepare_release.py")
        run("capture.py")
        run("verify.py")
    except BaseException as error:
        write_failure(error)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Create the deterministic synthetic release and its committed references."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess


IMAGE_TAG = "python:3.12.8-bookworm"
IMAGE_RE = re.compile(r"sha256:[0-9a-f]{64}\Z")
LITERAL_COMMAND = "make reproduce"
SEED = 20250308
SAMPLE_COUNT = 4096
OUTPUT_PATHS = ["frequencies.csv", "samples.csv", "summary.json"]

GENERATOR = r'''#!/usr/bin/env python3
"""Generate the deterministic synthetic release outputs."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

SEED = 20250308
COUNT = 4096
MODULUS = 2**32


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    args.output.mkdir(parents=True, exist_ok=True)

    state = SEED
    values = []
    for _ in range(COUNT):
        state = (1664525 * state + 1013904223) % MODULUS
        values.append(state)

    counts = [0] * 256
    for value in values:
        counts[value % 256] += 1

    frequencies = ["bucket,count"]
    frequencies.extend(f"{bucket},{count}" for bucket, count in enumerate(counts))
    (args.output / "frequencies.csv").write_bytes(
        ("\n".join(frequencies) + "\n").encode("utf-8")
    )

    samples = ["index,value,bucket"]
    samples.extend(
        f"{index},{value},{value % 256}" for index, value in enumerate(values)
    )
    (args.output / "samples.csv").write_bytes(
        ("\n".join(samples) + "\n").encode("utf-8")
    )

    digest = hashlib.sha256()
    xor_value = 0
    for value in values:
        digest.update(value.to_bytes(4, "big"))
        xor_value ^= value
    summary = {
        "maximum": max(values),
        "minimum": min(values),
        "n": COUNT,
        "seed": SEED,
        "sha256": digest.hexdigest(),
        "sum": sum(values),
        "xor": xor_value,
    }
    (args.output / "summary.json").write_bytes(
        (json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    )


if __name__ == "__main__":
    main()
'''

MAKEFILE = """.PHONY: clean reproduce

clean:
	rm -rf generated

reproduce: clean
	python3 src/generate.py --output generated
"""


def checked(command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(command, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        raise RuntimeError(
            f"command failed ({result.returncode}): {command!r}\n"
            f"stdout:\n{result.stdout.decode('utf-8', 'replace')}\n"
            f"stderr:\n{result.stderr.decode('utf-8', 'replace')}"
        )
    return result


def resolve_image_id(docker: str) -> str:
    result = checked([docker, "image", "inspect", IMAGE_TAG, "--format", "{{.Id}}"])
    image_id = result.stdout.decode("ascii").strip()
    if not IMAGE_RE.fullmatch(image_id):
        raise RuntimeError(f"image ID is not immutable SHA-256: {image_id!r}")
    return image_id


def preflight(docker: str, image_id: str) -> None:
    checked(
        [
            docker,
            "run",
            "--rm",
            "--pull",
            "never",
            "--network",
            "none",
            image_id,
            "sh",
            "-lc",
            "command -v sh >/dev/null && command -v make >/dev/null && command -v python3 >/dev/null",
        ]
    )


def container_command(docker: str, image_id: str, repo: Path) -> list[str]:
    return [
        docker,
        "run",
        "--rm",
        "--pull",
        "never",
        "--network",
        "none",
        "--mount",
        f"type=bind,src={repo},dst=/work",
        "--workdir",
        "/work",
        image_id,
        "make",
        "reproduce",
    ]


def create_release(root: Path, docker: str, image_id: str) -> str:
    repo = root / "release_repo"
    if repo.exists():
        shutil.rmtree(repo)
    (repo / "src").mkdir(parents=True)
    (repo / "src" / "generate.py").write_text(GENERATOR, encoding="utf-8", newline="\n")
    (repo / "Makefile").write_text(MAKEFILE, encoding="utf-8", newline="\n")

    checked(["git", "init", "-q", str(repo)])
    checked(container_command(docker, image_id, repo))
    generated = repo / "generated"
    actual = sorted(path.name for path in generated.iterdir())
    if actual != OUTPUT_PATHS or any(not path.is_file() or path.is_symlink() for path in generated.iterdir()):
        raise RuntimeError(f"unexpected reference-generation outputs: {actual!r}")
    reference = repo / "reference"
    reference.mkdir()
    for name in OUTPUT_PATHS:
        shutil.copyfile(generated / name, reference / name)
    shutil.rmtree(generated)

    checked(["git", "add", "Makefile", "src/generate.py", "reference"], cwd=repo)
    fixed_env = os.environ.copy()
    fixed_env.update(
        {
            "GIT_AUTHOR_NAME": "Reproduction Test",
            "GIT_AUTHOR_EMAIL": "test@example.invalid",
            "GIT_AUTHOR_DATE": "2025-01-01T00:00:00Z",
            "GIT_COMMITTER_NAME": "Reproduction Test",
            "GIT_COMMITTER_EMAIL": "test@example.invalid",
            "GIT_COMMITTER_DATE": "2025-01-01T00:00:00Z",
        }
    )
    checked(["git", "commit", "-q", "-m", "Deterministic synthetic release"], cwd=repo, env=fixed_env)
    revision = checked(["git", "rev-parse", "HEAD"], cwd=repo).stdout.decode("ascii").strip()
    return revision


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--docker", default="docker")
    args = parser.parse_args()
    root = args.root.resolve()
    image_id = resolve_image_id(args.docker)
    preflight(args.docker, image_id)
    revision = create_release(root, args.docker, image_id)
    config = {
        "docker_cli": args.docker,
        "expected_output_paths": OUTPUT_PATHS,
        "generator_seed": SEED,
        "image_id": image_id,
        "image_tag": IMAGE_TAG,
        "literal_command": LITERAL_COMMAND,
        "release_revision": revision,
        "sample_count": SAMPLE_COUNT,
    }
    (root / "study_config.json").write_text(
        json.dumps(config, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
        newline="\n",
    )
    print(f"Prepared release {revision} with {image_id}")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Capture six primary reproductions in isolated fresh checkouts and containers."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess


ROOT = Path(__file__).resolve().parent
CONFIG = json.loads((ROOT / "study_config.json").read_text(encoding="utf-8"))
RUNS = 6
LITERAL_COMMAND = "make reproduce"
CONTAINER_SCRIPT = 'python3 -c "import os,sys; print(os.path.realpath(sys.executable))" > /evidence/interpreter.txt && exec make reproduce'


def run_checked(command: list[str], *, cwd: Path | None = None) -> bytes:
    result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        raise RuntimeError(
            f"command failed ({result.returncode}): {command!r}\n"
            f"stdout={result.stdout!r}\nstderr={result.stderr!r}"
        )
    return result.stdout


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def inventory(directory: Path) -> list[dict[str, object]]:
    if not directory.is_dir() or directory.is_symlink():
        raise RuntimeError(f"inventory root is missing, symlinked, or not a directory: {directory}")
    entries: list[dict[str, object]] = []
    for current, dirnames, filenames in os.walk(directory, followlinks=False):
        current_path = Path(current)
        for dirname in dirnames:
            candidate = current_path / dirname
            if candidate.is_symlink():
                raise RuntimeError(f"symlinked directory in inventory: {candidate}")
        for filename in filenames:
            path = current_path / filename
            mode = path.lstat().st_mode
            if not stat.S_ISREG(mode):
                raise RuntimeError(f"non-regular file in inventory: {path}")
            data = path.read_bytes()
            entries.append(
                {
                    "path": path.relative_to(directory).as_posix(),
                    "sha256": sha256(data),
                    "size": len(data),
                }
            )
    return sorted(entries, key=lambda entry: str(entry["path"]))


def isolated_command(checkout: Path, evidence: Path) -> list[str]:
    return [
        CONFIG["docker_cli"],
        "run",
        "--rm",
        "--pull",
        "never",
        "--network",
        "none",
        "--read-only",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--tmpfs",
        "/tmp:rw,nosuid,size=64m",
        "--mount",
        f"type=bind,src={checkout},dst=/work",
        "--mount",
        f"type=bind,src={evidence},dst=/evidence",
        "--workdir",
        "/work",
        CONFIG["image_id"],
        "sh",
        "-lc",
        CONTAINER_SCRIPT,
    ]


def final_newline_only(data: bytes) -> str:
    if data.endswith(b"\n"):
        data = data[:-1]
    return data.decode("utf-8")


def main() -> None:
    if CONFIG["literal_command"] != LITERAL_COMMAND:
        raise RuntimeError("configured literal command differs from independently expected command")
    runs_root = ROOT / "runs"
    if runs_root.exists():
        shutil.rmtree(runs_root)
    runs_root.mkdir()
    expected = sorted(CONFIG["expected_output_paths"])
    release_repo = ROOT / "release_repo"

    for run_index in range(1, RUNS + 1):
        run_dir = runs_root / f"run_{run_index:02d}"
        checkout = run_dir / "checkout"
        evidence = run_dir / "evidence"
        evidence.mkdir(parents=True)
        run_checked(["git", "clone", "-q", "--no-local", str(release_repo), str(checkout)])
        run_checked(["git", "checkout", "-q", "--detach", CONFIG["release_revision"]], cwd=checkout)
        status = run_checked(["git", "status", "--porcelain"], cwd=checkout)
        if status != b"":
            raise RuntimeError(f"run {run_index}: checkout dirty before execution: {status!r}")

        process = subprocess.run(isolated_command(checkout, evidence), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stdout_path = run_dir / "stdout.log"
        stderr_path = run_dir / "stderr.log"
        stdout_path.write_bytes(process.stdout)
        stderr_path.write_bytes(process.stderr)
        interpreter_file = evidence / "interpreter.txt"
        if not interpreter_file.is_file() or interpreter_file.is_symlink():
            raise RuntimeError(f"run {run_index}: interpreter evidence is absent or invalid")

        generated_inventory = inventory(checkout / "generated")
        reference_inventory = inventory(checkout / "reference")
        generated_names = [str(entry["path"]) for entry in generated_inventory]
        reference_names = [str(entry["path"]) for entry in reference_inventory]
        if generated_names != expected or reference_names != expected:
            raise RuntimeError(
                f"run {run_index}: missing or extra paths; generated={generated_names!r}, reference={reference_names!r}"
            )
        generated_by_path = {str(entry["path"]): entry for entry in generated_inventory}
        reference_by_path = {str(entry["path"]): entry for entry in reference_inventory}
        comparisons = []
        for path in expected:
            generated_data = (checkout / "generated" / path).read_bytes()
            reference_data = (checkout / "reference" / path).read_bytes()
            comparisons.append(
                {
                    "byte_equal": generated_data == reference_data,
                    "generated_sha256": generated_by_path[path]["sha256"],
                    "generated_size": generated_by_path[path]["size"],
                    "path": path,
                    "reference_sha256": reference_by_path[path]["sha256"],
                    "reference_size": reference_by_path[path]["size"],
                }
            )
        revision = run_checked(["git", "rev-parse", "HEAD"], cwd=checkout).decode("ascii").strip()
        record = {
            "checkout_revision": revision,
            "comparisons": comparisons,
            "exit_status": int(process.returncode),
            "generated_inventory": generated_inventory,
            "image_id": CONFIG["image_id"],
            "interpreter_path": final_newline_only(interpreter_file.read_bytes()),
            "literal_command": LITERAL_COMMAND,
            "reference_inventory": reference_inventory,
            "run_index": run_index,
            "schema_version": 1,
            "stderr": {"byte_count": len(process.stderr), "path": "stderr.log", "sha256": sha256(process.stderr)},
            "stdout": {"byte_count": len(process.stdout), "path": "stdout.log", "sha256": sha256(process.stdout)},
        }
        (run_dir / "record.json").write_text(
            json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="utf-8",
            newline="\n",
        )
        print(f"Captured run {run_index}/6: exit={process.returncode}")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Independently verify primary records, rerun them, capture a baseline, and score results.

This module intentionally does not import capture.py and has its own container,
hashing, inventory, and byte-comparison implementations.
"""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import struct
import subprocess
from typing import Any


ROOT = Path(__file__).resolve().parent
RUN_COUNT = 6
EXPECTED_COMMAND = "make reproduce"
CATEGORIES = [
    "checkout revision",
    "immutable image ID",
    "resolved interpreter path",
    "literal command",
    "integer exit status",
    "stdout hash",
    "stderr hash",
    "generated-file inventory",
    "generated hashes",
    "reference hashes",
    "per-output comparisons",
]
TOP_KEYS = {
    "schema_version",
    "run_index",
    "checkout_revision",
    "image_id",
    "interpreter_path",
    "literal_command",
    "exit_status",
    "stdout",
    "stderr",
    "generated_inventory",
    "reference_inventory",
    "comparisons",
}
LOG_KEYS = {"path", "byte_count", "sha256"}
INVENTORY_KEYS = {"path", "size", "sha256"}
COMPARISON_KEYS = {
    "path",
    "generated_sha256",
    "reference_sha256",
    "generated_size",
    "reference_size",
    "byte_equal",
}
IMAGE_PATTERN = re.compile(r"sha256:[0-9a-f]{64}\Z")
RERUN_SCRIPT = 'python3 -c "import os,sys; print(os.path.realpath(sys.executable))" > /evidence/interpreter.txt && exec make reproduce'


def digest_bytes(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def independent_inventory(directory: Path) -> list[dict[str, Any]]:
    if not directory.exists() or directory.is_symlink() or not directory.is_dir():
        raise RuntimeError(f"invalid inventory root: {directory}")
    found: list[dict[str, Any]] = []
    for parent, directories, files in os.walk(directory, topdown=True, followlinks=False):
        parent_path = Path(parent)
        directories.sort()
        files.sort()
        for directory_name in directories:
            child = parent_path / directory_name
            if child.is_symlink():
                raise RuntimeError(f"inventory contains symlinked directory: {child}")
        for file_name in files:
            child = parent_path / file_name
            metadata = child.lstat()
            if not stat.S_ISREG(metadata.st_mode):
                raise RuntimeError(f"inventory contains non-regular path: {child}")
            raw = child.read_bytes()
            found.append(
                {
                    "path": child.relative_to(directory).as_posix(),
                    "sha256": hashlib.sha256(raw).hexdigest(),
                    "size": len(raw),
                }
            )
    found.sort(key=lambda item: item["path"])
    return found


def independent_comparisons(checkout: Path, expected_paths: list[str]) -> list[dict[str, Any]]:
    generated_inventory = {item["path"]: item for item in independent_inventory(checkout / "generated")}
    reference_inventory = {item["path"]: item for item in independent_inventory(checkout / "reference")}
    results: list[dict[str, Any]] = []
    for relative in sorted(expected_paths):
        generated = (checkout / "generated" / relative).read_bytes()
        reference = (checkout / "reference" / relative).read_bytes()
        results.append(
            {
                "byte_equal": generated == reference,
                "generated_sha256": generated_inventory[relative]["sha256"],
                "generated_size": generated_inventory[relative]["size"],
                "path": relative,
                "reference_sha256": reference_inventory[relative]["sha256"],
                "reference_size": reference_inventory[relative]["size"],
            }
        )
    return results


def execute(command: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def require_success(command: list[str], *, cwd: Path | None = None) -> bytes:
    result = execute(command, cwd=cwd)
    if result.returncode != 0:
        raise RuntimeError(f"command failed ({result.returncode}): {command!r}; stdout={result.stdout!r}; stderr={result.stderr!r}")
    return result.stdout


def isolated_invocation(docker: str, image: str, checkout: Path, evidence: Path, script: str) -> list[str]:
    return [
        docker,
        "run",
        "--rm",
        "--pull",
        "never",
        "--network",
        "none",
        "--read-only",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--tmpfs",
        "/tmp:rw,nosuid,size=64m",
        "--mount",
        f"type=bind,src={checkout},dst=/work",
        "--mount",
        f"type=bind,src={evidence},dst=/evidence",
        "--workdir",
        "/work",
        image,
        "sh",
        "-lc",
        script,
    ]


def strip_one_final_newline(payload: bytes) -> str:
    if payload.endswith(b"\n"):
        payload = payload[:-1]
    return payload.decode("utf-8")


def git_revision(checkout: Path) -> str:
    return require_success(["git", "rev-parse", "HEAD"], cwd=checkout).decode("ascii").strip()


class Checks:
    def __init__(self) -> None:
        self.direct: dict[str, bool] = {}
        self.rerun: dict[str, bool] = {}
        self.mismatches: list[dict[str, Any]] = []
        self.category_inputs: dict[str, list[bool]] = {name: [] for name in CATEGORIES}

    def add(self, phase: str, name: str, actual: Any, expected: Any, category: str | None = None) -> bool:
        passed = type(actual) is type(expected) and actual == expected
        target = self.direct if phase == "direct" else self.rerun
        target[name] = passed
        if category is not None:
            self.category_inputs[category].append(passed)
        if not passed:
            def json_safe(value: Any) -> Any:
                if isinstance(value, bytes):
                    return {"byte_count": len(value), "sha256": hashlib.sha256(value).hexdigest()}
                return value

            self.mismatches.append(
                {"actual": json_safe(actual), "check": name, "expected": json_safe(expected), "phase": phase}
            )
        return passed

    def truth(self, phase: str, name: str, passed: bool, detail: str, category: str | None = None) -> bool:
        target = self.direct if phase == "direct" else self.rerun
        target[name] = bool(passed)
        if category is not None:
            self.category_inputs[category].append(bool(passed))
        if not passed:
            self.mismatches.append({"check": name, "detail": detail, "phase": phase})
        return passed

    def category_results(self) -> dict[str, bool]:
        return {name: bool(values) and all(values) for name, values in self.category_inputs.items()}


def compare_inventory_fields(
    checks: Checks,
    phase: str,
    prefix: str,
    actual: Any,
    expected: list[dict[str, Any]],
    inventory_category: str,
    hash_category: str,
) -> None:
    checks.truth(phase, f"{prefix}.is_list", isinstance(actual, list), f"expected list, got {type(actual).__name__}", inventory_category)
    if not isinstance(actual, list):
        return
    checks.add(phase, f"{prefix}.length", len(actual), len(expected), inventory_category)
    for index in range(max(len(actual), len(expected))):
        if index >= len(actual) or index >= len(expected):
            checks.truth(phase, f"{prefix}[{index}].present", False, "missing or extra inventory entry", inventory_category)
            continue
        observed = actual[index]
        wanted = expected[index]
        checks.truth(
            phase,
            f"{prefix}[{index}].keys",
            isinstance(observed, dict) and set(observed) == INVENTORY_KEYS,
            f"inventory keys differ: {observed!r}",
            inventory_category,
        )
        if not isinstance(observed, dict):
            continue
        checks.add(phase, f"{prefix}[{index}].path", observed.get("path"), wanted["path"], inventory_category)
        checks.add(phase, f"{prefix}[{index}].size", observed.get("size"), wanted["size"], inventory_category)
        checks.add(phase, f"{prefix}[{index}].sha256", observed.get("sha256"), wanted["sha256"], hash_category)


def compare_comparison_fields(checks: Checks, phase: str, actual: Any, expected: list[dict[str, Any]]) -> None:
    category = "per-output comparisons"
    checks.truth(phase, "comparisons.is_list", isinstance(actual, list), "comparisons is not a list", category)
    if not isinstance(actual, list):
        return
    checks.add(phase, "comparisons.length", len(actual), len(expected), category)
    for index in range(max(len(actual), len(expected))):
        if index >= len(actual) or index >= len(expected):
            checks.truth(phase, f"comparisons[{index}].present", False, "missing or extra comparison", category)
            continue
        observed, wanted = actual[index], expected[index]
        checks.truth(
            phase,
            f"comparisons[{index}].keys",
            isinstance(observed, dict) and set(observed) == COMPARISON_KEYS,
            f"comparison keys differ: {observed!r}",
            category,
        )
        if not isinstance(observed, dict):
            continue
        for field in sorted(COMPARISON_KEYS):
            checks.add(phase, f"comparisons[{index}].{field}", observed.get(field), wanted[field], category)


def new_checkout(destination: Path, release_repo: Path, revision: str) -> None:
    require_success(["git", "clone", "-q", "--no-local", str(release_repo), str(destination)])
    require_success(["git", "checkout", "-q", "--detach", revision], cwd=destination)
    dirty = require_success(["git", "status", "--porcelain"], cwd=destination)
    if dirty:
        raise RuntimeError(f"new checkout is dirty: {dirty!r}")


def capture_baseline(config: dict[str, Any], expected_paths: list[str]) -> tuple[list[dict[str, bool]], list[dict[str, Any]]]:
    baseline_root = ROOT / "baseline_runs"
    if baseline_root.exists():
        shutil.rmtree(baseline_root)
    baseline_root.mkdir()
    category_rows: list[dict[str, bool]] = []
    records: list[dict[str, Any]] = []
    for index in range(1, RUN_COUNT + 1):
        run_dir = baseline_root / f"run_{index:02d}"
        checkout = run_dir / "checkout"
        evidence = run_dir / "evidence"
        evidence.mkdir(parents=True)
        new_checkout(checkout, ROOT / "release_repo", config["release_revision"])
        command = isolated_invocation(
            config["docker_cli"],
            config["image_id"],
            checkout,
            evidence,
            "exec make reproduce",
        )
        process = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        merged = process.stdout
        (run_dir / "merged.log").write_bytes(merged)
        generated = independent_inventory(checkout / "generated")
        paths_ok = [item["path"] for item in generated] == expected_paths
        record = {
            "exit_status": int(process.returncode),
            "generated_inventory": [item["path"] for item in generated],
            "generated_sha256": {item["path"]: item["sha256"] for item in generated},
            "literal_command": EXPECTED_COMMAND,
            "merged_log": {"byte_count": len(merged), "path": "merged.log", "sha256": digest_bytes(merged)},
            "run_index": index,
        }
        (run_dir / "baseline_record.json").write_text(
            json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n"
        )
        categories = {name: False for name in CATEGORIES}
        categories["literal command"] = record["literal_command"] == EXPECTED_COMMAND
        categories["integer exit status"] = type(record["exit_status"]) is int
        categories["generated-file inventory"] = paths_ok
        categories["generated hashes"] = paths_ok and all(IMAGE_PATTERN.fullmatch("sha256:" + value) for value in record["generated_sha256"].values())
        category_rows.append(categories)
        records.append(record)
    return category_rows, records


def png_dimensions(path: Path) -> tuple[int, int]:
    payload = path.read_bytes()
    if len(payload) < 24 or payload[:8] != b"\x89PNG\r\n\x1a\n" or payload[12:16] != b"IHDR":
        raise ValueError("not a valid PNG header")
    return struct.unpack(">II", payload[16:24])


def make_figure(primary_rows: list[dict[str, bool]], baseline_rows: list[dict[str, bool]]) -> None:
    matplotlib_cache = ROOT / ".matplotlib-cache"
    matplotlib_cache.mkdir(exist_ok=True)
    os.environ.setdefault("MPLCONFIGDIR", str(matplotlib_cache))
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.colors import ListedColormap

    matplotlib.rcParams.update(
        {
            "font.family": "DejaVu Sans",
            "font.size": 8,
            "axes.titlesize": 11,
            "axes.labelsize": 9,
            "savefig.dpi": 150,
        }
    )
    matrix = [[int(row[name]) for name in CATEGORIES] for row in primary_rows]
    primary_percent = [sum(row) / len(CATEGORIES) * 100.0 for row in matrix]
    baseline_percent = [
        sum(int(row[name]) for name in CATEGORIES) / len(CATEGORIES) * 100.0 for row in baseline_rows
    ]
    figure, (left, right) = plt.subplots(1, 2, figsize=(1600 / 150, 900 / 150), dpi=150, gridspec_kw={"width_ratios": [1.55, 1]})
    left.imshow(matrix, cmap=ListedColormap(["#d73027", "#1a9850"]), vmin=0, vmax=1, aspect="auto", interpolation="nearest")
    left.set_title("Independent verification of primary evidence")
    left.set_yticks(range(RUN_COUNT), [f"Run {index}" for index in range(1, RUN_COUNT + 1)])
    left.set_xticks(range(len(CATEGORIES)), CATEGORIES, rotation=48, ha="right", rotation_mode="anchor")
    for y in range(RUN_COUNT):
        for x in range(len(CATEGORIES)):
            left.text(x, y, str(matrix[y, x]), ha="center", va="center", color="white", fontweight="bold")
    left.set_xticks([index - 0.5 for index in range(len(CATEGORIES) + 1)], minor=True)
    left.set_yticks([index - 0.5 for index in range(RUN_COUNT + 1)], minor=True)
    left.grid(which="minor", color="white", linewidth=0.7)
    left.tick_params(which="minor", bottom=False, left=False)

#!/usr/bin/env python3
"""Host-only structural tests; these do not substitute for container execution."""

from __future__ import annotations

import csv
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

import prepare_release


ROOT = Path(__file__).resolve().parent


def main() -> None:
    with tempfile.TemporaryDirectory(prefix="reproduce-self-test-") as temporary:
        temp = Path(temporary)
        generator = temp / "generate.py"
        output_a = temp / "a"
        output_b = temp / "b"
        generator.write_text(prepare_release.GENERATOR, encoding="utf-8", newline="\n")
        for output in (output_a, output_b):
            subprocess.run([sys.executable, str(generator), "--output", str(output)], check=True)
        names = sorted(path.name for path in output_a.iterdir())
        assert names == prepare_release.OUTPUT_PATHS
        for name in names:
            first = (output_a / name).read_bytes()
            second = (output_b / name).read_bytes()
            assert first == second
            assert first.endswith(b"\n")
            assert b"\r" not in first

        with (output_a / "samples.csv").open(encoding="utf-8", newline="") as handle:
            sample_rows = list(csv.reader(handle))
        assert sample_rows[0] == ["index", "value", "bucket"]
        assert len(sample_rows) == 4097
        assert [int(row[0]) for row in sample_rows[1:]] == list(range(4096))

        with (output_a / "frequencies.csv").open(encoding="utf-8", newline="") as handle:
            frequency_rows = list(csv.reader(handle))
        assert frequency_rows[0] == ["bucket", "count"]
        assert len(frequency_rows) == 257
        assert sum(int(row[1]) for row in frequency_rows[1:]) == 4096

        values = [int(row[1]) for row in sample_rows[1:]]
        summary = json.loads((output_a / "summary.json").read_text(encoding="utf-8"))
        digest = hashlib.sha256(b"".join(value.to_bytes(4, "big") for value in values)).hexdigest()
        xor_value = 0
        for value in values:
            xor_value ^= value
        assert summary == {
            "maximum": max(values),
            "minimum": min(values),
            "n": 4096,
            "seed": 20250308,
            "sha256": digest,
            "sum": sum(values),
            "xor": xor_value,
        }
        canonical = json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n"
        assert (output_a / "summary.json").read_text(encoding="utf-8") == canonical

    for source in ("prepare_release.py", "capture.py", "verify.py", "run_experiment.py", "self_test.py"):
        subprocess.run([sys.executable, "-m", "py_compile", str(ROOT / source)], check=True)
    assert importlib.util.find_spec("matplotlib") is not None
    matplotlib_cache = ROOT / ".matplotlib-cache"
    matplotlib_cache.mkdir(exist_ok=True)
    os.environ.setdefault("MPLCONFIGDIR", str(matplotlib_cache))
    import matplotlib

    assert matplotlib.__version__ == "3.9.2"
    print("Host-only self-test passed: generator bytes, recurrence summary, CSV shapes, syntax, and matplotlib pin")


if __name__ == "__main__":
    main()
