+#!/usr/bin/env python3
+"""Orchestrate the fresh-checkout ``make reproduce`` experiment."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import traceback
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+IMAGE_TAG = "python:3.12.8-bookworm"
+IMAGE_PATTERN = re.compile(r"sha256:[0-9a-f]{64}\Z")
+OUTPUTS = ["data.csv", "summary.json", "histogram.png"]
+CONTAINERS = [f"reproduce-{index:02d}" for index in range(1, 7)]
+
+ARTIFACT = r'''#!/usr/bin/env python3
+"""Generate the three deterministic release artifacts using only stdlib."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import struct
+import zlib
+
+SEED = 20250308
+N = 4096
+WIDTH = 800
+HEIGHT = 480
+
+
+def png_chunk(kind: bytes, payload: bytes) -> bytes:
+    body = kind + payload
+    return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body) & 0xffffffff)
+
+
+def make_histogram(counts: list[int]) -> bytes:
+    pixels = bytearray(b"\xff\xff\xff" * WIDTH * HEIGHT)
+
+    def pixel(x: int, y: int, color: tuple[int, int, int]) -> None:
+        offset = (y * WIDTH + x) * 3
+        pixels[offset:offset + 3] = bytes(color)
+
+    black = (0, 0, 0)
+    blue = (31, 119, 180)
+    left, right, top, bottom = 60, 760, 30, 420
+    for x in range(left, right + 1):
+        pixel(x, bottom, black)
+    for y in range(top, bottom + 1):
+        pixel(left, y, black)
+    maximum = max(counts)
+    slot = (right - left - 10) // 20
+    for index, count in enumerate(counts):
+        x0 = left + 6 + index * slot
+        x1 = x0 + slot - 7
+        height = count * (bottom - top - 10) // maximum
+        y0 = bottom - height
+        for y in range(y0, bottom):
+            for x in range(x0, x1 + 1):
+                pixel(x, y, blue)
+    scanlines = bytearray()
+    stride = WIDTH * 3
+    for y in range(HEIGHT):
+        scanlines.append(0)
+        scanlines.extend(pixels[y * stride:(y + 1) * stride])
+    signature = b"\x89PNG\r\n\x1a\n"
+    ihdr = struct.pack(">IIBBBBB", WIDTH, HEIGHT, 8, 2, 0, 0, 0)
+    return signature + png_chunk(b"IHDR", ihdr) + png_chunk(b"IDAT", zlib.compress(bytes(scanlines), 9)) + png_chunk(b"IEND", b"")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    args.out.mkdir(parents=True, exist_ok=True)
+
+    state = SEED
+    values: list[int] = []
+    counts = [0] * 20
+    for _ in range(N):
+        state = (1664525 * state + 1013904223) & 0xffffffff
+        value = ((state >> 8) % 2001) - 1000
+        values.append(value)
+        counts[(value + 1000) * 20 // 2001] += 1
+
+    csv_bytes = ("index,value\n" + "".join(f"{index},{value}\n" for index, value in enumerate(values))).encode("ascii")
+    (args.out / "data.csv").write_bytes(csv_bytes)
+    summary = {
+        "histogram_counts": counts,
+        "maximum": max(values),
+        "mean_denominator": N,
+        "mean_numerator": sum(values),
+        "minimum": min(values),
+        "n": N,
+        "seed": SEED,
+        "sum": sum(values),
+    }
+    (args.out / "summary.json").write_bytes((json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii"))
+    (args.out / "histogram.png").write_bytes(make_histogram(counts))
+    print(json.dumps({"outputs": ["data.csv", "summary.json", "histogram.png"]}, sort_keys=True, separators=(",", ":")))
+
+
+if __name__ == "__main__":
+    main()
+'''
+
+MAKEFILE = """reproduce:\n\t@rm -rf generated\n\t@mkdir -p generated\n\t@python artifact.py --out generated\n"""
+
+
+class Broken(RuntimeError):
+    """An infrastructure or fixture failure, which is never a refutation."""
+
+
+def command(argv: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[bytes]:
+    try:
+        return subprocess.run(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    except OSError as error:
+        raise Broken(f"could not execute {argv!r}: {error}") from error
+
+
+def require(result: subprocess.CompletedProcess[bytes], argv: list[str], stage: str) -> bytes:
+    if result.returncode != 0:
+        raise Broken(
+            f"{stage} failed with status {result.returncode}: {argv!r}; "
+            f"stdout={result.stdout.decode('utf-8', 'replace')!r}; stderr={result.stderr.decode('utf-8', 'replace')!r}"
+        )
+    return result.stdout
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")
+
+
+def preflight() -> dict[str, Any]:
+    report: dict[str, Any] = {"image_tag": IMAGE_TAG}
+    info_argv = ["docker", "info"]
+    info = command(info_argv)
+    report["docker_info"] = {"exit_status": info.returncode, "stdout": info.stdout.decode("utf-8", "replace"), "stderr": info.stderr.decode("utf-8", "replace")}
+    write_json(ROOT / "preflight.json", report)
+    require(info, info_argv, "docker info preflight")
+
+    inspect_argv = ["docker", "image", "inspect", IMAGE_TAG]
+    inspection = command(inspect_argv)
+    report["initial_image_inspect_status"] = inspection.returncode
+    if inspection.returncode != 0:
+        pull_argv = ["docker", "pull", IMAGE_TAG]
+        pulled = command(pull_argv)
+        report["pull"] = {"exit_status": pulled.returncode, "stdout": pulled.stdout.decode("utf-8", "replace"), "stderr": pulled.stderr.decode("utf-8", "replace")}
+        write_json(ROOT / "preflight.json", report)
+        require(pulled, pull_argv, "permitted preparatory image pull")
+        inspection = command(inspect_argv)
+    raw = require(inspection, inspect_argv, "image inspection")
+    try:
+        image_objects = json.loads(raw)
+        repo_digests = image_objects[0].get("RepoDigests") or []
+    except (ValueError, IndexError, TypeError) as error:
+        raise Broken(f"could not parse docker image inspection: {error}") from error
+    id_argv = ["docker", "image", "inspect", IMAGE_TAG, "--format", "{{.Id}}"]
+    image_id = require(command(id_argv), id_argv, "immutable image ID resolution").decode("ascii", "strict").strip()
+    if not IMAGE_PATTERN.fullmatch(image_id):
+        raise Broken(f"invalid immutable image ID: {image_id!r}")
+    probe_argv = ["docker", "run", "--rm", "--network", "none", "--pull", "never", image_id, "sh", "-c", "command -v make >/dev/null && command -v python >/dev/null"]
+    probe = command(probe_argv)
+    report.update({
+        "image_id": image_id,
+        "repo_digests": repo_digests,
+        "functional_probe": {"exit_status": probe.returncode, "stdout": probe.stdout.decode("utf-8", "replace"), "stderr": probe.stderr.decode("utf-8", "replace")},
+        "passed": probe.returncode == 0,
+    })
+    write_json(ROOT / "preflight.json", report)
+    require(probe, probe_argv, "network-disabled make/python functional probe")
+    return report
+
+
+def exact_regular_files(directory: Path) -> bool:
+    if not directory.is_dir() or directory.is_symlink():
+        return False
+    entries = list(directory.iterdir())
+    return sorted(path.name for path in entries) == sorted(OUTPUTS) and all(path.is_file() and not path.is_symlink() for path in entries)
+
+
+def prepare_fixture(image_id: str) -> str:
+    source = ROOT / "source"
+    bare = ROOT / "release.git"
+    for path in (source, bare):
+        if path.exists():
+            shutil.rmtree(path)
+    source.mkdir()
+    (source / "artifact.py").write_text(ARTIFACT, encoding="utf-8", newline="\n")
+    (source / "Makefile").write_text(MAKEFILE, encoding="utf-8", newline="\n")
+    (source / ".gitignore").write_text("generated/\n", encoding="utf-8", newline="\n")
+    init = ["git", "init", "-q", str(source)]
+    require(command(init), init, "source Git initialization")
+
+    ref_stdout = ROOT / "reference_generation.stdout.log"
+    ref_stderr = ROOT / "reference_generation.stderr.log"
+    run_argv = [
+        "docker", "run", "--rm", "--network", "none", "--pull", "never",
+        "-e", "PYTHONHASHSEED=0", "-e", "PYTHONDONTWRITEBYTECODE=1", "-e", "LC_ALL=C", "-e", "TZ=UTC",
+        "--mount", f"type=bind,src={source.resolve()},dst=/work", "-w", "/work", image_id,
+        "python", "artifact.py", "--out", "reference",
+    ]
+    generated = command(run_argv)
+    ref_stdout.write_bytes(generated.stdout)
+    ref_stderr.write_bytes(generated.stderr)
+    require(generated, run_argv, "released reference generation")
+    if not exact_regular_files(source / "reference"):
+        raise Broken("released reference directory does not contain exactly the three required regular files")
+
+    add = ["git", "add", ".gitignore", "Makefile", "artifact.py", "reference"]
+    require(command(add, cwd=source), add, "fixture Git add")
+    fixed = os.environ.copy()
+    fixed.update({
+        "GIT_AUTHOR_NAME": "Reproducibility Fixture",
+        "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
+        "GIT_AUTHOR_DATE": "2000-01-01T00:00:00Z",
+        "GIT_COMMITTER_NAME": "Reproducibility Fixture",
+        "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
+        "GIT_COMMITTER_DATE": "2000-01-01T00:00:00Z",
+    })
+    commit = ["git", "commit", "-q", "-m", "Release deterministic three-output fixture"]
+    require(command(commit, cwd=source, env=fixed), commit, "fixture Git commit")
+    clone = ["git", "clone", "-q", "--bare", "--no-local", str(source), str(bare)]
+    require(command(clone), clone, "local bare release clone")
+    rev_argv = ["git", f"--git-dir={bare}", "rev-parse", "HEAD"]
+    revision = require(command(rev_argv), rev_argv, "release revision resolution").decode("ascii").strip()
+    for name in OUTPUTS:
+        show = ["git", f"--git-dir={bare}", "show", f"{revision}:reference/{name}"]
+        require(command(show), show, f"released reference blob validation for {name}")
+    write_json(ROOT / "fixture.json", {"image_id": image_id, "output_paths": OUTPUTS, "release_revision": revision, "source_path": str(source.resolve())})
+    return revision
+
+
+def run_stage(script: str) -> None:
+    argv = [sys.executable, str(ROOT / script)]
+    result = command(argv, cwd=ROOT)
+    (ROOT / f"{Path(script).stem}.stdout.log").write_bytes(result.stdout)
+    (ROOT / f"{Path(script).stem}.stderr.log").write_bytes(result.stderr)
+    if result.stdout:
+        sys.stdout.buffer.write(result.stdout)
+        sys.stdout.flush()
+    require(result, argv, script)
+
+
+def remove_containers() -> tuple[int, list[str]]:
+    removed = 0
+    failures: list[str] = []
+    for name in CONTAINERS:
+        result = command(["docker", "rm", name])
+        if result.returncode == 0:
+            removed += 1
+        else:
+            failures.append(f"{name}: {result.stderr.decode('utf-8', 'replace').strip()}")
+    return removed, failures
+
+
+def broken_results(error: BaseException) -> None:
+    message = f"{type(error).__name__}: {error}"
+    write_json(ROOT / "results.json", {
+        "classification": "BROKEN",
+        "error": message,
+        "evidence_category_checks_passed": 0,
+        "evidence_category_checks_total": 66,
+        "evidence_category_verification_rate": 0.0,
+        "experiment_completed": False,
+        "fixture_preparation_succeeded": False,
+        "individual_comparisons_passed": 0,
+        "individual_comparisons_total": 18,
+        "output_reference_exact_match_rate": 0.0,
+        "preflight_succeeded": False,
+        "primary_runs_attempted": 0,
+        "successful_primary_run_rate": 0.0,
+        "successful_primary_runs": 0,
+    })
+    (ROOT / "experiment_error.log").write_text(traceback.format_exc(), encoding="utf-8", newline="\n")
+    print(f"Ran Docker preflight; classification=BROKEN; error={message}")
+
+
+def main() -> int:
+    (ROOT / "figures").mkdir(exist_ok=True)
+    try:
+        report = preflight()
+        prepare_fixture(report["image_id"])
+        run_stage("capture.py")
+        run_stage("verify.py")
+        removed, failures = remove_containers()
+        results = json.loads((ROOT / "results.json").read_text(encoding="utf-8"))
+        results["retained_containers_removed"] = removed
+        results["container_cleanup_succeeded"] = not failures and removed == 6
+        if failures:
+            results["container_cleanup_error"] = " | ".join(failures)
+        write_json(ROOT / "results.json", results)
+        print(
+            "Ran six fresh network-disabled `make reproduce` containers; "
+            f"categories={results['evidence_category_checks_passed']}/66, "
+            f"comparisons={results['individual_comparisons_passed']}/18, "
+            f"successful_runs={results['successful_primary_runs']}/6, "
+            f"classification={results['classification']}"
+        )
+        return 0 if results["classification"] == "SUPPORTED" else 2
+    except BaseException as error:
+        broken_results(error)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
