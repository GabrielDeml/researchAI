+def make_matrix(rows: list[list[bool]], destination: Path) -> dict[str, Any]:
+    width, height = 1060, 390
+    left, top, cell_w, cell_h = 130, 105, 64, 42
+    pixels = bytearray(bytes(WHITE) * width * height)
+    draw_text(pixels, width, 20, 18, "REPRODUCIBILITY MATRIX", 3)
+    labels = ["REV", "IMG", "PY", "CMD", "EXIT", "OUT", "ERR", "INV", "GH", "RH", "CMP", "DATA", "SUM", "PNG"]
+    for column, label in enumerate(labels):
+        draw_text(pixels, width, left + column * cell_w + 5, 76, label, 1)
+    for row_index, row in enumerate(rows):
+        draw_text(pixels, width, 22, top + row_index * cell_h + 14, f"RUN {row_index + 1:02d}", 2)
+        for column, passed in enumerate(row):
+            color = GREEN if passed else RED
+            x0 = left + column * cell_w
+            y0 = top + row_index * cell_h
+            for y in range(y0 + 1, y0 + cell_h - 1):
+                for x in range(x0 + 1, x0 + cell_w - 1):
+                    offset = (y * width + x) * 3
+                    pixels[offset:offset + 3] = bytes(color)
+    raw = bytearray()
+    stride = width * 3
+    for y in range(height):
+        raw.append(0)
+        raw.extend(pixels[y * stride:(y + 1) * stride])
+    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(bytes(raw), 9)) + chunk(b"IEND", b"")
+    destination.write_bytes(png)
+    return {"path": destination.relative_to(BASE).as_posix(), "sha256": hash_bytes(png), "width": width, "height": height, "rows": 6, "columns": 14}
 
 
