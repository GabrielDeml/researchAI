+def walk_regular(root: Path) -> tuple[list[str], dict[str, str], list[str]]:
+    inventory: list[str] = []
+    hashes: dict[str, str] = {}
+    invalid: list[str] = []
+    if root.is_symlink() or not root.is_dir():
+        return inventory, hashes, ["generated root missing, symlinked, or not a directory"]
+    for parent, directories, files in os.walk(root, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        kept: list[str] = []
+        for name in sorted(directories):
+            candidate = parent_path / name
+            relative = candidate.relative_to(root).as_posix()
+            if candidate.is_symlink():
+                invalid.append(f"symlinked directory: {relative}")
+            else:
+                kept.append(name)
+        directories[:] = kept
+        for name in sorted(files):
+            candidate = parent_path / name
+            relative = candidate.relative_to(root).as_posix()
+            mode = candidate.lstat().st_mode
+            if not stat.S_ISREG(mode):
+                invalid.append(f"nonregular path: {relative}")
+                continue
+            inventory.append(relative)
+            hashes[relative] = hash_bytes(candidate.read_bytes())
+    inventory.sort()
