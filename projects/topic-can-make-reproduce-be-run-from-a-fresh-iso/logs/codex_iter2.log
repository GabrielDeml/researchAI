     ]
+    result = invoke(argv)
+    if result.returncode != 0:
+        raise RuntimeError(f"interpreter probe failed: stdout={result.stdout!r}; stderr={result.stderr!r}")
+    if not result.stdout.endswith(b"\n") or len(result.stdout.splitlines()) != 1:
+        raise RuntimeError(f"interpreter probe did not emit exactly one line: {result.stdout!r}")
+    value = result.stdout[:-1].decode("utf-8")
+    if not value or not value.startswith("/"):
+        raise RuntimeError(f"interpreter path is not nonempty and absolute: {value!r}")
+    return value
 
 
