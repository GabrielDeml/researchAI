+def capture_logs(container_name: str) -> dict[str, Any]:
+    with tempfile.TemporaryDirectory(prefix="independent-docker-logs-", dir=BASE) as temporary:
+        stdout_path = Path(temporary) / "stdout.bin"
+        stderr_path = Path(temporary) / "stderr.bin"
+        with stdout_path.open("wb") as output, stderr_path.open("wb") as errors:
+            result = subprocess.run(["docker", "logs", container_name], stdout=output, stderr=errors)
