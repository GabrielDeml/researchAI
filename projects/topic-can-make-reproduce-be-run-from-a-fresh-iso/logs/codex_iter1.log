--- /dev/null
+++ b/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/prepare_release.py
@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""Create the deterministic synthetic release and its committed references."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+
+
+IMAGE_TAG = "python:3.12.8-bookworm"
+IMAGE_RE = re.compile(r"sha256:[0-9a-f]{64}\Z")
+LITERAL_COMMAND = "make reproduce"
+SEED = 20250308
+SAMPLE_COUNT = 4096
+OUTPUT_PATHS = ["frequencies.csv", "samples.csv", "summary.json"]
+
+GENERATOR = r'''#!/usr/bin/env python3
+"""Generate the deterministic synthetic release outputs."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+SEED = 20250308
+COUNT = 4096
+MODULUS = 2**32
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+
+    state = SEED
+    values = []
+    for _ in range(COUNT):
+        state = (1664525 * state + 1013904223) % MODULUS
+        values.append(state)
+
+    counts = [0] * 256
+    for value in values:
+        counts[value % 256] += 1
+
+    frequencies = ["bucket,count"]
+    frequencies.extend(f"{bucket},{count}" for bucket, count in enumerate(counts))
+    (args.output / "frequencies.csv").write_bytes(
+        ("\n".join(frequencies) + "\n").encode("utf-8")
+    )
+
+    samples = ["index,value,bucket"]
+    samples.extend(
+        f"{index},{value},{value % 256}" for index, value in enumerate(values)
+    )
+    (args.output / "samples.csv").write_bytes(
+        ("\n".join(samples) + "\n").encode("utf-8")
+    )
+
+    digest = hashlib.sha256()
+    xor_value = 0
+    for value in values:
+        digest.update(value.to_bytes(4, "big"))
+        xor_value ^= value
+    summary = {
+        "maximum": max(values),
+        "minimum": min(values),
+        "n": COUNT,
+        "seed": SEED,
+        "sha256": digest.hexdigest(),
+        "sum": sum(values),
+        "xor": xor_value,
+    }
+    (args.output / "summary.json").write_bytes(
+        (json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
+    )
+
+
+if __name__ == "__main__":
+    main()
+'''
+
+MAKEFILE = """.PHONY: clean reproduce
+
+clean:
+	rm -rf generated
+
+reproduce: clean
+	python3 src/generate.py --output generated
+"""
+
+
+def checked(command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[bytes]:
+    result = subprocess.run(command, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if result.returncode != 0:
+        raise RuntimeError(
+            f"command failed ({result.returncode}): {command!r}\n"
+            f"stdout:\n{result.stdout.decode('utf-8', 'replace')}\n"
+            f"stderr:\n{result.stderr.decode('utf-8', 'replace')}"
+        )
+    return result
+
+
+def resolve_image_id(docker: str) -> str:
+    result = checked([docker, "image", "inspect", IMAGE_TAG, "--format", "{{.Id}}"])
+    image_id = result.stdout.decode("ascii").strip()
+    if not IMAGE_RE.fullmatch(image_id):
+        raise RuntimeError(f"image ID is not immutable SHA-256: {image_id!r}")
+    return image_id
+
+
+def preflight(docker: str, image_id: str) -> None:
+    checked(
+        [
+            docker,
+            "run",
+            "--rm",
+            "--network",
+            "none",
+            image_id,
+            "sh",
+            "-lc",
+            "command -v sh >/dev/null && command -v make >/dev/null && command -v python3 >/dev/null",
+        ]
+    )
+
+
+def container_command(docker: str, image_id: str, repo: Path) -> list[str]:
+    return [
+        docker,
+        "run",
+        "--rm",
+        "--network",
+        "none",
+        "--mount",
+        f"type=bind,src={repo},dst=/work",
+        "--workdir",
+        "/work",
+        image_id,
+        "make",
+        "reproduce",
+    ]
+
+
+def create_release(root: Path, docker: str, image_id: str) -> str:
+    repo = root / "release_repo"
+    if repo.exists():
+        shutil.rmtree(repo)
+    (repo / "src").mkdir(parents=True)
+    (repo / "src" / "generate.py").write_text(GENERATOR, encoding="utf-8", newline="\n")
+    (repo / "Makefile").write_text(MAKEFILE, encoding="utf-8", newline="\n")
+
+    checked(["git", "init", "-q", str(repo)])
+    checked(container_command(docker, image_id, repo))
+    generated = repo / "generated"
+    actual = sorted(path.name for path in generated.iterdir())
+    if actual != OUTPUT_PATHS or any(not path.is_file() or path.is_symlink() for path in generated.iterdir()):
+        raise RuntimeError(f"unexpected reference-generation outputs: {actual!r}")
+    reference = repo / "reference"
+    reference.mkdir()
+    for name in OUTPUT_PATHS:
+        shutil.copyfile(generated / name, reference / name)
+    shutil.rmtree(generated)
+
+    checked(["git", "add", "Makefile", "src/generate.py", "reference"], cwd=repo)
+    fixed_env = os.environ.copy()
+    fixed_env.update(
+        {
+            "GIT_AUTHOR_NAME": "Reproduction Test",
+            "GIT_AUTHOR_EMAIL": "test@example.invalid",
+            "GIT_AUTHOR_DATE": "2025-01-01T00:00:00Z",
+            "GIT_COMMITTER_NAME": "Reproduction Test",
+            "GIT_COMMITTER_EMAIL": "test@example.invalid",
+            "GIT_COMMITTER_DATE": "2025-01-01T00:00:00Z",
+        }
+    )
+    checked(["git", "commit", "-q", "-m", "Deterministic synthetic release"], cwd=repo, env=fixed_env)
+    revision = checked(["git", "rev-parse", "HEAD"], cwd=repo).stdout.decode("ascii").strip()
+    return revision
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path.cwd())
+    parser.add_argument("--docker", default="docker")
+    args = parser.parse_args()
+    root = args.root.resolve()
+    image_id = resolve_image_id(args.docker)
+    preflight(args.docker, image_id)
+    revision = create_release(root, args.docker, image_id)
+    config = {
+        "docker_cli": args.docker,
+        "expected_output_paths": OUTPUT_PATHS,
+        "generator_seed": SEED,
+        "image_id": image_id,
+        "image_tag": IMAGE_TAG,
+        "literal_command": LITERAL_COMMAND,
+        "release_revision": revision,
+        "sample_count": SAMPLE_COUNT,
+    }
+    (root / "study_config.json").write_text(
+        json.dumps(config, sort_keys=True, separators=(",", ":")) + "\n",
+        encoding="utf-8",
+        newline="\n",
+    )
+    print(f"Prepared release {revision} with {image_id}")
+
+
+if __name__ == "__main__":
+    main()
