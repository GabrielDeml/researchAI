index 0000000000000000000000000000000000000000..cb19c88562954438a4b5979a6b5099befbc1d9a7
--- /dev/null
+++ b/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/verify.py
@@ -0,0 +1,643 @@
+#!/usr/bin/env python3
+"""Independently verify primary records, rerun them, capture a baseline, and score results.
+
+This module intentionally does not import capture.py and has its own container,
+hashing, inventory, and byte-comparison implementations.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import struct
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RUN_COUNT = 6
+EXPECTED_COMMAND = "make reproduce"
+CATEGORIES = [
+    "checkout revision",
+    "immutable image ID",
+    "resolved interpreter path",
+    "literal command",
+    "integer exit status",
+    "stdout hash",
+    "stderr hash",
+    "generated-file inventory",
+    "generated hashes",
+    "reference hashes",
+    "per-output comparisons",
+]
+TOP_KEYS = {
+    "schema_version",
+    "run_index",
+    "checkout_revision",
+    "image_id",
+    "interpreter_path",
+    "literal_command",
+    "exit_status",
+    "stdout",
+    "stderr",
+    "generated_inventory",
+    "reference_inventory",
+    "comparisons",
+}
+LOG_KEYS = {"path", "byte_count", "sha256"}
+INVENTORY_KEYS = {"path", "size", "sha256"}
+COMPARISON_KEYS = {
+    "path",
+    "generated_sha256",
+    "reference_sha256",
+    "generated_size",
+    "reference_size",
+    "byte_equal",
+}
+IMAGE_PATTERN = re.compile(r"sha256:[0-9a-f]{64}\Z")
+RERUN_SCRIPT = 'python3 -c "import os,sys; print(os.path.realpath(sys.executable))" > /evidence/interpreter.txt && exec make reproduce'
+
+
+def digest_bytes(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def independent_inventory(directory: Path) -> list[dict[str, Any]]:
+    if not directory.exists() or directory.is_symlink() or not directory.is_dir():
+        raise RuntimeError(f"invalid inventory root: {directory}")
+    found: list[dict[str, Any]] = []
+    for parent, directories, files in os.walk(directory, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        directories.sort()
+        files.sort()
+        for directory_name in directories:
+            child = parent_path / directory_name
+            if child.is_symlink():
+                raise RuntimeError(f"inventory contains symlinked directory: {child}")
+        for file_name in files:
+            child = parent_path / file_name
+            metadata = child.lstat()
+            if not stat.S_ISREG(metadata.st_mode):
+                raise RuntimeError(f"inventory contains non-regular path: {child}")
+            raw = child.read_bytes()
+            found.append(
+                {
+                    "path": child.relative_to(directory).as_posix(),
+                    "sha256": hashlib.sha256(raw).hexdigest(),
+                    "size": len(raw),
+                }
+            )
+    found.sort(key=lambda item: item["path"])
+    return found
+
+
+def independent_comparisons(checkout: Path, expected_paths: list[str]) -> list[dict[str, Any]]:
+    generated_inventory = {item["path"]: item for item in independent_inventory(checkout / "generated")}
+    reference_inventory = {item["path"]: item for item in independent_inventory(checkout / "reference")}
+    results: list[dict[str, Any]] = []
+    for relative in sorted(expected_paths):
+        generated = (checkout / "generated" / relative).read_bytes()
+        reference = (checkout / "reference" / relative).read_bytes()
+        results.append(
+            {
+                "byte_equal": generated == reference,
+                "generated_sha256": generated_inventory[relative]["sha256"],
+                "generated_size": generated_inventory[relative]["size"],
+                "path": relative,
+                "reference_sha256": reference_inventory[relative]["sha256"],
+                "reference_size": reference_inventory[relative]["size"],
+            }
+        )
+    return results
+
+
+def execute(command: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[bytes]:
+    return subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def require_success(command: list[str], *, cwd: Path | None = None) -> bytes:
+    result = execute(command, cwd=cwd)
+    if result.returncode != 0:
+        raise RuntimeError(f"command failed ({result.returncode}): {command!r}; stdout={result.stdout!r}; stderr={result.stderr!r}")
+    return result.stdout
+
+
+def isolated_invocation(docker: str, image: str, checkout: Path, evidence: Path, script: str) -> list[str]:
+    return [
+        docker,
+        "run",
+        "--rm",
+        "--network",
+        "none",
+        "--read-only",
+        "--cap-drop",
+        "ALL",
+        "--security-opt",
+        "no-new-privileges",
+        "--tmpfs",
+        "/tmp:rw,nosuid,size=64m",
+        "--mount",
+        f"type=bind,src={checkout},dst=/work",
+        "--mount",
+        f"type=bind,src={evidence},dst=/evidence",
+        "--workdir",
+        "/work",
+        image,
+        "sh",
+        "-lc",
+        script,
+    ]
+
+
+def strip_one_final_newline(payload: bytes) -> str:
+    if payload.endswith(b"\n"):
+        payload = payload[:-1]
+    return payload.decode("utf-8")
+
+
+def git_revision(checkout: Path) -> str:
+    return require_success(["git", "rev-parse", "HEAD"], cwd=checkout).decode("ascii").strip()
+
+
+class Checks:
+    def __init__(self) -> None:
+        self.direct: dict[str, bool] = {}
+        self.rerun: dict[str, bool] = {}
+        self.mismatches: list[dict[str, Any]] = []
+        self.category_inputs: dict[str, list[bool]] = {name: [] for name in CATEGORIES}
+
+    def add(self, phase: str, name: str, actual: Any, expected: Any, category: str | None = None) -> bool:
+        passed = type(actual) is type(expected) and actual == expected
+        target = self.direct if phase == "direct" else self.rerun
+        target[name] = passed
+        if category is not None:
+            self.category_inputs[category].append(passed)
+        if not passed:
+            def json_safe(value: Any) -> Any:
+                if isinstance(value, bytes):
+                    return {"byte_count": len(value), "sha256": hashlib.sha256(value).hexdigest()}
+                return value
+
+            self.mismatches.append(
+                {"actual": json_safe(actual), "check": name, "expected": json_safe(expected), "phase": phase}
+            )
+        return passed
+
+    def truth(self, phase: str, name: str, passed: bool, detail: str, category: str | None = None) -> bool:
+        target = self.direct if phase == "direct" else self.rerun
+        target[name] = bool(passed)
+        if category is not None:
+            self.category_inputs[category].append(bool(passed))
+        if not passed:
+            self.mismatches.append({"check": name, "detail": detail, "phase": phase})
+        return passed
+
+    def category_results(self) -> dict[str, bool]:
+        return {name: bool(values) and all(values) for name, values in self.category_inputs.items()}
+
+
+def compare_inventory_fields(
+    checks: Checks,
+    phase: str,
+    prefix: str,
+    actual: Any,
+    expected: list[dict[str, Any]],
+    inventory_category: str,
+    hash_category: str,
+) -> None:
+    checks.truth(phase, f"{prefix}.is_list", isinstance(actual, list), f"expected list, got {type(actual).__name__}", inventory_category)
+    if not isinstance(actual, list):
+        return
+    checks.add(phase, f"{prefix}.length", len(actual), len(expected), inventory_category)
+    for index in range(max(len(actual), len(expected))):
+        if index >= len(actual) or index >= len(expected):
+            checks.truth(phase, f"{prefix}[{index}].present", False, "missing or extra inventory entry", inventory_category)
+            continue
+        observed = actual[index]
+        wanted = expected[index]
+        checks.truth(
+            phase,
+            f"{prefix}[{index}].keys",
+            isinstance(observed, dict) and set(observed) == INVENTORY_KEYS,
+            f"inventory keys differ: {observed!r}",
+            inventory_category,
+        )
+        if not isinstance(observed, dict):
+            continue
+        checks.add(phase, f"{prefix}[{index}].path", observed.get("path"), wanted["path"], inventory_category)
+        checks.add(phase, f"{prefix}[{index}].size", observed.get("size"), wanted["size"], inventory_category)
+        checks.add(phase, f"{prefix}[{index}].sha256", observed.get("sha256"), wanted["sha256"], hash_category)
+
+
+def compare_comparison_fields(checks: Checks, phase: str, actual: Any, expected: list[dict[str, Any]]) -> None:
+    category = "per-output comparisons"
+    checks.truth(phase, "comparisons.is_list", isinstance(actual, list), "comparisons is not a list", category)
+    if not isinstance(actual, list):
+        return
+    checks.add(phase, "comparisons.length", len(actual), len(expected), category)
+    for index in range(max(len(actual), len(expected))):
+        if index >= len(actual) or index >= len(expected):
+            checks.truth(phase, f"comparisons[{index}].present", False, "missing or extra comparison", category)
+            continue
+        observed, wanted = actual[index], expected[index]
+        checks.truth(
+            phase,
+            f"comparisons[{index}].keys",
+            isinstance(observed, dict) and set(observed) == COMPARISON_KEYS,
+            f"comparison keys differ: {observed!r}",
+            category,
+        )
+        if not isinstance(observed, dict):
+            continue
+        for field in sorted(COMPARISON_KEYS):
+            checks.add(phase, f"comparisons[{index}].{field}", observed.get(field), wanted[field], category)
+
+
+def new_checkout(destination: Path, release_repo: Path, revision: str) -> None:
+    require_success(["git", "clone", "-q", "--no-local", str(release_repo), str(destination)])
+    require_success(["git", "checkout", "-q", "--detach", revision], cwd=destination)
+    dirty = require_success(["git", "status", "--porcelain"], cwd=destination)
+    if dirty:
+        raise RuntimeError(f"new checkout is dirty: {dirty!r}")
+
+
+def capture_baseline(config: dict[str, Any], expected_paths: list[str]) -> tuple[list[dict[str, bool]], list[dict[str, Any]]]:
+    baseline_root = ROOT / "baseline_runs"
+    if baseline_root.exists():
+        shutil.rmtree(baseline_root)
+    baseline_root.mkdir()
+    category_rows: list[dict[str, bool]] = []
+    records: list[dict[str, Any]] = []
+    for index in range(1, RUN_COUNT + 1):
+        run_dir = baseline_root / f"run_{index:02d}"
+        checkout = run_dir / "checkout"
+        evidence = run_dir / "evidence"
+        evidence.mkdir(parents=True)
+        new_checkout(checkout, ROOT / "release_repo", config["release_revision"])
+        command = isolated_invocation(
+            config["docker_cli"],
+            config["image_id"],
+            checkout,
+            evidence,
+            "exec make reproduce",
+        )
+        process = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        merged = process.stdout
+        (run_dir / "merged.log").write_bytes(merged)
+        generated = independent_inventory(checkout / "generated")
+        paths_ok = [item["path"] for item in generated] == expected_paths
+        record = {
+            "exit_status": int(process.returncode),
+            "generated_inventory": [item["path"] for item in generated],
+            "generated_sha256": {item["path"]: item["sha256"] for item in generated},
+            "literal_command": EXPECTED_COMMAND,
+            "merged_log": {"byte_count": len(merged), "path": "merged.log", "sha256": digest_bytes(merged)},
+            "run_index": index,
+        }
+        (run_dir / "baseline_record.json").write_text(
+            json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n"
+        )
+        categories = {name: False for name in CATEGORIES}
+        categories["literal command"] = record["literal_command"] == EXPECTED_COMMAND
+        categories["integer exit status"] = type(record["exit_status"]) is int
+        categories["generated-file inventory"] = paths_ok
+        categories["generated hashes"] = paths_ok and all(IMAGE_PATTERN.fullmatch("sha256:" + value) for value in record["generated_sha256"].values())
+        category_rows.append(categories)
+        records.append(record)
+    return category_rows, records
+
+
+def png_dimensions(path: Path) -> tuple[int, int]:
+    payload = path.read_bytes()
+    if len(payload) < 24 or payload[:8] != b"\x89PNG\r\n\x1a\n" or payload[12:16] != b"IHDR":
+        raise ValueError("not a valid PNG header")
+    return struct.unpack(">II", payload[16:24])
+
+
+def make_figure(primary_rows: list[dict[str, bool]], baseline_rows: list[dict[str, bool]]) -> None:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+    from matplotlib.colors import ListedColormap
+    import numpy as np
+
+    matplotlib.rcParams.update(
+        {
+            "font.family": "DejaVu Sans",
+            "font.size": 8,
+            "axes.titlesize": 11,
+            "axes.labelsize": 9,
+            "savefig.dpi": 150,
+        }
+    )
+    matrix = np.array([[int(row[name]) for name in CATEGORIES] for row in primary_rows], dtype=int)
+    primary_percent = matrix.mean(axis=1) * 100.0
+    baseline_percent = np.array(
+        [sum(int(row[name]) for name in CATEGORIES) / len(CATEGORIES) * 100.0 for row in baseline_rows]
+    )
+    figure, (left, right) = plt.subplots(1, 2, figsize=(1600 / 150, 900 / 150), dpi=150, gridspec_kw={"width_ratios": [1.55, 1]})
+    left.imshow(matrix, cmap=ListedColormap(["#d73027", "#1a9850"]), vmin=0, vmax=1, aspect="auto", interpolation="nearest")
+    left.set_title("Independent verification of primary evidence")
+    left.set_yticks(range(RUN_COUNT), [f"Run {index}" for index in range(1, RUN_COUNT + 1)])
+    left.set_xticks(range(len(CATEGORIES)), CATEGORIES, rotation=48, ha="right", rotation_mode="anchor")
+    for y in range(RUN_COUNT):
+        for x in range(len(CATEGORIES)):
+            left.text(x, y, str(matrix[y, x]), ha="center", va="center", color="white", fontweight="bold")
+    left.set_xticks(np.arange(-0.5, len(CATEGORIES), 1), minor=True)
+    left.set_yticks(np.arange(-0.5, RUN_COUNT, 1), minor=True)
+    left.grid(which="minor", color="white", linewidth=0.7)
+    left.tick_params(which="minor", bottom=False, left=False)
+
+    positions = np.arange(RUN_COUNT)
+    width = 0.36
+    right.bar(positions - width / 2, primary_percent, width, label="Primary verified", color="#2166ac")
+    right.bar(positions + width / 2, baseline_percent, width, label="Baseline complete", color="#f4a582")
+    right.axhline(100.0, color="black", linestyle="--", linewidth=1.2, label="Required 100%")
+    right.set_title("Evidence completeness by run")
+    right.set_ylabel("Verified categories (%)")
+    right.set_xticks(positions, [f"Run {index}" for index in range(1, RUN_COUNT + 1)])
+    right.set_ylim(0, 108)
+    right.grid(axis="y", color="#dddddd", linewidth=0.7)
+    right.legend(loc="lower right")
+    figure.subplots_adjust(left=0.055, right=0.985, bottom=0.29, top=0.92, wspace=0.22)
+    figures = ROOT / "figures"
+    figures.mkdir(exist_ok=True)
+    destination = figures / "evidence_verification.png"
+    figure.savefig(destination, dpi=150, metadata={"Software": "matplotlib 3.9.2"})
+    plt.close(figure)
+    shutil.copyfile(destination, ROOT / "evidence_verification.png")
+
+
+def main() -> None:
+    config = json.loads((ROOT / "study_config.json").read_text(encoding="utf-8"))
+    expected_paths = sorted(config["expected_output_paths"])
+    docker = config["docker_cli"]
+    locked_image = config["image_id"]
+    inspect = require_success([docker, "image", "inspect", locked_image, "--format", "{{.Id}}"])
+    inspected_image = inspect.decode("ascii").strip()
+    interpreter_probe = require_success(
+        [
+            docker,
+            "run",
+            "--rm",
+            "--network",
+            "none",
+            locked_image,
+            "python3",
+            "-c",
+            "import os,sys; print(os.path.realpath(sys.executable))",
+        ]
+    )
+    independently_resolved_interpreter = strip_one_final_newline(interpreter_probe)
+
+    verification_root = ROOT / "verification_reruns"
+    if verification_root.exists():
+        shutil.rmtree(verification_root)
+    verification_root.mkdir()
+    run_results: list[dict[str, Any]] = []
+    primary_records: list[dict[str, Any]] = []
+    atomic_direct_pass = 0
+    atomic_direct_total = 0
+    rerun_pass = 0
+    rerun_total = 0
+    direct_log_pass = 0
+    rerun_log_pass = 0
+
+    for run_index in range(1, RUN_COUNT + 1):
+        checks = Checks()
+        run_dir = ROOT / "runs" / f"run_{run_index:02d}"
+        record = json.loads((run_dir / "record.json").read_text(encoding="utf-8"))
+        primary_records.append(record)
+        checkout = run_dir / "checkout"
+        checks.truth("direct", "record.top_keys", isinstance(record, dict) and set(record) == TOP_KEYS, f"top keys differ: {set(record) if isinstance(record, dict) else type(record)}")
+        checks.add("direct", "schema_version", record.get("schema_version"), 1)
+        checks.add("direct", "run_index", record.get("run_index"), run_index)
+        direct_revision = git_revision(checkout)
+        checks.add("direct", "checkout_revision", record.get("checkout_revision"), direct_revision, "checkout revision")
+        checks.add("direct", "checkout_revision.config", direct_revision, config["release_revision"], "checkout revision")
+        checks.add("direct", "image_id.config", record.get("image_id"), locked_image, "immutable image ID")
+        checks.add("direct", "image_id.inspect", locked_image, inspected_image, "immutable image ID")
+        checks.truth("direct", "image_id.format", isinstance(locked_image, str) and IMAGE_PATTERN.fullmatch(locked_image) is not None, f"invalid image ID {locked_image!r}", "immutable image ID")
+        checks.add("direct", "interpreter_path.probe", record.get("interpreter_path"), independently_resolved_interpreter, "resolved interpreter path")
+        checks.add("direct", "literal_command", record.get("literal_command"), EXPECTED_COMMAND, "literal command")
+        checks.add("direct", "literal_command.config", config["literal_command"], EXPECTED_COMMAND, "literal command")
+        checks.truth("direct", "exit_status.type", type(record.get("exit_status")) is int, f"not integer: {record.get('exit_status')!r}", "integer exit status")
+
+        for stream_name in ("stdout", "stderr"):
+            category = f"{stream_name} hash"
+            stream_record = record.get(stream_name)
+            checks.truth("direct", f"{stream_name}.keys", isinstance(stream_record, dict) and set(stream_record) == LOG_KEYS, f"invalid log object: {stream_record!r}", category)
+            if isinstance(stream_record, dict):
+                checks.add("direct", f"{stream_name}.path", stream_record.get("path"), f"{stream_name}.log", category)
+                log_path = run_dir / f"{stream_name}.log"
+                raw = log_path.read_bytes()
+                checks.add("direct", f"{stream_name}.byte_count", stream_record.get("byte_count"), len(raw), category)
+                if checks.add("direct", f"{stream_name}.sha256", stream_record.get("sha256"), digest_bytes(raw), category):
+                    direct_log_pass += 1
+
+        direct_generated = independent_inventory(checkout / "generated")
+        direct_reference = independent_inventory(checkout / "reference")
+        generated_paths = [entry["path"] for entry in direct_generated]
+        reference_paths = [entry["path"] for entry in direct_reference]
+        checks.add("direct", "generated.expected_paths", generated_paths, expected_paths, "generated-file inventory")
+        checks.add("direct", "reference.expected_paths", reference_paths, expected_paths, "reference hashes")
+        compare_inventory_fields(checks, "direct", "generated_inventory", record.get("generated_inventory"), direct_generated, "generated-file inventory", "generated hashes")
+        compare_inventory_fields(checks, "direct", "reference_inventory", record.get("reference_inventory"), direct_reference, "reference hashes", "reference hashes")
+        direct_comparisons = independent_comparisons(checkout, expected_paths)
+        compare_comparison_fields(checks, "direct", record.get("comparisons"), direct_comparisons)
+
+        rerun_dir = verification_root / f"run_{run_index:02d}"
+        rerun_checkout = rerun_dir / "checkout"
+        rerun_evidence = rerun_dir / "evidence"
+        rerun_evidence.mkdir(parents=True)
+        new_checkout(rerun_checkout, ROOT / "release_repo", config["release_revision"])
+        process = execute(isolated_invocation(docker, locked_image, rerun_checkout, rerun_evidence, RERUN_SCRIPT))
+        rerun_interpreter = strip_one_final_newline((rerun_evidence / "interpreter.txt").read_bytes())
+        rerun_generated = independent_inventory(rerun_checkout / "generated")
+        rerun_reference = independent_inventory(rerun_checkout / "reference")
+        rerun_comparisons = independent_comparisons(rerun_checkout, expected_paths)
+        rerun_revision = git_revision(rerun_checkout)
+
+        checks.add("rerun", "checkout_revision", record.get("checkout_revision"), rerun_revision, "checkout revision")
+        checks.add("rerun", "image_id", record.get("image_id"), locked_image, "immutable image ID")
+        checks.add("rerun", "interpreter_path", record.get("interpreter_path"), rerun_interpreter, "resolved interpreter path")
+        checks.add("rerun", "literal_command", record.get("literal_command"), EXPECTED_COMMAND, "literal command")
+        checks.add("rerun", "exit_status", record.get("exit_status"), int(process.returncode), "integer exit status")
+        for stream_name, rerun_bytes in (("stdout", process.stdout), ("stderr", process.stderr)):
+            category = f"{stream_name} hash"
+            recorded_bytes = (run_dir / f"{stream_name}.log").read_bytes()
+            checks.add("rerun", f"{stream_name}.bytes", recorded_bytes, rerun_bytes, category)
+            stream_record = record.get(stream_name, {})
+            checks.add("rerun", f"{stream_name}.byte_count", stream_record.get("byte_count"), len(rerun_bytes), category)
+            if checks.add("rerun", f"{stream_name}.sha256", stream_record.get("sha256"), digest_bytes(rerun_bytes), category):
+                rerun_log_pass += 1
+        compare_inventory_fields(checks, "rerun", "generated_inventory", record.get("generated_inventory"), rerun_generated, "generated-file inventory", "generated hashes")
+        compare_inventory_fields(checks, "rerun", "reference_inventory", record.get("reference_inventory"), rerun_reference, "reference hashes", "reference hashes")
+        compare_comparison_fields(checks, "rerun", record.get("comparisons"), rerun_comparisons)
+        shutil.rmtree(rerun_dir)
+
+        categories = checks.category_results()
+        atomic_direct_pass += sum(checks.direct.values())
+        atomic_direct_total += len(checks.direct)
+        rerun_pass += sum(checks.rerun.values())
+        rerun_total += len(checks.rerun)
+        run_results.append(
+            {
+                "atomic_direct_checks": checks.direct,
+                "category_verified": categories,
+                "mismatches": checks.mismatches,
+                "rerun_checks": checks.rerun,
+                "run_index": run_index,
+            }
+        )
+
+    baseline_rows, baseline_records = capture_baseline(config, expected_paths)
+    primary_rows = [result["category_verified"] for result in run_results]
+    make_figure(primary_rows, baseline_rows)
+    figure_path = ROOT / "figures" / "evidence_verification.png"
+    figure_exists = figure_path.is_file()
+    figure_valid = False
+    figure_width = 0
+    figure_height = 0
+    if figure_exists:
+        try:
+            figure_width, figure_height = png_dimensions(figure_path)
+            figure_valid = True
+        except (OSError, ValueError, struct.error):
+            pass
+
+    category_passed = sum(sum(int(row[name]) for name in CATEGORIES) for row in primary_rows)
+    exit_successes = sum(int(record["exit_status"] == 0) for record in primary_records)
+    released_matches = sum(int(comparison["byte_equal"]) for record in primary_records for comparison in record["comparisons"])
+    output_unique_counts: dict[str, int] = {}
+    output_reference_equal: dict[str, bool] = {}
+    for path in expected_paths:
+        generated_hashes = {
+            next(item["sha256"] for item in record["generated_inventory"] if item["path"] == path)
+            for record in primary_records
+        }
+        reference_hashes = {
+            next(item["sha256"] for item in record["reference_inventory"] if item["path"] == path)
+            for record in primary_records
+        }
+        output_unique_counts[path] = len(generated_hashes)
+        output_reference_equal[path] = len(generated_hashes) == 1 and generated_hashes == reference_hashes
+
+    stable_stdout = len({record["stdout"]["sha256"] for record in primary_records}) == 1
+    stable_stderr = len({record["stderr"]["sha256"] for record in primary_records}) == 1
+    stable_interpreter = len({record["interpreter_path"] for record in primary_records}) == 1
+    stable_revision = len({record["checkout_revision"] for record in primary_records}) == 1
+    stable_image = len({record["image_id"] for record in primary_records}) == 1
+    records_and_logs_exist = all(
+        (ROOT / "runs" / f"run_{index:02d}" / relative).is_file()
+        for index in range(1, RUN_COUNT + 1)
+        for relative in ("record.json", "stdout.log", "stderr.log")
+    )
+    baseline_cells = sum(sum(int(row[name]) for name in CATEGORIES) for row in baseline_rows)
+    baseline_rate = baseline_cells / (RUN_COUNT * len(CATEGORIES))
+    all_atomic = atomic_direct_pass == atomic_direct_total and all(not result["mismatches"] for result in run_results)
+    all_rerun = rerun_pass == rerun_total
+    output_determinism = all(value == 1 for value in output_unique_counts.values()) and all(output_reference_equal.values())
+    supported = all(
+        [
+            exit_successes == RUN_COUNT,
+            category_passed == RUN_COUNT * len(CATEGORIES),
+            all_atomic,
+            all_rerun,
+            released_matches == RUN_COUNT * len(expected_paths),
+            output_determinism,
+            direct_log_pass == 12,
+            rerun_log_pass == 12,
+            stable_stdout,
+            stable_stderr,
+            stable_interpreter,
+            stable_revision,
+            stable_image,
+            figure_exists,
+            figure_valid,
+            (figure_width, figure_height) == (1600, 900),
+            records_and_logs_exist,
+        ]
+    )
+
+    verification_document = {
+        "baseline_category_results": baseline_rows,
+        "baseline_records": baseline_records,
+        "cross_run": {
+            "image_id_stable": stable_image,
+            "interpreter_path_stable": stable_interpreter,
+            "output_reference_equal": output_reference_equal,
+            "output_unique_hash_counts": output_unique_counts,
+            "release_revision_stable": stable_revision,
+            "stderr_sha256_stable": stable_stderr,
+            "stdout_sha256_stable": stable_stdout,
+        },
+        "hypothesis_supported": supported,
+        "primary_run_results": run_results,
+        "schema_version": 1,
+    }
+    (ROOT / "verification_results.json").write_text(
+        json.dumps(verification_document, sort_keys=True, separators=(",", ":")) + "\n",
+        encoding="utf-8",
+        newline="\n",
+    )
+
+    results = {
+        "atomic_field_checks_passed": atomic_direct_pass,
+        "atomic_field_checks_total": atomic_direct_total,
+        "atomic_field_verification_rate": atomic_direct_pass / atomic_direct_total,
+        "baseline_categories_captured_mean": baseline_cells / RUN_COUNT,
+        "baseline_completeness_rate": baseline_rate,
+        "cross_run_image_id_stable": stable_image,
+        "cross_run_interpreter_path_stable": stable_interpreter,
+        "cross_run_output_determinism": output_determinism,
+        "cross_run_release_revision_stable": stable_revision,
+        "cross_run_stderr_sha256_stable": stable_stderr,
+        "cross_run_stdout_sha256_stable": stable_stdout,
+        "evidence_category_checks_passed": category_passed,
+        "evidence_category_checks_total": RUN_COUNT * len(CATEGORIES),
+        "evidence_category_verification_rate": category_passed / (RUN_COUNT * len(CATEGORIES)),
+        "experiment_completed": True,
+        "figure_exists": figure_exists,
+        "figure_height_pixels": figure_height,
+        "figure_valid_png": figure_valid,
+        "figure_width_pixels": figure_width,
+        "hypothesis_decision": "SUPPORTED" if supported else "REFUTED",
+        "hypothesis_supported": supported,
+        "independent_rerun_agreement_rate": rerun_pass / rerun_total,
+        "independent_rerun_checks_passed": rerun_pass,
+        "independent_rerun_checks_total": rerun_total,
+        "primary_run_success_rate": exit_successes / RUN_COUNT,
+        "primary_runs_exit_zero": exit_successes,
+        "records_and_separate_logs_exist": records_and_logs_exist,
+        "released_output_match_rate": released_matches / (RUN_COUNT * len(expected_paths)),
+        "released_output_matches": released_matches,
+        "released_output_pairs": RUN_COUNT * len(expected_paths),
+        "separate_log_direct_checks_passed": direct_log_pass,
+        "separate_log_direct_checks_total": 12,
+        "separate_log_rerun_checks_passed": rerun_log_pass,
+        "separate_log_rerun_checks_total": 12,
+    }
+    for path in expected_paths:
+        key = path.replace(".", "_")
+        results[f"distinct_generated_hashes_{key}"] = output_unique_counts[path]
+        results[f"generated_hash_equals_reference_{key}"] = output_reference_equal[path]
+    (ROOT / "results.json").write_text(
+        json.dumps(results, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n"
+    )
+    print(
+        "Verified six primary reproductions and six baseline runs: "
+        f"success={exit_successes}/6, categories={category_passed}/66, "
+        f"outputs={released_matches}/18, rerun={rerun_pass}/{rerun_total}, "
+        f"decision={'SUPPORTED' if supported else 'REFUTED'}"
+    )
+
+
+if __name__ == "__main__":
+    main()

