+#!/usr/bin/env python3
+"""Capture six primary reproductions in isolated fresh checkouts and containers."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+CONFIG = json.loads((ROOT / "study_config.json").read_text(encoding="utf-8"))
+RUNS = 6
+LITERAL_COMMAND = "make reproduce"
+CONTAINER_SCRIPT = 'python3 -c "import os,sys; print(os.path.realpath(sys.executable))" > /evidence/interpreter.txt && exec make reproduce'
+
+
+def run_checked(command: list[str], *, cwd: Path | None = None) -> bytes:
+    result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if result.returncode != 0:
+        raise RuntimeError(
+            f"command failed ({result.returncode}): {command!r}\n"
+            f"stdout={result.stdout!r}\nstderr={result.stderr!r}"
+        )
+    return result.stdout
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def inventory(directory: Path) -> list[dict[str, object]]:
+    if not directory.is_dir() or directory.is_symlink():
+        raise RuntimeError(f"inventory root is missing, symlinked, or not a directory: {directory}")
+    entries: list[dict[str, object]] = []
+    for current, dirnames, filenames in os.walk(directory, followlinks=False):
+        current_path = Path(current)
+        for dirname in dirnames:
+            candidate = current_path / dirname
+            if candidate.is_symlink():
+                raise RuntimeError(f"symlinked directory in inventory: {candidate}")
+        for filename in filenames:
+            path = current_path / filename
+            mode = path.lstat().st_mode
+            if not stat.S_ISREG(mode):
+                raise RuntimeError(f"non-regular file in inventory: {path}")
+            data = path.read_bytes()
+            entries.append(
+                {
+                    "path": path.relative_to(directory).as_posix(),
+                    "sha256": sha256(data),
+                    "size": len(data),
+                }
+            )
+    return sorted(entries, key=lambda entry: str(entry["path"]))
+
+
+def isolated_command(checkout: Path, evidence: Path) -> list[str]:
+    return [
+        CONFIG["docker_cli"],
+        "run",
+        "--rm",
+        "--network",
+        "none",
+        "--read-only",
+        "--cap-drop",
+        "ALL",
+        "--security-opt",
+        "no-new-privileges",
+        "--tmpfs",
+        "/tmp:rw,nosuid,size=64m",
+        "--mount",
+        f"type=bind,src={checkout},dst=/work",
+        "--mount",
+        f"type=bind,src={evidence},dst=/evidence",
+        "--workdir",
+        "/work",
+        CONFIG["image_id"],
+        "sh",
+        "-lc",
+        CONTAINER_SCRIPT,
+    ]
+
+
+def final_newline_only(data: bytes) -> str:
+    if data.endswith(b"\n"):
+        data = data[:-1]
+    return data.decode("utf-8")
+
+
+def main() -> None:
+    if CONFIG["literal_command"] != LITERAL_COMMAND:
+        raise RuntimeError("configured literal command differs from independently expected command")
+    runs_root = ROOT / "runs"
+    if runs_root.exists():
+        shutil.rmtree(runs_root)
+    runs_root.mkdir()
+    expected = sorted(CONFIG["expected_output_paths"])
+    release_repo = ROOT / "release_repo"
+
+    for run_index in range(1, RUNS + 1):
+        run_dir = runs_root / f"run_{run_index:02d}"
+        checkout = run_dir / "checkout"
+        evidence = run_dir / "evidence"
+        evidence.mkdir(parents=True)
+        run_checked(["git", "clone", "-q", "--no-local", str(release_repo), str(checkout)])
+        run_checked(["git", "checkout", "-q", "--detach", CONFIG["release_revision"]], cwd=checkout)
+        status = run_checked(["git", "status", "--porcelain"], cwd=checkout)
+        if status != b"":
+            raise RuntimeError(f"run {run_index}: checkout dirty before execution: {status!r}")
+
+        process = subprocess.run(isolated_command(checkout, evidence), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        stdout_path = run_dir / "stdout.log"
+        stderr_path = run_dir / "stderr.log"
+        stdout_path.write_bytes(process.stdout)
+        stderr_path.write_bytes(process.stderr)
+        interpreter_file = evidence / "interpreter.txt"
+        if not interpreter_file.is_file() or interpreter_file.is_symlink():
+            raise RuntimeError(f"run {run_index}: interpreter evidence is absent or invalid")
+
+        generated_inventory = inventory(checkout / "generated")
+        reference_inventory = inventory(checkout / "reference")
+        generated_names = [str(entry["path"]) for entry in generated_inventory]
+        reference_names = [str(entry["path"]) for entry in reference_inventory]
+        if generated_names != expected or reference_names != expected:
+            raise RuntimeError(
+                f"run {run_index}: missing or extra paths; generated={generated_names!r}, reference={reference_names!r}"
+            )
+        generated_by_path = {str(entry["path"]): entry for entry in generated_inventory}
+        reference_by_path = {str(entry["path"]): entry for entry in reference_inventory}
+        comparisons = []
+        for path in expected:
+            generated_data = (checkout / "generated" / path).read_bytes()
+            reference_data = (checkout / "reference" / path).read_bytes()
+            comparisons.append(
+                {
+                    "byte_equal": generated_data == reference_data,
+                    "generated_sha256": generated_by_path[path]["sha256"],
+                    "generated_size": generated_by_path[path]["size"],
+                    "path": path,
+                    "reference_sha256": reference_by_path[path]["sha256"],
+                    "reference_size": reference_by_path[path]["size"],
+                }
+            )
+        revision = run_checked(["git", "rev-parse", "HEAD"], cwd=checkout).decode("ascii").strip()
+        record = {
+            "checkout_revision": revision,
+            "comparisons": comparisons,
+            "exit_status": int(process.returncode),
+            "generated_inventory": generated_inventory,
+            "image_id": CONFIG["image_id"],
+            "interpreter_path": final_newline_only(interpreter_file.read_bytes()),
+            "literal_command": LITERAL_COMMAND,
+            "reference_inventory": reference_inventory,
+            "run_index": run_index,
+            "schema_version": 1,
+            "stderr": {"byte_count": len(process.stderr), "path": "stderr.log", "sha256": sha256(process.stderr)},
+            "stdout": {"byte_count": len(process.stdout), "path": "stdout.log", "sha256": sha256(process.stdout)},
+        }
+        (run_dir / "record.json").write_text(
+            json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n",
+            encoding="utf-8",
+            newline="\n",
+        )
+        print(f"Captured run {run_index}/6: exit={process.returncode}")
+
+
+if __name__ == "__main__":
+    main()
