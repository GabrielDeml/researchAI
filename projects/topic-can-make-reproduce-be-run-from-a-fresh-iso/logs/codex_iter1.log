+#!/usr/bin/env python3
+"""Host-only structural tests; these do not substitute for container execution."""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+import prepare_release
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main() -> None:
+    with tempfile.TemporaryDirectory(prefix="reproduce-self-test-") as temporary:
+        temp = Path(temporary)
+        generator = temp / "generate.py"
+        output_a = temp / "a"
+        output_b = temp / "b"
+        generator.write_text(prepare_release.GENERATOR, encoding="utf-8", newline="\n")
+        for output in (output_a, output_b):
+            subprocess.run([sys.executable, str(generator), "--output", str(output)], check=True)
+        names = sorted(path.name for path in output_a.iterdir())
+        assert names == prepare_release.OUTPUT_PATHS
+        for name in names:
+            first = (output_a / name).read_bytes()
+            second = (output_b / name).read_bytes()
+            assert first == second
+            assert first.endswith(b"\n")
+            assert b"\r" not in first
+
+        with (output_a / "samples.csv").open(encoding="utf-8", newline="") as handle:
+            sample_rows = list(csv.reader(handle))
+        assert sample_rows[0] == ["index", "value", "bucket"]
+        assert len(sample_rows) == 4097
+        assert [int(row[0]) for row in sample_rows[1:]] == list(range(4096))
+
+        with (output_a / "frequencies.csv").open(encoding="utf-8", newline="") as handle:
+            frequency_rows = list(csv.reader(handle))
+        assert frequency_rows[0] == ["bucket", "count"]
+        assert len(frequency_rows) == 257
+        assert sum(int(row[1]) for row in frequency_rows[1:]) == 4096
+
+        values = [int(row[1]) for row in sample_rows[1:]]
+        summary = json.loads((output_a / "summary.json").read_text(encoding="utf-8"))
+        digest = hashlib.sha256(b"".join(value.to_bytes(4, "big") for value in values)).hexdigest()
+        xor_value = 0
+        for value in values:
+            xor_value ^= value
+        assert summary == {
+            "maximum": max(values),
+            "minimum": min(values),
+            "n": 4096,
+            "seed": 20250308,
+            "sha256": digest,
+            "sum": sum(values),
+            "xor": xor_value,
+        }
+        canonical = json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n"
+        assert (output_a / "summary.json").read_text(encoding="utf-8") == canonical
+
+    for source in ("prepare_release.py", "capture.py", "verify.py", "run_experiment.py", "self_test.py"):
+        subprocess.run([sys.executable, "-m", "py_compile", str(ROOT / source)], check=True)
+    assert importlib.util.find_spec("matplotlib") is not None
+    import matplotlib
+
+    assert matplotlib.__version__ == "3.9.2"
+    print("Host-only self-test passed: generator bytes, recurrence summary, CSV shapes, syntax, and matplotlib pin")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/verify.py b/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/verify.py
