+
+    results = {
+        "atomic_field_checks_passed": atomic_direct_pass,
+        "atomic_field_checks_total": atomic_direct_total,
+        "atomic_field_verification_rate": atomic_direct_pass / atomic_direct_total,
+        "baseline_categories_captured_mean": baseline_cells / RUN_COUNT,
+        "baseline_completeness_rate": baseline_rate,
+        "cross_run_image_id_stable": stable_image,
+        "cross_run_interpreter_path_stable": stable_interpreter,
+        "cross_run_output_determinism": output_determinism,
+        "cross_run_release_revision_stable": stable_revision,
+        "cross_run_stderr_sha256_stable": stable_stderr,
+        "cross_run_stdout_sha256_stable": stable_stdout,
+        "evidence_category_checks_passed": category_passed,
+        "evidence_category_checks_total": RUN_COUNT * len(CATEGORIES),
+        "evidence_category_verification_rate": category_passed / (RUN_COUNT * len(CATEGORIES)),
