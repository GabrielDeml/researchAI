+    require(run(["git", "clone", "--quiet", "--no-local", str(BARE), str(checkout)]), "BROKEN_EXECUTION", f"{kind} clone")
+    require(run(["git", "checkout", "--quiet", "--detach", revision], cwd=checkout), "BROKEN_EXECUTION", f"{kind} detach")
