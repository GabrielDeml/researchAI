+    status = require(run(["git", "status", "--porcelain"], cwd=checkout), "BROKEN_EXECUTION", f"{kind} clean check")
+    if status != b"":
+        raise InfrastructureError("BROKEN_EXECUTION", f"{kind}-{number:02d} checkout was dirty")
+    return checkout
