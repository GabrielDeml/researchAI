+def repair_cli_plugins(report: dict[str, Any]) -> None:
+    config = Path(os.environ.get("DOCKER_CONFIG", str(Path.home() / ".docker")))
+    repairs: list[dict[str, Any]] = []
+    for name in ("docker-dev", "docker-feedback"):
