+                target.unlink()
+    SOURCE.mkdir()
+    (SOURCE / "Makefile").write_text(MAKEFILE, encoding="utf-8", newline="\n")
+    (SOURCE / "reproduce.py").write_text(REPRODUCE_PY, encoding="utf-8", newline="\n")
