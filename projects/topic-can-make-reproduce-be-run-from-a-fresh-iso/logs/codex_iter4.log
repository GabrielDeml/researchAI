+        inspect_raw = require(run(["docker", "inspect", container_id]), "BROKEN_EXECUTION", f"{kind} config inspection")
+        inspected = json.loads(inspect_raw)[0]
+        command_args = inspected["Config"]["Cmd"]
+        image_id = inspected["Image"]
+    finally:
