@@ -0,0 +1,556 @@
+#!/usr/bin/env python3
+"""Independently verify primary records, run six replays, and score the hypothesis."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import stat
+import struct
+import subprocess
+from typing import Any
+import zlib
+
+
+ROOT = Path(__file__).resolve().parent
+RESULTS = ROOT / "results"
+RUNS = RESULTS / "runs"
+REPLAYS = RESULTS / "replays"
+FIGURES = ROOT / "figures"
+EXPECTED_FILES = ["integers.csv", "matrix.bin", "summary.json"]
+CATEGORIES = [
+    "checkout_revision", "runtime_identity", "interpreter_path", "literal_command",
+    "exit_status", "stdout_log", "stderr_log", "generated_file_inventory",
+    "generated_hashes", "reference_hashes", "comparisons",
+]
+EXPECTED_KEYS = set(CATEGORIES)
+SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
+REVISION = re.compile(r"[0-9a-f]{40}\Z")
+COMMANDS: list[dict[str, Any]] = []
+
+
+def dump(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")
+
+
+def invoke(argv: list[str]) -> subprocess.CompletedProcess[bytes]:
+    try:
+        result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
+    except OSError as error:
+        result = subprocess.CompletedProcess(argv, 127, b"", str(error).encode("utf-8", "replace"))
+    COMMANDS.append({
+        "argv": argv, "exit_status": result.returncode,
+        "stdout": result.stdout.decode("utf-8", "replace"),
+        "stderr": result.stderr.decode("utf-8", "replace"),
+    })
+    return result
+
+
+def inspect(identifier: str) -> tuple[dict[str, Any] | None, str | None]:
+    result = invoke(["docker", "inspect", identifier])
+    if result.returncode != 0:
+        return None, result.stderr.decode("utf-8", "replace").strip()
+    try:
+        values = json.loads(result.stdout)
+    except ValueError as error:
+        return None, f"invalid inspect JSON: {error}"
+    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
+        return None, "unexpected inspect response shape"
+    return values[0], None
+
+
+def valid_relative(name: str) -> bool:
+    path = PurePosixPath(name)
+    return bool(name) and not path.is_absolute() and ".." not in path.parts and path.as_posix() == name
+
+
+def scan(directory: Path) -> tuple[list[dict[str, Any]], dict[str, str], dict[str, bytes], list[str]]:
+    inventory: list[dict[str, Any]] = []
+    hashes: dict[str, str] = {}
+    payloads: dict[str, bytes] = {}
+    errors: list[str] = []
+    if not directory.is_dir() or directory.is_symlink():
+        return inventory, hashes, payloads, [f"{directory} is missing, not a directory, or a symlink"]
+    for parent, directories, files in os.walk(directory, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        for name in list(directories):
+            candidate = parent_path / name
+            relative = candidate.relative_to(directory).as_posix()
+            errors.append(f"nested directory or directory symlink rejected: {relative}")
+            directories.remove(name)
+        for name in files:
+            candidate = parent_path / name
+            relative = candidate.relative_to(directory).as_posix()
+            try:
+                mode = candidate.lstat().st_mode
+            except OSError as error:
+                errors.append(f"cannot stat {relative}: {error}")
+                continue
+            if not valid_relative(relative) or not stat.S_ISREG(mode) or candidate.is_symlink():
+                errors.append(f"unsafe or non-regular path rejected: {relative}")
+                continue
+            payload = candidate.read_bytes()
+            payloads[relative] = payload
+            hashes[relative] = hashlib.sha256(payload).hexdigest()
+            inventory.append({"path": relative, "byte_size": len(payload)})
+    inventory.sort(key=lambda item: item["path"])
+    hashes = {name: hashes[name] for name in sorted(hashes)}
+    payloads = {name: payloads[name] for name in sorted(payloads)}
+    names = [item["path"] for item in inventory]
+    if names != EXPECTED_FILES:
+        errors.append(f"inventory is {names!r}, expected {EXPECTED_FILES!r}")
+    return inventory, hashes, payloads, errors
+
+
+def metadata(path: Path) -> tuple[str, bool]:
+    try:
+        raw = path.read_bytes()
+        text = raw.decode("utf-8", "strict")
+    except (OSError, UnicodeError):
+        return "", False
+    good = text.endswith("\n") and len(text.splitlines()) == 1
+    return (text[:-1] if good else ""), good
+
+
+def cp_from(container_id: str, source: str, destination: Path) -> str | None:
+    result = invoke(["docker", "cp", f"{container_id}:{source}", str(destination)])
+    if result.returncode != 0:
+        return result.stderr.decode("utf-8", "replace").strip() or f"docker cp exited {result.returncode}"
+    return None
+
+
+def direct_comparisons(generated: dict[str, bytes], reference: dict[str, bytes]) -> dict[str, dict[str, Any]]:
+    result: dict[str, dict[str, Any]] = {}
+    for name in EXPECTED_FILES:
+        left = generated.get(name)
+        right = reference.get(name)
+        result[name] = {
+            "generated_hash": hashlib.sha256(left).hexdigest() if left is not None else None,
+            "reference_hash": hashlib.sha256(right).hexdigest() if right is not None else None,
+            "byte_equal": left == right if left is not None and right is not None else False,
+        }
+    return result
+
+
+def log_claim(filename: str, payload: bytes) -> dict[str, Any]:
+    return {"filename": filename, "byte_length": len(payload), "sha256": hashlib.sha256(payload).hexdigest()}
+
+
+def archive_hashes(root: Path, prefix: str, target: dict[str, dict[str, Any]]) -> None:
+    for relative in ["stdout.log", "stderr.log"] + [f"outputs/{name}" for name in EXPECTED_FILES] + [f"reference/{name}" for name in EXPECTED_FILES]:
+        path = root / relative
+        if path.is_file() and not path.is_symlink():
+            payload = path.read_bytes()
+            target[f"{prefix}/{relative}"] = {"byte_length": len(payload), "sha256": hashlib.sha256(payload).hexdigest()}
+
+
+def png_chunk(kind: bytes, payload: bytes) -> bytes:
+    body = kind + payload
+    return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
+
+
+def write_matrix_png(path: Path, evidence: list[list[bool]], comparisons: list[list[bool]]) -> None:
+    width, height = 840, 360
+    pixels = bytearray(b"\xff\xff\xff" * width * height)
+
+    def rectangle(x0: int, y0: int, x1: int, y1: int, color: tuple[int, int, int]) -> None:
+        for y in range(max(0, y0), min(height, y1)):
+            start = (y * width + max(0, x0)) * 3
+            stop = (y * width + min(width, x1)) * 3
+            pixels[start:stop] = bytes(color) * ((stop - start) // 3)
+
+    # 6 rows x 14 columns; dark separators distinguish the evidence/output boundary.
+    origin_x, origin_y, cell_w, cell_h = 126, 48, 48, 42
+    for row in range(6):
+        row_values = evidence[row] + comparisons[row]
+        for column, passed in enumerate(row_values):
+            x0 = origin_x + column * cell_w
+            y0 = origin_y + row * cell_h
+            rectangle(x0, y0, x0 + cell_w - 2, y0 + cell_h - 2, (38, 166, 91) if passed else (214, 64, 69))
+    rectangle(origin_x + 11 * cell_w - 3, origin_y - 6, origin_x + 11 * cell_w + 1, origin_y + 6 * cell_h, (30, 30, 30))
+    # Machine-visible run markers at left (one black bar per run index).
+    for row in range(6):
+        for mark in range(row + 1):
+            rectangle(28 + mark * 12, origin_y + row * cell_h + 12, 35 + mark * 12, origin_y + row * cell_h + 24, (25, 25, 25))
+
+    raw = bytearray()
+    stride = width * 3
+    for y in range(height):
+        raw.append(0)
+        raw.extend(pixels[y * stride:(y + 1) * stride])
+    legend = json.dumps({
+        "rows": [f"run-{index}" for index in range(1, 7)],
+        "columns": CATEGORIES + [f"output:{name}" for name in EXPECTED_FILES],
+        "green": "pass", "red": "fail",
+    }, sort_keys=True, separators=(",", ":")).encode("latin-1")
+    png = (
+        b"\x89PNG\r\n\x1a\n"
+        + png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+        + png_chunk(b"tEXt", b"Legend\x00" + legend)
+        + png_chunk(b"IDAT", zlib.compress(bytes(raw), 9))
+        + png_chunk(b"IEND", b"")
+    )
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(png)
+
