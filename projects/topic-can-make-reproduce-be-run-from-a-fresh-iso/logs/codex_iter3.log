+#!/usr/bin/env python3
+"""Create and capture six isolated primary ``make reproduce`` containers."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import stat
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RESULTS = ROOT / "results"
+RUNS = RESULTS / "runs"
+EXPECTED = ["integers.csv", "matrix.bin", "summary.json"]
+EXPECTED_TOP_LEVEL = {
+    "checkout_revision", "runtime_identity", "interpreter_path", "literal_command",
+    "exit_status", "stdout_log", "stderr_log", "generated_file_inventory",
+    "generated_hashes", "reference_hashes", "comparisons",
+}
+SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
+COMMANDS: list[dict[str, Any]] = []
+
+
+class Broken(RuntimeError):
+    pass
+
+
+def dump(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")
+
+
+def invoke(argv: list[str]) -> subprocess.CompletedProcess[bytes]:
+    try:
+        result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
+    except OSError as error:
+        result = subprocess.CompletedProcess(argv, 127, b"", str(error).encode("utf-8", "replace"))
+    COMMANDS.append({
+        "argv": argv, "exit_status": result.returncode,
+        "stdout": result.stdout.decode("utf-8", "replace"),
+        "stderr": result.stderr.decode("utf-8", "replace"),
+    })
+    return result
+
+
+def checked(argv: list[str], label: str) -> bytes:
+    result = invoke(argv)
+    if result.returncode != 0:
+        raise Broken(f"{label} failed with exit status {result.returncode}: {result.stderr.decode('utf-8', 'replace').strip()}")
+    return result.stdout
+
+
+def inspect(identifier: str) -> dict[str, Any]:
+    try:
+        values = json.loads(checked(["docker", "inspect", identifier], f"docker inspect {identifier}"))
+    except (ValueError, TypeError) as error:
+        raise Broken(f"invalid docker inspect JSON for {identifier}: {error}") from error
+    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
+        raise Broken(f"unexpected docker inspect result for {identifier}")
+    return values[0]
+
+
+def valid_relative(name: str) -> bool:
+    path = PurePosixPath(name)
+    return bool(name) and not path.is_absolute() and ".." not in path.parts and path.as_posix() == name
+
+
+def scan(directory: Path) -> tuple[list[dict[str, Any]], dict[str, str], list[str]]:
+    inventory: list[dict[str, Any]] = []
+    hashes: dict[str, str] = {}
+    errors: list[str] = []
+    if not directory.is_dir() or directory.is_symlink():
+        return inventory, hashes, [f"{directory.name} is missing, not a directory, or a symlink"]
+    for parent, directories, files in os.walk(directory, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        for name in list(directories):
+            candidate = parent_path / name
+            if candidate.is_symlink():
+                errors.append(f"symlink directory rejected: {candidate.relative_to(directory).as_posix()}")
+                directories.remove(name)
+            else:
+                errors.append(f"extra directory rejected: {candidate.relative_to(directory).as_posix()}")
+        for name in files:
+            candidate = parent_path / name
+            relative = candidate.relative_to(directory).as_posix()
+            try:
+                mode = candidate.lstat().st_mode
+            except OSError as error:
+                errors.append(f"cannot stat {relative}: {error}")
+                continue
+            if not valid_relative(relative) or not stat.S_ISREG(mode) or candidate.is_symlink():
+                errors.append(f"unsafe or non-regular path rejected: {relative}")
+                continue
+            payload = candidate.read_bytes()
+            inventory.append({"path": relative, "byte_size": len(payload)})
+            hashes[relative] = hashlib.sha256(payload).hexdigest()
+    inventory.sort(key=lambda item: item["path"])
+    hashes = {name: hashes[name] for name in sorted(hashes)}
+    names = [item["path"] for item in inventory]
+    if names != EXPECTED:
+        errors.append(f"inventory was {names!r}, expected {EXPECTED!r}")
+    return inventory, hashes, errors
+
+
+def cp_from(container_id: str, source: str, destination: Path) -> str | None:
+    result = invoke(["docker", "cp", f"{container_id}:{source}", str(destination)])
+    if result.returncode != 0:
+        return result.stderr.decode("utf-8", "replace").strip() or f"docker cp exited {result.returncode}"
+    return None
+
+
+def read_metadata(path: Path) -> str:
+    try:
+        payload = path.read_bytes()
+        text = payload.decode("utf-8", "strict")
+    except (OSError, UnicodeError):
+        return ""
+    if not text.endswith("\n") or len(text.splitlines()) != 1:
+        return ""
+    return text[:-1]
+
+
+def create_record(run_dir: Path, container_id: str, image_id: str, exit_status: int) -> tuple[dict[str, Any], list[str]]:
+    stdout = (run_dir / "stdout.log").read_bytes()
+    stderr = (run_dir / "stderr.log").read_bytes()
+    inventory, generated_hashes, errors = scan(run_dir / "outputs")
+    _, reference_hashes, reference_errors = scan(run_dir / "reference")
+    errors.extend(reference_errors)
+    comparisons: dict[str, dict[str, Any]] = {}
+    for name in EXPECTED:
+        generated_path = run_dir / "outputs" / name
+        reference_path = run_dir / "reference" / name
+        generated_payload = generated_path.read_bytes() if generated_path.is_file() and not generated_path.is_symlink() else None
+        reference_payload = reference_path.read_bytes() if reference_path.is_file() and not reference_path.is_symlink() else None
+        comparisons[name] = {
+            "generated_hash": hashlib.sha256(generated_payload).hexdigest() if generated_payload is not None else None,
+            "reference_hash": hashlib.sha256(reference_payload).hexdigest() if reference_payload is not None else None,
+            "byte_equal": generated_payload == reference_payload if generated_payload is not None and reference_payload is not None else False,
+        }
+    record = {
+        "checkout_revision": read_metadata(run_dir / "reproduce_revision"),
+        "runtime_identity": {"container_id": container_id, "image_id": image_id},
+        "interpreter_path": read_metadata(run_dir / "reproduce_interpreter_path"),
+        "literal_command": {"command": "make reproduce", "argv": ["make", "reproduce"]},
+        "exit_status": exit_status,
+        "stdout_log": {"filename": "stdout.log", "byte_length": len(stdout), "sha256": hashlib.sha256(stdout).hexdigest()},
+        "stderr_log": {"filename": "stderr.log", "byte_length": len(stderr), "sha256": hashlib.sha256(stderr).hexdigest()},
+        "generated_file_inventory": inventory,
+        "generated_hashes": generated_hashes,
+        "reference_hashes": reference_hashes,
+        "comparisons": comparisons,
+    }
+    if set(record) != EXPECTED_TOP_LEVEL:
+        raise AssertionError("record schema does not have exactly 11 top-level categories")
+    return record, errors
+
+
+def broken(error: BaseException, attempted: int, created_ids: list[str], preparation: dict[str, Any]) -> int:
+    status = {
+        "status": "BROKEN", "error": str(error), "primary_runs_attempted": attempted,
+        "primary_container_ids": created_ids, "commands": COMMANDS,
+        "docker_context": preparation.get("docker_context", ""),
+        "docker_endpoint": preparation.get("docker_endpoint", ""),
+    }
+    dump(RESULTS / "status.json", status)
+    dump(ROOT / "results.json", {
+        "status": "BROKEN", "error": str(error), "primary_runs_attempted": attempted,
+        "primary_containers_created": len(created_ids), "evidence_checks_passed": 0,
+        "evidence_checks_total": 66, "byte_comparisons_passed": 0, "byte_comparisons_total": 18,
+    })
+    print(f"BROKEN while creating primary experiment: {error}")
+    return 2
+
+
+def main() -> int:
+    preparation: dict[str, Any] = {}
+    created: list[tuple[str, str]] = []
+    try:
+        preparation = json.loads((RESULTS / "preparation.json").read_text(encoding="utf-8"))
+        if preparation.get("status") != "PREPARED":
+            raise Broken("fixture/image preparation did not complete")
+        image_id = preparation.get("image_id")
+        if not isinstance(image_id, str) or not SHA256_ID.fullmatch(image_id):
+            raise Broken("preparation record has no valid immutable experiment image ID")
+        current_id = checked(["docker", "image", "inspect", image_id, "--format", "{{.Id}}"], "experiment image reinspection").decode("ascii", "strict").strip()
+        if current_id != image_id:
+            raise Broken("experiment image no longer resolves to its recorded immutable ID")
+
+        if RUNS.exists() or RUNS.is_symlink():
+            if RUNS.is_dir() and not RUNS.is_symlink():
+                shutil.rmtree(RUNS)
+            else:
+                RUNS.unlink()
+        RUNS.mkdir(parents=True)
+
+        # Remove only stale containers carrying this experiment's exact deterministic names.
+        for index in range(1, 7):
+            invoke(["docker", "rm", "-f", f"reproduce-primary-{index}"])
+
+        # Creation is completed and validated for all six before any container is started.
+        for index in range(1, 7):
+            name = f"reproduce-primary-{index}"
+            argv = [
+                "docker", "create", "--pull", "never", "--network", "none",
+                "--name", name, image_id, "make", "reproduce",
+            ]
+            result = invoke(argv)
+            if result.returncode != 0:
+                raise Broken(f"primary container {index} creation failed: {result.stderr.decode('utf-8', 'replace').strip()}")
+            container_id = result.stdout.decode("ascii", "strict").strip()
+            data = inspect(container_id)
+            if data.get("Id") != container_id or data.get("Image") != image_id:
+                raise Broken(f"primary container {index} identity/image mismatch")
+            if data.get("Path") != "make" or data.get("Args") != ["reproduce"]:
+                raise Broken(f"primary container {index} does not have literal argv make reproduce")
+            if data.get("HostConfig", {}).get("NetworkMode") != "none":
+                raise Broken(f"primary container {index} does not use network mode none")
+            mounts = data.get("Mounts")
+            if mounts != []:
+                raise Broken(f"primary container {index} unexpectedly has mounts: {mounts!r}")
+            created.append((name, container_id))
+
+    except BaseException as error:
+        return broken(error, len(created), [item[1] for item in created], preparation)
+
+    image_id = preparation["image_id"]
+    execution_failures: list[str] = []
+    primary_statuses: list[int] = []
+    for index, (name, container_id) in enumerate(created, start=1):
+        run_dir = RUNS / f"run-{index}"
+        run_dir.mkdir()
+        start_argv = ["docker", "start", "-a", container_id]
+        start_result = invoke(start_argv)
+        (run_dir / "stdout.log").write_bytes(start_result.stdout)
+        (run_dir / "stderr.log").write_bytes(start_result.stderr)
+        try:
+            inspected = inspect(container_id)
+            exit_status = inspected["State"]["ExitCode"]
+            if isinstance(exit_status, bool) or not isinstance(exit_status, int):
+                raise ValueError("ExitCode is not an integer")
+        except (KeyError, TypeError, ValueError, Broken) as error:
+            exit_status = -999
+            execution_failures.append(f"run {index}: could not obtain authoritative integer exit status: {error}")
+        primary_statuses.append(exit_status)
+        attach_agrees = start_result.returncode == exit_status
+        if not attach_agrees:
+            execution_failures.append(f"run {index}: docker start -a returned {start_result.returncode}, inspect returned {exit_status}")
+
+        copy_errors: list[str] = []
+        for source, destination_name in [
+            ("/work/fixture/outputs", "outputs"), ("/work/fixture/reference", "reference"),
+            ("/tmp/reproduce_interpreter_path", "reproduce_interpreter_path"),
+            ("/tmp/reproduce_revision", "reproduce_revision"),
+        ]:
+            error = cp_from(container_id, source, run_dir / destination_name)
+            if error:
+                copy_errors.append(f"{source}: {error}")
+        record, scan_errors = create_record(run_dir, container_id, image_id, exit_status)
+        dump(run_dir / "record.json", record)
+        dump(run_dir / "capture_metadata.json", {
+            "container_name": name, "docker_start_attach_argv": start_argv,
+            "attach_exit_status": start_result.returncode, "authoritative_exit_status": exit_status,
+            "attach_status_agrees": attach_agrees, "copy_errors": copy_errors,
+            "inventory_errors": scan_errors,
+        })
+        execution_failures.extend(f"run {index}: {item}" for item in copy_errors + scan_errors)
+        print(f"Primary run {index}: container={container_id[:12]} exit={exit_status} stdout={len(start_result.stdout)}B stderr={len(start_result.stderr)}B")
+
+    dump(RESULTS / "capture.json", {
+        "status": "PRIMARY_COMPLETE", "image_id": image_id,
+        "primary_container_ids": [item[1] for item in created],
+        "primary_exit_statuses": primary_statuses, "execution_failures": execution_failures,
+        "commands": COMMANDS,
+    })
+    dump(RESULTS / "status.json", {"status": "PRIMARY_COMPLETE", "primary_runs_attempted": 6, "primary_runs_completed": 6})
+    print(f"Completed six primary containers; {sum(status == 0 for status in primary_statuses)}/6 exited zero")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/prepare_fixture.py b/projects/topic-can-make-reproduce-be-run-from-a-fresh-iso/workspace/prepare_fixture.py
