+    dump(ROOT / "results.json", flat_results)
+    dump(RESULTS / "status.json", {"status": status, "verifier_exit_status": verifier_exit_status})
+
+    # Required retained-container cleanup happens only after verification JSON and PNG are final.
+    cleanup: list[dict[str, Any]] = []
