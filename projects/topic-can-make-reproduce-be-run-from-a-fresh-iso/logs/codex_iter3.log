#!/usr/bin/env python3
"""Capture six primary runs. This module is independent of the generator/verifier."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
from typing import Any


ROOT = Path(__file__).resolve().parent
RUN_COUNT = 6
EXPECTED = ["data.csv", "summary.json", "histogram.png"]
COMMAND = ["make", "reproduce"]


def invoke(argv: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def checked(argv: list[str], *, cwd: Path | None = None) -> bytes:
    result = invoke(argv, cwd=cwd)
    if result.returncode != 0:
        raise RuntimeError(f"command failed ({result.returncode}): {argv!r}; stdout={result.stdout!r}; stderr={result.stderr!r}")
    return result.stdout


def digest(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def dump(path: Path, value: Any) -> None:
    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")


def regular_inventory(root: Path) -> tuple[list[str], dict[str, str]]:
    paths: list[str] = []
    hashes: dict[str, str] = {}
    if not root.is_dir() or root.is_symlink():
        return paths, hashes
    for parent, directories, files in os.walk(root, topdown=True, followlinks=False):
        parent_path = Path(parent)
        directories[:] = sorted(name for name in directories if not (parent_path / name).is_symlink())
        for name in sorted(files):
            candidate = parent_path / name
            if stat.S_ISREG(candidate.lstat().st_mode):
                relative = candidate.relative_to(root).as_posix()
                paths.append(relative)
                hashes[relative] = digest(candidate.read_bytes())
    paths.sort()
    return paths, {name: hashes[name] for name in paths}


def released_hashes(bare: Path, revision: str) -> dict[str, str]:
    hashes: dict[str, str] = {}
    for name in EXPECTED:
        blob = checked(["git", f"--git-dir={bare}", "show", f"{revision}:reference/{name}"])
        hashes[name] = digest(blob)
    return hashes


def interpreter_path(image_id: str) -> str:
    argv = [
        "docker", "run", "--rm", "--network", "none", "--pull", "never", image_id,
        "python", "-c", "import os,sys; print(os.path.realpath(sys.executable))",
    ]
    result = invoke(argv)
    if result.returncode != 0:
        raise RuntimeError(f"interpreter probe failed: stdout={result.stdout!r}; stderr={result.stderr!r}")
    if not result.stdout.endswith(b"\n") or len(result.stdout.splitlines()) != 1:
        raise RuntimeError(f"interpreter probe did not emit exactly one line: {result.stdout!r}")
    value = result.stdout[:-1].decode("utf-8")
    if not value or not value.startswith("/"):
        raise RuntimeError(f"interpreter path is not nonempty and absolute: {value!r}")
    return value


def inspect_container(name: str) -> dict[str, Any]:
    raw = checked(["docker", "inspect", name])
    values = json.loads(raw)
    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
        raise RuntimeError(f"unexpected docker inspect response for {name}")
    return values[0]


def main() -> None:
    fixture = json.loads((ROOT / "fixture.json").read_text(encoding="utf-8"))
    image_id = fixture["image_id"]
    revision = fixture["release_revision"]
    bare = ROOT / "release.git"
    evidence_root = ROOT / "evidence"
    if evidence_root.exists():
        shutil.rmtree(evidence_root)
    evidence_root.mkdir()
    reference = released_hashes(bare, revision)

    for index in range(1, RUN_COUNT + 1):
        label = f"run-{index:02d}"
        checkout = ROOT / label
        if checkout.exists():
            shutil.rmtree(checkout)
        clone = ["git", "clone", "-q", "--no-local", str(bare), str(checkout)]
        checked(clone)
        head = checked(["git", "rev-parse", "HEAD"], cwd=checkout).decode("ascii").strip()
        if head != revision:
            raise RuntimeError(f"{label}: clone HEAD {head} differs from release {revision}")
        status = checked(["git", "status", "--porcelain"], cwd=checkout)
        if status:
            raise RuntimeError(f"{label}: checkout is dirty before reproduction: {status!r}")
        if (checkout / "generated").exists() or (checkout / "generated").is_symlink():
            raise RuntimeError(f"{label}: generated/ unexpectedly exists before reproduction")

        container_name = f"reproduce-{index:02d}"
        create_argv = [
            "docker", "create", "--name", container_name, "--network", "none", "--pull", "never",
            "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
            "--tmpfs", "/tmp:rw,noexec,nosuid,size=64m",
            "-e", "PYTHONHASHSEED=0", "-e", "PYTHONDONTWRITEBYTECODE=1", "-e", "LC_ALL=C", "-e", "TZ=UTC",
            "-e", "SOURCE_DATE_EPOCH=946684800",
            "--mount", f"type=bind,src={checkout.resolve()},dst=/work", "-w", "/work",
            image_id, "make", "reproduce",
        ]
        created = invoke(create_argv)
        if created.returncode != 0:
            raise RuntimeError(f"{label}: container creation failed: stdout={created.stdout!r}; stderr={created.stderr!r}")
        container_id = created.stdout.decode("ascii").strip()
        inspected_before = inspect_container(container_name)
        mount = next((item for item in inspected_before.get("Mounts", []) if item.get("Destination") == "/work"), None)
        if inspected_before.get("Config", {}).get("Cmd") != COMMAND:
            raise RuntimeError(f"{label}: inspected Config.Cmd is not {COMMAND!r}")
        if inspected_before.get("Image") != image_id:
            raise RuntimeError(f"{label}: inspected image differs from immutable image ID")
        if inspected_before.get("HostConfig", {}).get("NetworkMode") != "none":
            raise RuntimeError(f"{label}: networking is not disabled")
        if not mount or Path(mount.get("Source", "")).resolve() != checkout.resolve():
            raise RuntimeError(f"{label}: /work mount does not identify the fresh checkout")
        full_id = inspected_before.get("Id")
        if not isinstance(full_id, str) or full_id != container_id:
            raise RuntimeError(f"{label}: create and inspect container IDs differ")

        checked(["docker", "start", container_name])
        wait_raw = checked(["docker", "wait", container_name]).decode("ascii").strip()
        try:
            wait_status = int(wait_raw)
        except ValueError as error:
            raise RuntimeError(f"{label}: docker wait did not return an integer: {wait_raw!r}") from error
        inspect_status_raw = checked(["docker", "inspect", "--format", "{{.State.ExitCode}}", container_name]).decode("ascii").strip()
        try:
            inspect_status = int(inspect_status_raw)
        except ValueError as error:
            raise RuntimeError(f"{label}: inspected exit status is not an integer: {inspect_status_raw!r}") from error

        run_evidence = evidence_root / label
        run_evidence.mkdir()
        stdout_path = run_evidence / "stdout.log"
        stderr_path = run_evidence / "stderr.log"
        with stdout_path.open("wb") as stdout_handle, stderr_path.open("wb") as stderr_handle:
            logs = subprocess.run(["docker", "logs", container_name], stdout=stdout_handle, stderr=stderr_handle)
        if logs.returncode != 0:
            raise RuntimeError(f"{label}: docker logs failed with status {logs.returncode}")
        stdout_bytes = stdout_path.read_bytes()
        stderr_bytes = stderr_path.read_bytes()
        resolved = interpreter_path(image_id)
        inventory, generated = regular_inventory(checkout / "generated")

        comparisons: list[dict[str, Any]] = []
        for name in EXPECTED:
            generated_path = checkout / "generated" / name
            generated_bytes = generated_path.read_bytes() if generated_path.is_file() and not generated_path.is_symlink() else None
            reference_bytes = checked(["git", f"--git-dir={bare}", "show", f"{revision}:reference/{name}"])
            generated_hash = digest(generated_bytes) if generated_bytes is not None else None
            comparisons.append({
                "generated_path": f"generated/{name}",
                "reference_path": f"reference/{name}",
                "generated_hash": generated_hash,
                "reference_hash": digest(reference_bytes),
                "equal": generated_bytes == reference_bytes if generated_bytes is not None else False,
            })

        record = {
            "run_index": index,
            "checkout_revision": head,
            "container_id": full_id,
            "image_id": image_id,
            "resolved_interpreter_path": resolved,
            "command_argv": COMMAND,
            "command_literal": "make reproduce",
            "exit_status": wait_status,
            "stdout_log": {"path": f"evidence/{label}/stdout.log", "byte_length": len(stdout_bytes), "sha256": digest(stdout_bytes)},
            "stderr_log": {"path": f"evidence/{label}/stderr.log", "byte_length": len(stderr_bytes), "sha256": digest(stderr_bytes)},
            "generated_file_inventory": inventory,
            "generated_hashes": generated,
            "reference_hashes": reference,
            "comparisons": comparisons,
        }
        dump(run_evidence / "record.json", record)
        print(f"Captured {label}: wait={wait_status}, inspect={inspect_status}, files={len(inventory)}")


if __name__ == "__main__":
    main()

