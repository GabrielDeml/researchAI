+#!/usr/bin/env python3
+"""Preflight Docker, create the deterministic release fixture, and build its image."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shutil
+import stat
+import subprocess
+import sys
+import time
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RESULTS = ROOT / "results"
+FIGURES = ROOT / "figures"
+FIXTURE = ROOT / "fixture"
+BUILD_CONTEXT = ROOT / "build_context"
+BASE_TAG = "python:3.12.8-bookworm"
+EXPERIMENT_TAG = "reproduce-experiment:local"
+SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
+REVISION = re.compile(r"[0-9a-f]{40}\Z")
+
+
+class Broken(RuntimeError):
+    pass
+
+
+COMMANDS: list[dict[str, Any]] = []
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")
+
+
+def run(argv: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[bytes]:
+    try:
+        result = subprocess.run(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
+    except OSError as error:
+        result = subprocess.CompletedProcess(argv, 127, b"", str(error).encode("utf-8", "replace"))
+    COMMANDS.append({
+        "argv": argv,
+        "cwd": str(cwd) if cwd else str(ROOT),
+        "exit_status": result.returncode,
+        "stdout": result.stdout.decode("utf-8", "replace"),
+        "stderr": result.stderr.decode("utf-8", "replace"),
+    })
+    return result
+
+
+def require(result: subprocess.CompletedProcess[bytes], label: str) -> bytes:
+    if result.returncode != 0:
+        raise Broken(f"{label} failed with exit status {result.returncode}: {result.stderr.decode('utf-8', 'replace').strip()}")
+    return result.stdout
+
+
+def docker_preflight() -> tuple[str, str, str]:
+    context_result = run(["docker", "context", "show"])
+    context = require(context_result, "docker context show").decode("utf-8", "strict").strip()
+    if not context:
+        raise Broken("docker context show returned an empty context")
+
+    inspect_context = run(["docker", "context", "inspect", context])
+    try:
+        context_data = json.loads(require(inspect_context, "docker context inspect"))
+        endpoint = context_data[0]["Endpoints"]["docker"]["Host"]
+    except (ValueError, IndexError, KeyError, TypeError) as error:
+        raise Broken(f"could not resolve Docker endpoint for context {context!r}: {error}") from error
+    if not isinstance(endpoint, str) or not endpoint:
+        raise Broken("Docker endpoint was not a nonempty string")
+
+    info = run(["docker", "info"])
+    if info.returncode != 0:
+        system = platform.system()
+        if system == "Darwin":
+            run(["open", "-a", "Docker"])
+        elif system == "Linux":
+            first = run(["systemctl", "--user", "start", "docker"])
+            if first.returncode != 0 and shutil.which("sudo"):
+                run(["sudo", "-n", "systemctl", "start", "docker"])
+        deadline = time.monotonic() + 180.0
+        while time.monotonic() < deadline:
+            time.sleep(2.0)
+            info = run(["docker", "info"])
+            if info.returncode == 0:
+                break
+    require(info, "docker info")
+
+    if endpoint.startswith("unix://"):
+        socket_path = Path(endpoint.removeprefix("unix://"))
+        try:
+            mode = socket_path.stat().st_mode
+        except OSError as error:
+            raise Broken(f"Docker socket {socket_path} does not exist: {error}") from error
+        if not stat.S_ISSOCK(mode):
+            raise Broken(f"Docker endpoint {socket_path} is not a Unix socket")
+        if not os.access(socket_path, os.R_OK | os.W_OK):
+            raise Broken(f"Docker socket {socket_path} is not readable and writable by uid {os.geteuid()}")
+
+    image_inspect = run(["docker", "image", "inspect", BASE_TAG])
+    raw_inspect = require(image_inspect, f"local image inspection for {BASE_TAG}")
+    try:
+        image_data = json.loads(raw_inspect)
+        base_id = image_data[0]["Id"]
+    except (ValueError, IndexError, KeyError, TypeError) as error:
+        raise Broken(f"could not parse local base image inspection: {error}") from error
+    if not isinstance(base_id, str) or not SHA256_ID.fullmatch(base_id):
+        raise Broken(f"base image has invalid immutable ID: {base_id!r}")
+
+    tool_probe = run([
+        "docker", "run", "--rm", "--pull", "never", "--network", "none", base_id,
+        "sh", "-c", "python3 --version; command -v make; command -v git",
+    ])
+    tool_stdout = require(tool_probe, "base-image Python/Make/Git probe").decode("utf-8", "strict").splitlines()
+    if len(tool_stdout) != 3 or not tool_stdout[0].startswith("Python 3.12.8") or tool_stdout[1] != "/usr/bin/make" or not tool_stdout[2]:
+        raise Broken(f"base-image tool probe returned unexpected stdout: {tool_stdout!r}")
+
+    functional = run([
+        "docker", "run", "--rm", "--pull", "never", "--network", "none", BASE_TAG,
+        "python3", "-c", "print(17)",
+    ])
+    require(functional, "network-disabled Docker functional probe")
+    if functional.stdout != b"17\n":
+        raise Broken(f"Docker functional probe stdout was {functional.stdout!r}, expected b'17\\n'")
+    return context, endpoint, base_id
+
+
+GENERATOR = r'''#!/usr/bin/env python3
+"""Generate the deterministic synthetic release artifacts."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import random
+import shutil
+import struct
+import subprocess
+import sys
+
+SEED = 20250308
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("output_directory", nargs="?", default="outputs")
+    parser.add_argument("--no-metadata", action="store_true")
+    args = parser.parse_args()
+    output = Path(args.output_directory)
+    if output.exists() or output.is_symlink():
+        if output.is_dir() and not output.is_symlink():
+            shutil.rmtree(output)
+        else:
+            output.unlink()
+    output.mkdir(parents=True)
+
+    rng = random.Random(SEED)
+    csv_path = output / "integers.csv"
+    with csv_path.open("w", encoding="utf-8", newline="\n") as handle:
+        handle.write("index,value\n")
+        for index in range(1000):
+            handle.write(f"{index},{rng.randrange(0, 1000000)}\n")
+
+    matrix_path = output / "matrix.bin"
+    with matrix_path.open("wb") as handle:
+        for _ in range(4096):
+            handle.write(struct.pack("<I", rng.randrange(0, 2**32)))
+
+    summary = {
+        "csv_rows": 1000,
+        "integers_sha256": sha256(csv_path),
+        "matrix_dimensions": [64, 64],
+        "matrix_sha256": sha256(matrix_path),
+        "seed": SEED,
+    }
+    (output / "summary.json").write_text(
+        json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n",
+        encoding="utf-8", newline="\n",
+    )
+
+    if not args.no_metadata:
+        Path("/tmp/reproduce_interpreter_path").write_text(os.path.realpath(sys.executable) + "\n", encoding="utf-8", newline="\n")
+        revision = subprocess.run(
+            ["git", "rev-parse", "HEAD"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        ).stdout.decode("utf-8", "strict").strip()
+        Path("/tmp/reproduce_revision").write_text(revision + "\n", encoding="utf-8", newline="\n")
+        sys.stdout.write("reproduce: generated 3 files\n")
+        sys.stderr.write("reproduce: deterministic seed=20250308\n")
+
+
+if __name__ == "__main__":
+    main()
+'''
+
+
+def make_fixture(base_id: str) -> str:
+    if FIXTURE.exists() or FIXTURE.is_symlink():
+        if FIXTURE.is_dir() and not FIXTURE.is_symlink():
+            shutil.rmtree(FIXTURE)
+        else:
+            FIXTURE.unlink()
+    (FIXTURE / "tools").mkdir(parents=True)
+    (FIXTURE / "reference").mkdir()
+    (FIXTURE / "tools" / "generate.py").write_text(GENERATOR, encoding="utf-8", newline="\n")
+    (FIXTURE / "Makefile").write_text("reproduce:\n\t@python3 tools/generate.py\n", encoding="utf-8", newline="\n")
+    (FIXTURE / ".gitignore").write_text("outputs/\n", encoding="utf-8", newline="\n")
+
+    reference = run([sys.executable, "tools/generate.py", "reference", "--no-metadata"], cwd=FIXTURE)
+    require(reference, "released-reference generation")
+    if reference.stdout != b"" or reference.stderr != b"":
+        raise Broken("metadata-disabled reference generation emitted logs")
+    if (FIXTURE / "outputs").exists() or (FIXTURE / "outputs").is_symlink():
+        raise Broken("outputs/ exists after released-reference generation")
+
+    fixture_mount = f"{FIXTURE.resolve()}:/work/fixture"
+    git_script = (
+        "git init -b main && "
+        "git add . && "
+        "git -c user.name='Artifact Test' -c user.email='artifact@example.invalid' commit -m 'synthetic release' && "
+        "git tag release-v1"
+    )
+    env_args = [
+        "-e", "GIT_AUTHOR_NAME=Artifact Test", "-e", "GIT_AUTHOR_EMAIL=artifact@example.invalid",
+        "-e", "GIT_COMMITTER_NAME=Artifact Test", "-e", "GIT_COMMITTER_EMAIL=artifact@example.invalid",
+        "-e", "GIT_AUTHOR_DATE=2025-01-01T00:00:00Z", "-e", "GIT_COMMITTER_DATE=2025-01-01T00:00:00Z",
+    ]
+    git_init = run([
+        "docker", "run", "--rm", "--pull", "never", "--network", "none",
+        *env_args, "-v", fixture_mount, "-w", "/work/fixture", base_id, "sh", "-c", git_script,
+    ])
+    require(git_init, "network-disabled fixture Git initialization")
+
+    revision_result = run([
+        "docker", "run", "--rm", "--pull", "never", "--network", "none",
+        "-v", fixture_mount, "-w", "/work/fixture", base_id,
+        "sh", "-c", "git status --porcelain && git rev-parse HEAD",
+    ])
+    lines = require(revision_result, "fixture revision and cleanliness check").decode("utf-8", "strict").splitlines()
+    if len(lines) != 1 or not REVISION.fullmatch(lines[0]):
+        raise Broken(f"fixture was dirty or revision was invalid: {lines!r}")
+    return lines[0]
+
+
+def build_image(base_id: str, revision: str) -> str:
+    if BUILD_CONTEXT.exists() or BUILD_CONTEXT.is_symlink():
+        if BUILD_CONTEXT.is_dir() and not BUILD_CONTEXT.is_symlink():
+            shutil.rmtree(BUILD_CONTEXT)
+        else:
+            BUILD_CONTEXT.unlink()
+    BUILD_CONTEXT.mkdir()
+    shutil.copytree(FIXTURE, BUILD_CONTEXT / "fixture", symlinks=True)
+    dockerfile = "ARG BASE_IMAGE\nFROM ${BASE_IMAGE}\nWORKDIR /work/fixture\nCOPY fixture/ /work/fixture/\n"
+    (BUILD_CONTEXT / "Dockerfile").write_text(dockerfile, encoding="utf-8", newline="\n")
+    built = run([
+        "docker", "build", "--pull=false", "--build-arg", f"BASE_IMAGE={base_id}",
+        "-t", EXPERIMENT_TAG, str(BUILD_CONTEXT),
+    ])
+    require(built, "experiment image build")
+    image_inspect = run(["docker", "image", "inspect", EXPERIMENT_TAG])
+    try:
+        image_id = json.loads(require(image_inspect, "experiment image inspection"))[0]["Id"]
+    except (ValueError, IndexError, KeyError, TypeError) as error:
+        raise Broken(f"could not parse experiment image ID: {error}") from error
+    if not isinstance(image_id, str) or not SHA256_ID.fullmatch(image_id):
+        raise Broken(f"invalid experiment image ID: {image_id!r}")
+
+    smoke_script = (
+        "test \"$(git rev-parse HEAD)\" = \"$EXPECTED_REVISION\" && "
+        "test -z \"$(git status --porcelain)\" && "
+        "test \"$(git tag --list release-v1)\" = release-v1"
+    )
+    smoke = run([
+        "docker", "run", "--rm", "--pull", "never", "--network", "none",
+        "-e", f"EXPECTED_REVISION={revision}", image_id, "sh", "-c", smoke_script,
+    ])
+    require(smoke, "network-disabled experiment-image smoke test")
+    return image_id
+
+
+def broken_result(error: BaseException, context: str = "", endpoint: str = "") -> int:
+    RESULTS.mkdir(exist_ok=True)
+    FIGURES.mkdir(exist_ok=True)
+    status = {
+        "status": "BROKEN", "error": str(error), "docker_context": context,
+        "docker_endpoint": endpoint, "commands": COMMANDS, "primary_runs_attempted": 0,
+    }
+    write_json(RESULTS / "status.json", status)
+    write_json(ROOT / "results.json", {
+        "status": "BROKEN", "error": str(error), "primary_runs_attempted": 0,
+        "evidence_checks_passed": 0, "evidence_checks_total": 66,
+        "byte_comparisons_passed": 0, "byte_comparisons_total": 18,
+    })
+    print(f"BROKEN before primary runs: {error}")
+    return 2
+
+
+def main() -> int:
+    RESULTS.mkdir(exist_ok=True)
+    FIGURES.mkdir(exist_ok=True)
+    context = ""
+    endpoint = ""
+    try:
+        context, endpoint, base_id = docker_preflight()
+        revision = make_fixture(base_id)
+        image_id = build_image(base_id, revision)
+        preparation = {
+            "status": "PREPARED", "seed": 20250308, "base_image_tag": BASE_TAG,
+            "base_image_id": base_id, "image_id": image_id, "docker_context": context,
+            "docker_endpoint": endpoint, "checkout_revision": revision, "commands": COMMANDS,
+        }
+        write_json(RESULTS / "preparation.json", preparation)
+        write_json(RESULTS / "status.json", {"status": "PREPARED", "primary_runs_attempted": 0})
+        print(f"Prepared deterministic fixture {revision} and immutable image {image_id}")
+        return 0
+    except BaseException as error:
+        return broken_result(error, context, endpoint)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
