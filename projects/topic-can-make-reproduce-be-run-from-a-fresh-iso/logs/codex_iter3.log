@@ -0,0 +1,556 @@
+#!/usr/bin/env python3
+"""Independently verify primary records, run six replays, and score the hypothesis."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import stat
+import struct
+import subprocess
+from typing import Any
+import zlib
+
+
+ROOT = Path(__file__).resolve().parent
+RESULTS = ROOT / "results"
+RUNS = RESULTS / "runs"
+REPLAYS = RESULTS / "replays"
+FIGURES = ROOT / "figures"
+EXPECTED_FILES = ["integers.csv", "matrix.bin", "summary.json"]
+CATEGORIES = [
+    "checkout_revision", "runtime_identity", "interpreter_path", "literal_command",
+    "exit_status", "stdout_log", "stderr_log", "generated_file_inventory",
+    "generated_hashes", "reference_hashes", "comparisons",
+]
+EXPECTED_KEYS = set(CATEGORIES)
+SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}\Z")
+REVISION = re.compile(r"[0-9a-f]{40}\Z")
+COMMANDS: list[dict[str, Any]] = []
+
+
+def dump(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8", newline="\n")
+
+
+def invoke(argv: list[str]) -> subprocess.CompletedProcess[bytes]:
+    try:
+        result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False)
+    except OSError as error:
+        result = subprocess.CompletedProcess(argv, 127, b"", str(error).encode("utf-8", "replace"))
+    COMMANDS.append({
+        "argv": argv, "exit_status": result.returncode,
+        "stdout": result.stdout.decode("utf-8", "replace"),
+        "stderr": result.stderr.decode("utf-8", "replace"),
+    })
+    return result
+
+
+def inspect(identifier: str) -> tuple[dict[str, Any] | None, str | None]:
+    result = invoke(["docker", "inspect", identifier])
+    if result.returncode != 0:
+        return None, result.stderr.decode("utf-8", "replace").strip()
+    try:
+        values = json.loads(result.stdout)
+    except ValueError as error:
+        return None, f"invalid inspect JSON: {error}"
+    if not isinstance(values, list) or len(values) != 1 or not isinstance(values[0], dict):
+        return None, "unexpected inspect response shape"
+    return values[0], None
+
+
+def valid_relative(name: str) -> bool:
+    path = PurePosixPath(name)
+    return bool(name) and not path.is_absolute() and ".." not in path.parts and path.as_posix() == name
+
+
+def scan(directory: Path) -> tuple[list[dict[str, Any]], dict[str, str], dict[str, bytes], list[str]]:
+    inventory: list[dict[str, Any]] = []
+    hashes: dict[str, str] = {}
+    payloads: dict[str, bytes] = {}
+    errors: list[str] = []
+    if not directory.is_dir() or directory.is_symlink():
+        return inventory, hashes, payloads, [f"{directory} is missing, not a directory, or a symlink"]
+    for parent, directories, files in os.walk(directory, topdown=True, followlinks=False):
+        parent_path = Path(parent)
+        for name in list(directories):
+            candidate = parent_path / name
+            relative = candidate.relative_to(directory).as_posix()
+            errors.append(f"nested directory or directory symlink rejected: {relative}")
+            directories.remove(name)
+        for name in files:
+            candidate = parent_path / name
+            relative = candidate.relative_to(directory).as_posix()
+            try:
+                mode = candidate.lstat().st_mode
+            except OSError as error:
+                errors.append(f"cannot stat {relative}: {error}")
+                continue
+            if not valid_relative(relative) or not stat.S_ISREG(mode) or candidate.is_symlink():
+                errors.append(f"unsafe or non-regular path rejected: {relative}")
+                continue
+            payload = candidate.read_bytes()
+            payloads[relative] = payload
+            hashes[relative] = hashlib.sha256(payload).hexdigest()
+            inventory.append({"path": relative, "byte_size": len(payload)})
+    inventory.sort(key=lambda item: item["path"])
+    hashes = {name: hashes[name] for name in sorted(hashes)}
+    payloads = {name: payloads[name] for name in sorted(payloads)}
+    names = [item["path"] for item in inventory]
+    if names != EXPECTED_FILES:
+        errors.append(f"inventory is {names!r}, expected {EXPECTED_FILES!r}")
+    return inventory, hashes, payloads, errors
+
+
+def metadata(path: Path) -> tuple[str, bool]:
+    try:
+        raw = path.read_bytes()
+        text = raw.decode("utf-8", "strict")
+    except (OSError, UnicodeError):
+        return "", False
+    good = text.endswith("\n") and len(text.splitlines()) == 1
+    return (text[:-1] if good else ""), good
+
+
+def cp_from(container_id: str, source: str, destination: Path) -> str | None:
+    result = invoke(["docker", "cp", f"{container_id}:{source}", str(destination)])
+    if result.returncode != 0:
+        return result.stderr.decode("utf-8", "replace").strip() or f"docker cp exited {result.returncode}"
+    return None
+
+
+def direct_comparisons(generated: dict[str, bytes], reference: dict[str, bytes]) -> dict[str, dict[str, Any]]:
+    result: dict[str, dict[str, Any]] = {}
+    for name in EXPECTED_FILES:
+        left = generated.get(name)
+        right = reference.get(name)
+        result[name] = {
+            "generated_hash": hashlib.sha256(left).hexdigest() if left is not None else None,
+            "reference_hash": hashlib.sha256(right).hexdigest() if right is not None else None,
+            "byte_equal": left == right if left is not None and right is not None else False,
+        }
+    return result
+
+
+def log_claim(filename: str, payload: bytes) -> dict[str, Any]:
+    return {"filename": filename, "byte_length": len(payload), "sha256": hashlib.sha256(payload).hexdigest()}
+
+
+def archive_hashes(root: Path, prefix: str, target: dict[str, dict[str, Any]]) -> None:
+    for relative in ["stdout.log", "stderr.log"] + [f"outputs/{name}" for name in EXPECTED_FILES] + [f"reference/{name}" for name in EXPECTED_FILES]:
+        path = root / relative
+        if path.is_file() and not path.is_symlink():
+            payload = path.read_bytes()
+            target[f"{prefix}/{relative}"] = {"byte_length": len(payload), "sha256": hashlib.sha256(payload).hexdigest()}
+
+
+def png_chunk(kind: bytes, payload: bytes) -> bytes:
+    body = kind + payload
+    return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)
+
+
+def write_matrix_png(path: Path, evidence: list[list[bool]], comparisons: list[list[bool]]) -> None:
+    width, height = 840, 360
+    pixels = bytearray(b"\xff\xff\xff" * width * height)
+
+    def rectangle(x0: int, y0: int, x1: int, y1: int, color: tuple[int, int, int]) -> None:
+        for y in range(max(0, y0), min(height, y1)):
+            start = (y * width + max(0, x0)) * 3
+            stop = (y * width + min(width, x1)) * 3
+            pixels[start:stop] = bytes(color) * ((stop - start) // 3)
+
+    # 6 rows x 14 columns; dark separators distinguish the evidence/output boundary.
+    origin_x, origin_y, cell_w, cell_h = 126, 48, 48, 42
+    for row in range(6):
+        row_values = evidence[row] + comparisons[row]
+        for column, passed in enumerate(row_values):
+            x0 = origin_x + column * cell_w
+            y0 = origin_y + row * cell_h
+            rectangle(x0, y0, x0 + cell_w - 2, y0 + cell_h - 2, (38, 166, 91) if passed else (214, 64, 69))
+    rectangle(origin_x + 11 * cell_w - 3, origin_y - 6, origin_x + 11 * cell_w + 1, origin_y + 6 * cell_h, (30, 30, 30))
+    # Machine-visible run markers at left (one black bar per run index).
+    for row in range(6):
+        for mark in range(row + 1):
+            rectangle(28 + mark * 12, origin_y + row * cell_h + 12, 35 + mark * 12, origin_y + row * cell_h + 24, (25, 25, 25))
+
+    raw = bytearray()
+    stride = width * 3
+    for y in range(height):
+        raw.append(0)
+        raw.extend(pixels[y * stride:(y + 1) * stride])
+    legend = json.dumps({
+        "rows": [f"run-{index}" for index in range(1, 7)],
+        "columns": CATEGORIES + [f"output:{name}" for name in EXPECTED_FILES],
+        "green": "pass", "red": "fail",
+    }, sort_keys=True, separators=(",", ":")).encode("latin-1")
+    png = (
+        b"\x89PNG\r\n\x1a\n"
+        + png_chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+        + png_chunk(b"tEXt", b"Legend\x00" + legend)
+        + png_chunk(b"IDAT", zlib.compress(bytes(raw), 9))
+        + png_chunk(b"IEND", b"")
+    )
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(png)
+
+
+def capture_replays(image_id: str) -> tuple[list[dict[str, Any]], list[str], list[str]]:
+    if REPLAYS.exists() or REPLAYS.is_symlink():
+        if REPLAYS.is_dir() and not REPLAYS.is_symlink():
+            shutil.rmtree(REPLAYS)
+        else:
+            REPLAYS.unlink()
+    REPLAYS.mkdir(parents=True)
+    for index in range(1, 7):
+        invoke(["docker", "rm", "-f", f"reproduce-replay-{index}"])
+
+    captures: list[dict[str, Any]] = []
+    ids: list[str] = []
+    failures: list[str] = []
+    for index in range(1, 7):
+        replay_dir = REPLAYS / f"run-{index}"
+        replay_dir.mkdir()
+        name = f"reproduce-replay-{index}"
+        create_argv = [
+            "docker", "create", "--pull", "never", "--network", "none",
+            "--name", name, image_id, "make", "reproduce",
+        ]
+        created = invoke(create_argv)
+        container_id = created.stdout.decode("ascii", "ignore").strip() if created.returncode == 0 else ""
+        if not container_id:
+            failures.append(f"run {index}: replay creation failed: {created.stderr.decode('utf-8', 'replace').strip()}")
+            (replay_dir / "stdout.log").write_bytes(b"")
+            (replay_dir / "stderr.log").write_bytes(created.stderr)
+            captures.append({
+                "container_id": "", "inspect": None, "exit_status": -999,
+                "attach_exit_status": created.returncode, "copy_errors": ["container was not created"],
+            })
+            continue
+        ids.append(container_id)
+        before, inspect_error = inspect(container_id)
+        if inspect_error:
+            failures.append(f"run {index}: replay pre-start inspection failed: {inspect_error}")
+        start = invoke(["docker", "start", "-a", container_id])
+        (replay_dir / "stdout.log").write_bytes(start.stdout)
+        (replay_dir / "stderr.log").write_bytes(start.stderr)
+        after, after_error = inspect(container_id)
+        if after_error:
+            failures.append(f"run {index}: replay post-start inspection failed: {after_error}")
+        exit_status = after.get("State", {}).get("ExitCode") if after else -999
+        if isinstance(exit_status, bool) or not isinstance(exit_status, int):
+            exit_status = -999
+            failures.append(f"run {index}: replay exit status was not an integer")
+        copy_errors: list[str] = []
+        for source, destination_name in [
+            ("/work/fixture/outputs", "outputs"), ("/work/fixture/reference", "reference"),
+            ("/tmp/reproduce_interpreter_path", "reproduce_interpreter_path"),
+            ("/tmp/reproduce_revision", "reproduce_revision"),
+        ]:
+            error = cp_from(container_id, source, replay_dir / destination_name)
+            if error:
+                copy_errors.append(f"{source}: {error}")
+        failures.extend(f"run {index}: {item}" for item in copy_errors)
+        captures.append({
+            "container_id": container_id, "inspect": after or before,
+            "exit_status": exit_status, "attach_exit_status": start.returncode,
+            "copy_errors": copy_errors,
+        })
+        print(f"Replay run {index}: container={container_id[:12]} exit={exit_status}")
+    return captures, ids, failures
+
+
+def safe_read_json(path: Path) -> tuple[dict[str, Any], str | None]:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError, UnicodeError) as error:
+        return {}, str(error)
+    return (value, None) if isinstance(value, dict) else ({}, "JSON root is not an object")
+
+
+def main() -> int:
+    preparation, preparation_error = safe_read_json(RESULTS / "preparation.json")
+    capture, capture_error = safe_read_json(RESULTS / "capture.json")
+    image_id = preparation.get("image_id", "")
+    base_id = preparation.get("base_image_id", "")
+    expected_revision = preparation.get("checkout_revision", "")
+    initial_failures = [message for message in [preparation_error, capture_error] if message]
+    if preparation.get("status") != "PREPARED":
+        initial_failures.append("preparation status is not PREPARED")
+    if capture.get("status") != "PRIMARY_COMPLETE":
+        initial_failures.append("capture status is not PRIMARY_COMPLETE")
+    if not isinstance(image_id, str) or not SHA256_ID.fullmatch(image_id):
+        initial_failures.append("immutable experiment image ID is invalid")
+    if not isinstance(base_id, str) or not SHA256_ID.fullmatch(base_id):
+        initial_failures.append("immutable base-image ID is invalid")
+    if not isinstance(expected_revision, str) or not REVISION.fullmatch(expected_revision):
+        initial_failures.append("expected checkout revision is invalid")
+
+    # The protocol requires direct validation of every retained original before any replay.
+    records: list[dict[str, Any]] = []
+    record_errors: list[str | None] = []
+    primary_inspections: list[dict[str, Any] | None] = []
+    primary_inspect_errors: list[str | None] = []
+    primary_ids: list[str] = []
+    for index in range(1, 7):
+        record, error = safe_read_json(RUNS / f"run-{index}" / "record.json")
+        records.append(record)
+        record_errors.append(error)
+        identity = record.get("runtime_identity", {}) if isinstance(record.get("runtime_identity"), dict) else {}
+        container_id = identity.get("container_id", "")
+        primary_ids.append(container_id if isinstance(container_id, str) else "")
+        inspected, inspect_error = inspect(container_id) if container_id else (None, "record has no container ID")
+        primary_inspections.append(inspected)
+        primary_inspect_errors.append(inspect_error)
+
+    # Independently resolve interpreter and revision from a new inspection container.
+    inspection_path = ""
+    inspection_revision = ""
+    if not initial_failures:
+        inspection = invoke([
+            "docker", "run", "--rm", "--pull", "never", "--network", "none", image_id,
+            "sh", "-c", "python3 -c 'import os,sys;print(os.path.realpath(sys.executable))'; git rev-parse HEAD",
+        ])
+        try:
+            inspection_lines = inspection.stdout.decode("utf-8", "strict").splitlines()
+        except UnicodeError:
+            inspection_lines = []
+        if inspection.returncode == 0 and len(inspection_lines) == 2:
+            inspection_path, inspection_revision = inspection_lines
+        else:
+            initial_failures.append("independent image interpreter/revision inspection failed")
+
+    replay_captures: list[dict[str, Any]] = []
+    replay_ids: list[str] = []
+    replay_failures: list[str] = []
+    if isinstance(image_id, str) and SHA256_ID.fullmatch(image_id):
+        replay_captures, replay_ids, replay_failures = capture_replays(image_id)
+    else:
+        replay_captures = [{"container_id": "", "inspect": None, "exit_status": -999, "attach_exit_status": -999, "copy_errors": []} for _ in range(6)]
+
+    all_run_ids = [item for item in primary_ids + replay_ids if item]
+    isolation_ok = (
+        len(primary_ids) == 6 and len(replay_ids) == 6 and len(all_run_ids) == 12
+        and len(set(all_run_ids)) == 12
+    )
+
+    evidence_matrix: list[list[bool]] = []
+    comparison_matrix: list[list[bool]] = []
+    failure_details: list[dict[str, Any]] = []
+    raw_hashes: dict[str, dict[str, Any]] = {}
+    primary_statuses: list[int] = []
+    replay_statuses: list[int] = []
+    inventory_passes = 0
+
+    for index in range(1, 7):
+        run_dir = RUNS / f"run-{index}"
+        replay_dir = REPLAYS / f"run-{index}"
+        record = records[index - 1]
+        primary = primary_inspections[index - 1]
+        replay = replay_captures[index - 1] if index - 1 < len(replay_captures) else {"container_id": "", "inspect": None, "exit_status": -999, "attach_exit_status": -999}
+        replay_inspect = replay.get("inspect")
+        schema_ok = record_errors[index - 1] is None and set(record) == EXPECTED_KEYS
+
+        p_inventory, p_generated_hashes, p_generated, p_generated_errors = scan(run_dir / "outputs")
+        _, p_reference_hashes, p_reference, p_reference_errors = scan(run_dir / "reference")
+        r_inventory, r_generated_hashes, r_generated, r_generated_errors = scan(replay_dir / "outputs")
+        _, r_reference_hashes, r_reference, r_reference_errors = scan(replay_dir / "reference")
+        p_comparisons = direct_comparisons(p_generated, p_reference)
+        r_comparisons = direct_comparisons(r_generated, r_reference)
+        p_revision, p_revision_format = metadata(run_dir / "reproduce_revision")
+        r_revision, r_revision_format = metadata(replay_dir / "reproduce_revision")
+        p_interpreter, p_interpreter_format = metadata(run_dir / "reproduce_interpreter_path")
+        r_interpreter, r_interpreter_format = metadata(replay_dir / "reproduce_interpreter_path")
+        p_stdout = (run_dir / "stdout.log").read_bytes() if (run_dir / "stdout.log").is_file() else b""
+        p_stderr = (run_dir / "stderr.log").read_bytes() if (run_dir / "stderr.log").is_file() else b""
+        r_stdout = (replay_dir / "stdout.log").read_bytes() if (replay_dir / "stdout.log").is_file() else b""
+        r_stderr = (replay_dir / "stderr.log").read_bytes() if (replay_dir / "stderr.log").is_file() else b""
+        archive_hashes(run_dir, f"primary/run-{index}", raw_hashes)
+        archive_hashes(replay_dir, f"replay/run-{index}", raw_hashes)
+
+        primary_exit = primary.get("State", {}).get("ExitCode") if primary else -999
+        replay_exit = replay.get("exit_status", -999)
+        if isinstance(primary_exit, bool) or not isinstance(primary_exit, int):
+            primary_exit = -999
+        if isinstance(replay_exit, bool) or not isinstance(replay_exit, int):
+            replay_exit = -999
+        primary_statuses.append(primary_exit)
+        replay_statuses.append(replay_exit)
+        capture_metadata, capture_metadata_error = safe_read_json(run_dir / "capture_metadata.json")
+
+        record_identity = record.get("runtime_identity")
+        record_command = record.get("literal_command")
+        primary_runtime = (
+            isinstance(record_identity, dict)
+            and record_identity == {"container_id": primary_ids[index - 1], "image_id": image_id}
+            and primary is not None and primary.get("Id") == primary_ids[index - 1]
+            and primary.get("Image") == image_id and primary.get("Path") == "make"
+            and primary.get("Args") == ["reproduce"] and primary.get("HostConfig", {}).get("NetworkMode") == "none"
+            and primary.get("Mounts") == []
+        )
+        replay_runtime = (
+            isinstance(replay_inspect, dict) and replay_inspect.get("Id") == replay.get("container_id")
+            and replay_inspect.get("Image") == image_id and replay_inspect.get("Path") == "make"
+            and replay_inspect.get("Args") == ["reproduce"] and replay_inspect.get("HostConfig", {}).get("NetworkMode") == "none"
+            and replay_inspect.get("Mounts") == [] and replay.get("container_id") != primary_ids[index - 1]
+        )
+
+        checks = {
+            "checkout_revision": schema_ok and p_revision_format and r_revision_format
+                and record.get("checkout_revision") == p_revision == r_revision == expected_revision == inspection_revision,
+            "runtime_identity": schema_ok and primary_runtime and replay_runtime and isolation_ok,
+            "interpreter_path": schema_ok and p_interpreter_format and r_interpreter_format
+                and isinstance(inspection_path, str) and inspection_path.startswith("/")
+                and record.get("interpreter_path") == p_interpreter == r_interpreter == inspection_path,
+            "literal_command": schema_ok and record_command == {"command": "make reproduce", "argv": ["make", "reproduce"]}
+                and primary_runtime and replay_runtime,
+            "exit_status": schema_ok and type(record.get("exit_status")) is int
+                and record.get("exit_status") == primary_exit == replay_exit
+                and capture_metadata_error is None
+                and capture_metadata.get("authoritative_exit_status") == primary_exit
+                and capture_metadata.get("attach_exit_status") == primary_exit
+                and capture_metadata.get("attach_status_agrees") is True
+                and replay.get("attach_exit_status") == replay_exit,
+            "stdout_log": schema_ok and record.get("stdout_log") == log_claim("stdout.log", p_stdout)
+                and p_stdout == r_stdout and p_stdout == b"reproduce: generated 3 files\n",
+            "stderr_log": schema_ok and record.get("stderr_log") == log_claim("stderr.log", p_stderr)
+                and p_stderr == r_stderr and p_stderr == b"reproduce: deterministic seed=20250308\n",
+            "generated_file_inventory": schema_ok and not p_generated_errors and not r_generated_errors
+                and record.get("generated_file_inventory") == p_inventory == r_inventory,
+            "generated_hashes": schema_ok and not p_generated_errors and not r_generated_errors
+                and record.get("generated_hashes") == p_generated_hashes == r_generated_hashes,
+            "reference_hashes": schema_ok and not p_reference_errors and not r_reference_errors
+                and record.get("reference_hashes") == p_reference_hashes == r_reference_hashes,
+            "comparisons": schema_ok and record.get("comparisons") == p_comparisons == r_comparisons,
+        }
+        row = [bool(checks[name]) for name in CATEGORIES]
+        evidence_matrix.append(row)
+        byte_row = [bool(p_comparisons[name]["byte_equal"]) for name in EXPECTED_FILES]
+        comparison_matrix.append(byte_row)
+        inventory_passes += int(not p_generated_errors) + int(not r_generated_errors)
+        for category in CATEGORIES:
+            if not checks[category]:
+                failure_details.append({
+                    "run": index, "category": category,
+                    "detail": {
+                        "schema_ok": schema_ok, "record_error": record_errors[index - 1],
+                        "primary_inspect_error": primary_inspect_errors[index - 1],
+                        "primary_generated_errors": p_generated_errors,
+                        "primary_reference_errors": p_reference_errors,
+                        "replay_generated_errors": r_generated_errors,
+                        "replay_reference_errors": r_reference_errors,
+                    },
+                })
+        for file_index, passed in enumerate(byte_row):
+            if not passed:
+                failure_details.append({"run": index, "comparison": EXPECTED_FILES[file_index], "detail": p_comparisons[EXPECTED_FILES[file_index]]})
+
+    evidence_passed = sum(sum(row) for row in evidence_matrix)
+    comparisons_passed = sum(sum(row) for row in comparison_matrix)
+    primary_successes = sum(status == 0 for status in primary_statuses)
+    replay_successes = sum(status == 0 for status in replay_statuses)
+    log_category_passes = sum(row[CATEGORIES.index("stdout_log")] + row[CATEGORIES.index("stderr_log")] for row in evidence_matrix)
+    all_conditions = (
+        not initial_failures and not replay_failures and len(evidence_matrix) == 6
+        and evidence_passed == 66 and comparisons_passed == 18
+        and primary_successes == 6 and replay_successes == 6
+        and isolation_ok and inventory_passes == 12
+    )
+    verifier_exit_status = 0 if all_conditions else 1
+    status = "SUPPORTED" if verifier_exit_status == 0 else "REFUTED"
+    failure_details.extend({"stage": "initial", "detail": item} for item in initial_failures)
+    failure_details.extend({"stage": "replay", "detail": item} for item in replay_failures)
+
+    verification = {
+        "status": status,
+        "evidence_categories": CATEGORIES,
+        "comparison_files": EXPECTED_FILES,
+        "evidence_matrix": evidence_matrix,
+        "byte_comparison_matrix": comparison_matrix,
+        "totals": {
+            "evidence_passed": evidence_passed, "evidence_total": 66,
+            "comparisons_passed": comparisons_passed, "comparisons_total": 18,
+            "primary_exit_zero": primary_successes, "primary_total": 6,
+            "replay_exit_zero": replay_successes, "replay_total": 6,
+        },
+        "failure_details": failure_details,
+        "primary_container_ids": primary_ids,
+        "replay_container_ids": replay_ids,
+        "immutable_image_id": image_id,
+        "base_image_id": base_id,
+        "docker_context": preparation.get("docker_context", ""),
+        "docker_endpoint": preparation.get("docker_endpoint", ""),
+        "exact_commands": {
+            "preparation": preparation.get("commands", []),
+            "primary_capture": capture.get("commands", []),
+            "verification_and_replay": COMMANDS,
+        },
+        "interpreter_path": inspection_path,
