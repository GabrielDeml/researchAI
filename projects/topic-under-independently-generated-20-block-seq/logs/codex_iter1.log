+#!/usr/bin/env python3
+"""Simulate the null distribution of lag-1 correlations after candidate selection."""
+
+from __future__ import annotations
+
+import json
+import os
+import platform
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy
+import scipy
+from scipy import stats
