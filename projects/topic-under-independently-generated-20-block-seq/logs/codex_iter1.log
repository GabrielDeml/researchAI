+SEED = 20250308
+N_EXPERIMENTS = 200_000
+N_CANDIDATES = 32
+SEQUENCE_LENGTH = 20
+BATCH_SIZE = 5_000
+N_BATCHES = N_EXPERIMENTS // BATCH_SIZE
+QUANTILE_LEVELS = numpy.array([0.05, 0.25, 0.50, 0.75, 0.95])
+KS_THRESHOLD = 0.01
+R_THRESHOLD = 0.40
+EXCEEDANCE_THRESHOLD = 0.50
+
+WORKSPACE = Path(__file__).resolve().parent
