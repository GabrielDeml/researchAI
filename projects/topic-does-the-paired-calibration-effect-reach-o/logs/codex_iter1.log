+    y_sums = np.bincount(flat_bin_ids, weights=tiled_y, minlength=minlength)
+    p_sums = np.bincount(
+        flat_bin_ids, weights=predictions.ravel(), minlength=minlength
+    )
+    return np.abs(y_sums - p_sums).reshape(n_candidates, N_BINS).sum(axis=1) / n
+
+
