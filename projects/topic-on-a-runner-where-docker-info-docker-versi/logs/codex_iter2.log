+def inspect_image(reference: str) -> tuple[dict[str, Any] | None, dict[str, Any], list[str]]:
+    record = command_record(["docker", "image", "inspect", reference], timeout=30.0)
+    failures: list[str] = []
+    image: dict[str, Any] | None = None
+    if record["exit_code"] != 0:
+        failures.append(f"docker image inspect {reference} failed; pulling is forbidden")
+    else:
+        try:
+            payload = json.loads(record["stdout"])
+            raw = payload[0]
+            image = {
+                "id": raw["Id"],
+                "repo_digests": raw.get("RepoDigests") or [],
+                "architecture": raw["Architecture"],
+                "os": raw["Os"],
+            }
+        except (ValueError, KeyError, IndexError, TypeError) as error:
+            failures.append(f"could not parse image inspection: {error}")
+    return image, record, failures
 
 
