+def attach_replay_comparisons(records: list[dict[str, Any]]) -> None:
+    primaries = {
+        record["scenario_id"]: record
+        for record in records
+        if record["pass"] == "primary"
+    }
+    for record in records:
+        if record["pass"] != "replay":
+            record["replay_output_digest_match"] = None
+            record["replay_semantic_digest_match"] = None
+            continue
+        primary = primaries.get(record["scenario_id"])
+        record["replay_output_digest_match"] = bool(
+            primary
+            and record.get("output_content_sha256") is not None
+            and record.get("output_content_sha256") == primary.get("output_content_sha256")
+        )
+        record["replay_semantic_digest_match"] = bool(
