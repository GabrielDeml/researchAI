+def docker_gate(image: str | None = None) -> tuple[list[dict[str, Any]], list[str]]:
+    commands = [
+        ["docker", "info"],
+        ["docker", "version"],
+        ["docker", "ps"],
+    ]
+    if image is not None:
+        commands.append(["docker", "image", "inspect", image])
+    records = [command_record(command, timeout=30.0) for command in commands]
+    failures: list[str] = []
+    for record in records:
+        label = " ".join(record["command"])
+        if record["exit_code"] != 0:
+            failures.append(f"{label} exit code was {record['exit_code']}")
+        lowered = record["stderr"].lower()
+        if ("docker-dev" in lowered or "docker-feedback" in lowered) and (
+            "not valid" in lowered or "failed" in lowered or "plugin" in lowered
+        ):
+            failures.append(f"{label} reported a named plugin-loading failure")
+    version = records[1]
+    if "Client:" not in version["stdout"] or "Server:" not in version["stdout"]:
+        failures.append("docker version did not report both Client and Server sections")
+    return records, failures
