+def cleanup_container(container_id: str, run_dir: Path, commands: list[dict[str, Any]]) -> tuple[bool, int]:
+    atomic_touch(run_dir / "control" / "shutdown")
+    waited = command_record(["docker", "wait", container_id], timeout=3.0)
+    commands.append(waited)
+    if waited["exit_code"] is None:
+        stopped = command_record(["docker", "stop", "--time", "1", container_id], timeout=4.0)
+        commands.append(stopped)
+    removed = command_record(["docker", "rm", "-f", container_id], timeout=5.0)
+    commands.append(removed)
+    return removed["exit_code"] == 0, monotonic_ns()
 
 
