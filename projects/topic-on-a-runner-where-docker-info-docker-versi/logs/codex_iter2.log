+def write_output(seed: int, size: int, mode: str, ready_fd: int) -> int:
+    output = RUN / "declared_output.bin"
+    with output.open("wb") as handle:
+        for chunk in deterministic_output(seed, size):
+            handle.write(chunk)
+        handle.flush()
+        os.fsync(handle.fileno())
+        if mode == "anomaly":
