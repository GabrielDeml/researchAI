+    if build["exit_code"] != 0:
+        failures.append(f"image build failed with exit code {build['exit_code']}")
+        return None, failures
+    image, inspect_record, inspect_failures = inspect_image(IMAGE_TAG)
+    preflight["built_image_inspect"] = inspect_record
+    preflight["built_image"] = image
+    failures.extend(inspect_failures)
+    return image["id"] if image is not None else None, failures
