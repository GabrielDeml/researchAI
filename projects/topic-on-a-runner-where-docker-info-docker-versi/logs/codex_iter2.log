+def wait_for_file(path: Path, deadline_ns: int) -> int:
+    while monotonic_ns() < deadline_ns:
+        if path.exists():
+            return monotonic_ns()
+        time.sleep(POLL_S)
+    raise TimeoutError(f"deadline waiting for {path.name}")
 
 
