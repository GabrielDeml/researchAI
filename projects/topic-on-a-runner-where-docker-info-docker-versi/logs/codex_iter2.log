+def calculate_metrics(
+    records: list[dict[str, Any]], image_id: str, timed_seconds: float
+) -> dict[str, Any]:
+    anomalies = [record for record in records if record["mode"] == "anomaly"]
+    controls = [record for record in records if record["mode"] == "control"]
+    output_anomalies = [
+        record for record in anomalies if record["kind"] == "output"
+    ]
+    compute_anomalies = [
+        record for record in anomalies if record["kind"] == "compute"
+    ]
+    replays = [record for record in records if record["pass"] == "replay"]
+    latencies = [
+        float(record["release_to_tree_accept_ms"])
+        for record in anomalies
+        if record.get("release_to_tree_accept_ms") is not None
+    ]
+    completed = sum(bool(record.get("completed")) for record in records)
+    anomaly_naive = sum(bool(record.get("pre_release_naive_accept")) for record in anomalies)
+    anomaly_tree = sum(bool(record.get("pre_release_tree_accept")) for record in anomalies)
+    disagreement = sum(
+        bool(record.get("pre_release_naive_accept"))
+        and not bool(record.get("pre_release_tree_accept"))
+        for record in anomalies
+    )
+    control_naive = sum(bool(record.get("pre_release_naive_accept")) for record in controls)
+    control_tree = sum(bool(record.get("pre_release_tree_accept")) for record in controls)
+    live_evidence = sum(
+        bool(record.get("pre_release_live_descendant_observed")) for record in anomalies
+    )
+    output_fd_evidence = sum(
+        bool(record.get("pre_release_descriptor_observed")) for record in output_anomalies
+    )
+    post_cleanup = sum(
+        bool(record.get("final_zero_descendants"))
+        and bool(record.get("final_zero_descriptors"))
+        for record in anomalies
