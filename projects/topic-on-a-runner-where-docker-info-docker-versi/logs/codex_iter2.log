+def calculate_metrics(
+    records: list[dict[str, Any]], image_id: str, timed_seconds: float
+) -> dict[str, Any]:
+    anomalies = [record for record in records if record["mode"] == "anomaly"]
+    controls = [record for record in records if record["mode"] == "control"]
+    output_anomalies = [
+        record for record in anomalies if record["kind"] == "output"
