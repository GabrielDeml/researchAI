+                "is_symlink": entry.is_symlink(),
+                "action": "retained",
+            }
+            stale_reason: str | None = None
+            try:
+                lstat = entry.lstat()
+                record["mode"] = oct(lstat.st_mode)
+                if entry.is_symlink():
+                    record["symlink_target"] = os.readlink(entry)
+                    if not entry.exists():
+                        stale_reason = "broken_symlink"
+                if stale_reason is None and not os.access(entry, os.R_OK):
+                    stale_reason = "unreadable_file"
+                if stale_reason is None and entry.is_file() and not os.access(entry, os.X_OK):
+                    stale_reason = "non_executable_regular_file"
+            except OSError as error:
+                stale_reason = "unreadable_file"
+                record["inspection_error"] = f"{type(error).__name__}: {error}"
+            record["stale_reason"] = stale_reason
+            if stale_reason is not None:
+                destination = QUARANTINE / name
+                suffix = 1
+                while os.path.lexists(destination):
+                    destination = QUARANTINE / f"{name}.{suffix}"
+                    suffix += 1
+                record["quarantine_destination"] = str(destination)
+                try:
+                    os.replace(entry, destination)
+                    record["action"] = "moved"
+                except OSError as error:
+                    record["action"] = "retained_stale_unwritable"
+                    record["move_error"] = f"{type(error).__name__}: {error}"
+                    failures.append(
+                        f"stale Docker CLI plugin could not be quarantined: {entry}: {error}"
+                    )
+            audit["entries"].append(record)
+    audit["ended_monotonic_ns"] = monotonic_ns()
+    audit["moved_count"] = sum(item["action"] == "moved" for item in audit["entries"])
+    audit["retained_count"] = sum(item["action"].startswith("retained") for item in audit["entries"])
+    audit["valid"] = not failures
+    atomic_json(ARTIFACTS / "plugin_audit.json", audit)
+    return audit, failures
