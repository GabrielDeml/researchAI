+#!/usr/bin/env python3
+"""PID-1 supervisor for completion-monitor fixtures."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+
+TRIAL = Path("/trial")
+
+
+def atomic_json(path: Path, value: object) -> None:
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    with temporary.open("w", encoding="utf-8") as handle:
+        json.dump(value, handle, sort_keys=True)
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, path)
+
+
+def reap_adopted_children() -> None:
+    while True:
+        try:
+            pid, _status = os.waitpid(-1, os.WNOHANG)
+        except ChildProcessError:
+            return
+        if pid == 0:
+            return
+
+
+def main() -> int:
+    if len(sys.argv) != 4:
+        print("usage: supervisor.py FIXTURE VARIANT SEED", file=sys.stderr)
+        return 64
+
+    fixture, variant, seed = sys.argv[1:]
+    command = [sys.executable, "/app/workload.py", fixture, variant, seed]
+    parent = subprocess.Popen(command, start_new_session=True)
+    parent_pgid = os.getpgid(parent.pid)
+    atomic_json(
+        TRIAL / "process.json",
+        {"parent_pid": parent.pid, "process_group_id": parent_pgid},
+    )
+
+    exit_code = parent.wait()
+    atomic_json(
+        TRIAL / "parent_exit.json",
+        {
+            "exit_code": exit_code,
+            "parent_pid": parent.pid,
+            "process_group_id": parent_pgid,
+        },
+    )
+
+    # PID 1 intentionally outlives the workload tree. It reaps descendants that
+    # are reparented after the designated parent exits, until the host stops us.
+    while True:
+        reap_adopted_children()
+        time.sleep(0.01)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
