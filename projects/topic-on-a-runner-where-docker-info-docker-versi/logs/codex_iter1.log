index 0000000000000000000000000000000000000000..ba34270b042e2d4e81d43f19263304feb249c25f
--- /dev/null
+++ b/projects/topic-on-a-runner-where-docker-info-docker-versi/workspace/README.md
@@ -0,0 +1,27 @@
+# Completion-monitor experiment
+
+This workspace compares parent-exit and process-tree-aware completion decisions
+for six dirty orphan-work fixtures and six matched clean controls over primary and
+replay passes.
+
+## Run
+
+The base image must already exist locally. The runner never pulls an image.
+
+```sh
+/opt/homebrew/bin/python3.12 -m venv .venv
+.venv/bin/pip install matplotlib==3.8.4
+MPLCONFIGDIR="$PWD/.matplotlib-cache" .venv/bin/python experiment.py
+```
+
+Docker must return exit code 0 for `docker info`, `docker version`, and
+`docker ps`, and `docker image inspect python:3.12-slim` must succeed. If any
+prerequisite fails, `results.json` reports an infrastructure failure and the
+timed section is not started.
+
+Successful measured runs create:
+
+- `results.json`: flat scalar headline metrics
+- `detailed_results.json`: per-run decisions, probes, timings, digests, failures
+- `runs.csv`: one row per measured container
+- `figures/completion_rates.png`: primary/replay checkpoint completion rates
diff --git a/projects/topic-on-a-runner-where-docker-info-docker-versi/workspace/experiment.py b/projects/topic-on-a-runner-where-docker-info-docker-versi/workspace/experiment.py
new file mode 100644
index 0000000000000000000000000000000000000000..385b82b9d34cc895b9f88fcb8ea62db4938d1af8
--- /dev/null
+++ b/projects/topic-on-a-runner-where-docker-info-docker-versi/workspace/experiment.py
@@ -0,0 +1,670 @@
+#!/usr/bin/env python3
+"""Run the parent-exit versus process-tree-aware completion experiment."""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+FIXTURE_DIR = ROOT / "fixture"
+FIGURE_DIR = ROOT / "figures"
+RUN_DIR = ROOT / ".trial-directories"
+IMAGE = "completion-monitor-test:1"
+BASE_IMAGE = "python:3.12-slim"
+PASSES = ("primary", "replay")
+VARIANTS = ("dirty", "clean")
+FIXTURES: dict[str, dict[str, Any]] = {
+    "F1": {"name": "cpu-single", "seed": 101, "kind": "cpu", "workers": 1},
+    "F2": {"name": "cpu-chain", "seed": 102, "kind": "cpu", "workers": 1},
+    "F3": {"name": "cpu-fanout", "seed": 103, "kind": "cpu", "workers": 3},
+    "F4": {"name": "open-single", "seed": 201, "kind": "open", "workers": 1},
+    "F5": {"name": "open-chain", "seed": 202, "kind": "open", "workers": 1},
+    "F6": {"name": "open-fanout", "seed": 203, "kind": "open", "workers": 2},
+}
+
+
+def run_command(
+    command: list[str], *, timeout: float = 30.0, check: bool = False
+) -> subprocess.CompletedProcess[str]:
+    completed = subprocess.run(
+        command,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=timeout,
+        check=False,
+    )
+    if check and completed.returncode != 0:
+        raise RuntimeError(
+            f"command failed ({completed.returncode}): {' '.join(command)}\n"
+            f"stdout: {completed.stdout[-2000:]}\nstderr: {completed.stderr[-2000:]}"
+        )
+    return completed
+
+
+def atomic_json(path: Path, value: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    with temporary.open("w", encoding="utf-8") as handle:
+        json.dump(value, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, path)
+
+
+def atomic_touch(path: Path) -> None:
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    with temporary.open("wb") as handle:
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, path)
+
+
+def infrastructure_checks() -> tuple[dict[str, Any], str | None]:
+    checks: dict[str, Any] = {}
+    failures: list[str] = []
+    commands = {
+        "docker_info": ["docker", "info"],
+        "docker_version": ["docker", "version"],
+        "docker_ps": ["docker", "ps"],
+        "base_image_inspect": ["docker", "image", "inspect", BASE_IMAGE],
+    }
+    for name, command in commands.items():
+        try:
+            completed = run_command(command, timeout=30.0)
+            checks[f"{name}_exit_code"] = completed.returncode
+            if completed.returncode != 0:
+                detail = (completed.stderr or completed.stdout).strip()[-1000:]
+                failures.append(
+                    f"{name} failed with exit code {completed.returncode}: {detail}"
+                )
+        except (OSError, subprocess.TimeoutExpired) as error:
+            checks[f"{name}_exit_code"] = -1
+            failures.append(f"{name} could not run: {error}")
+    return checks, "; ".join(failures) if failures else None
+
+
+def write_infrastructure_failure(checks: dict[str, Any], error: str) -> None:
+    flat: dict[str, Any] = {
+        "status": "infrastructure_failure",
+        "infrastructure_failure": True,
+        "hypothesis_evaluated": False,
+        "hypothesis_supported": False,
+        "error": error,
+        "timed_section_started": False,
+        "timed_section_seconds": 0.0,
+        "execution_success_count": 0,
+        "execution_target_count": 24,
+    }
+    flat.update(checks)
+    atomic_json(ROOT / "results.json", flat)
+    atomic_json(
+        ROOT / "detailed_results.json",
+        {"status": "infrastructure_failure", "checks": checks, "error": error},
+    )
+    print("Completion-monitor experiment: infrastructure failure")
+    print(f"Required Docker prerequisite failed: {error}")
+    print("Timed section was not started; the hypothesis was not evaluated.")
+
+
+def build_image() -> None:
+    run_command(
+        ["docker", "build", "--pull=false", "-t", IMAGE, str(FIXTURE_DIR)],
+        timeout=180.0,
+        check=True,
+    )
+
+
+def expected_paths(spec: dict[str, Any]) -> list[str]:
+    if spec["kind"] == "cpu":
+        return [f"/trial/result_{index}.txt" for index in range(spec["workers"])]
+    return [f"/trial/output_{index}.bin" for index in range(spec["workers"])]
+
+
+def container_running(name: str) -> bool:
+    completed = run_command(
+        ["docker", "inspect", "--format", "{{.State.Running}}", name], timeout=5.0
+    )
+    return completed.returncode == 0 and completed.stdout.strip() == "true"
+
+
+def probe(
+    name: str,
+    parent_exit_code: int,
+    process_group_id: int,
+    outputs: list[str],
+) -> dict[str, Any]:
+    completed = run_command(
+        [
+            "docker",
+            "exec",
+            name,
+            "python",
+            "/app/probe.py",
+            str(parent_exit_code),
+            str(process_group_id),
+            json.dumps(outputs, separators=(",", ":")),
+        ],
+        timeout=5.0,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            f"probe failed ({completed.returncode}): "
+            f"{(completed.stderr or completed.stdout).strip()[-1000:]}"
+        )
+    result = json.loads(completed.stdout)
+    for key in ("live_group_member_pids", "open_output_fds", "tree_aware_complete"):
+        if key not in result:
+            raise ValueError(f"probe omitted {key}")
+    return result
+
+
+def digest_artifacts(trial_dir: Path, spec: dict[str, Any]) -> dict[str, str]:
+    digests: dict[str, str] = {}
+    for container_path in expected_paths(spec):
+        host_path = trial_dir / Path(container_path).name
+        if not host_path.is_file():
+            raise FileNotFoundError(f"missing finalized artifact: {host_path.name}")
+        if spec["kind"] == "open" and host_path.stat().st_size != 65_536:
+            raise ValueError(
+                f"incorrect output size for {host_path.name}: {host_path.stat().st_size}"
+            )
+        digests[host_path.name] = hashlib.sha256(host_path.read_bytes()).hexdigest()
+    return digests
+
+
+def cleanup_container(name: str) -> list[str]:
+    failures: list[str] = []
+    stopped = run_command(["docker", "stop", "--time", "2", name], timeout=8.0)
+    if stopped.returncode != 0:
+        failures.append(f"docker stop failed: {stopped.stderr.strip()[-500:]}")
+    removed = run_command(["docker", "rm", name], timeout=8.0)
+    if removed.returncode != 0:
+        # A failed stop should not leave a named container blocking all later runs.
+        forced = run_command(["docker", "rm", "-f", name], timeout=8.0)
+        if forced.returncode != 0:
+            failures.append(f"docker rm failed: {forced.stderr.strip()[-500:]}")
+    return failures
+
+
+def run_trial(pass_name: str, fixture: str, variant: str) -> dict[str, Any]:
+    spec = FIXTURES[fixture]
+    trial_dir = Path(tempfile.mkdtemp(prefix=f"{pass_name}-{fixture}-{variant}-", dir=RUN_DIR))
+    name = f"completion-{pass_name}-{fixture.lower()}-{variant}-{uuid.uuid4().hex[:8]}"
+    failures: list[str] = []
+    started = time.monotonic()
+    row: dict[str, Any] = {
+        "pass": pass_name,
+        "fixture": fixture,
+        "fixture_name": spec["name"],
+        "variant": variant,
+        "seed": spec["seed"],
+        "container_name": name,
+        "parent_exit_code": None,
+        "naive_complete": False,
+        "tree_aware_complete": False,
+        "live_group_member_count": -1,
+        "open_output_fd_count": -1,
+        "checkpoint_latency_seconds": None,
+        "eventual_tree_aware_complete": False,
+        "eventual_acceptance_seconds": None,
+        "elapsed_wall_seconds": None,
+        "digests": {},
+        "failures": failures,
+        "success": False,
+    }
+
+    try:
+        command = [
+            "docker",
+            "run",
+            "-d",
+            "--pull=never",
+            "--name",
+            name,
+            "--network",
+            "none",
+            "--cpus",
+            "1",
+            "--memory",
+            "256m",
+            "--pids-limit",
+            "128",
+            "--mount",
+            f"type=bind,source={trial_dir},target=/trial",
+            IMAGE,
+            fixture,
+            variant,
+            str(spec["seed"]),
+        ]
+        started_container = run_command(command, timeout=20.0)
+        if started_container.returncode != 0:
+            raise RuntimeError(
+                f"container start failed: {started_container.stderr.strip()[-1000:]}"
+            )
+
+        exit_file = trial_dir / "parent_exit.json"
+        deadline = time.monotonic() + 10.0
+        while not exit_file.exists() and time.monotonic() < deadline:
+            if not container_running(name):
+                failures.append("unexpected container exit before parent exit record")
+                break
+            time.sleep(0.01)
+        if not exit_file.exists():
+            failures.append("timeout waiting 10 seconds for parent_exit.json")
+            return row
+
+        observed_parent_exit = time.monotonic()
+        parent_exit = json.loads(exit_file.read_text(encoding="utf-8"))
+        exit_code = int(parent_exit["exit_code"])
+        group_id = int(parent_exit["process_group_id"])
+        row["parent_exit_code"] = exit_code
+        row["naive_complete"] = exit_code == 0
+        if exit_code != 0:
+            failures.append(f"designated parent exited {exit_code}")
+        if not (trial_dir / "all_ready").exists():
+            failures.append("all_ready missing at checkpoint")
+        if not container_running(name):
+            failures.append("unexpected container exit at checkpoint")
+
+        try:
+            checkpoint = probe(name, exit_code, group_id, expected_paths(spec))
+            row["live_group_member_count"] = len(
+                checkpoint["live_group_member_pids"]
+            )
+            row["open_output_fd_count"] = len(checkpoint["open_output_fds"])
+            row["tree_aware_complete"] = bool(
+                exit_code == 0 and checkpoint["tree_aware_complete"]
+            )
+            row["checkpoint_probe"] = checkpoint
+        except Exception as error:  # Probe errors are explicitly non-completion.
+            failures.append(f"checkpoint probe error: {error}")
+            row["checkpoint_probe"] = {"error": str(error)}
+        row["checkpoint_latency_seconds"] = time.monotonic() - observed_parent_exit
+        if row["checkpoint_latency_seconds"] > 0.250:
+            failures.append(
+                "checkpoint evaluation exceeded 250 ms: "
+                f"{row['checkpoint_latency_seconds']:.6f}s"
+            )
+
+        if variant == "dirty":
+            atomic_touch(trial_dir / "release")
+            release_time = time.monotonic()
+            eventual_deadline = release_time + 10.0
+            while time.monotonic() < eventual_deadline:
+                try:
+                    eventual = probe(name, exit_code, group_id, expected_paths(spec))
+                except Exception as error:
+                    failures.append(f"eventual probe error: {error}")
+                    break
+                if eventual["tree_aware_complete"]:
+                    row["eventual_tree_aware_complete"] = True
+                    row["eventual_acceptance_seconds"] = time.monotonic() - release_time
+                    row["eventual_probe"] = eventual
+                    break
+                time.sleep(0.05)
+            if not row["eventual_tree_aware_complete"]:
+                failures.append("tree-aware monitor did not accept within 10 seconds")
+        else:
+            row["eventual_tree_aware_complete"] = bool(row["tree_aware_complete"])
+            row["eventual_acceptance_seconds"] = 0.0
+
+        try:
+            row["digests"] = digest_artifacts(trial_dir, spec)
+        except Exception as error:
+            failures.append(str(error))
+        if not container_running(name):
+            failures.append("unexpected container exit before host cleanup")
+    except Exception as error:
+        failures.append(str(error))
+    finally:
+        # Only attempt Docker cleanup if the named container exists.
+        exists = run_command(["docker", "inspect", name], timeout=5.0)
+        if exists.returncode == 0:
+            failures.extend(cleanup_container(name))
+        row["elapsed_wall_seconds"] = time.monotonic() - started
+        row["success"] = not failures
+        shutil.rmtree(trial_dir, ignore_errors=True)
+    return row
+
+
+def write_csv(rows: list[dict[str, Any]]) -> None:
+    columns = [
+        "pass",
+        "fixture",
+        "fixture_name",
+        "variant",
+        "seed",
+        "parent_exit_code",
+        "naive_complete",
+        "tree_aware_complete",
+        "live_group_member_count",
+        "open_output_fd_count",
+        "checkpoint_latency_seconds",
+        "eventual_tree_aware_complete",
+        "eventual_acceptance_seconds",
+        "elapsed_wall_seconds",
+        "success",
+        "digests_json",
+        "failures_json",
+    ]
+    temporary = ROOT / ".runs.csv.tmp"
+    with temporary.open("w", encoding="utf-8", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=columns)
+        writer.writeheader()
+        for row in rows:
+            output = {key: row.get(key) for key in columns}
+            output["digests_json"] = json.dumps(row["digests"], sort_keys=True)
+            output["failures_json"] = json.dumps(row["failures"])
+            writer.writerow(output)
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, ROOT / "runs.csv")
+
+
+def make_figure(rows: list[dict[str, Any]]) -> None:
+    import matplotlib
+
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    FIGURE_DIR.mkdir(exist_ok=True)
+    categories = [
+        ("dirty", "naive_complete", "dirty/naive"),
+        ("dirty", "tree_aware_complete", "dirty/tree-aware"),
+        ("clean", "naive_complete", "clean/naive"),
+        ("clean", "tree_aware_complete", "clean/tree-aware"),
+    ]
+    colors = ["#4C78A8", "#F58518", "#54A24B", "#E45756"]
+    figure, axes = plt.subplots(1, 2, figsize=(12, 5), sharey=True)
+    for axis, pass_name in zip(axes, PASSES, strict=True):
+        counts = [
+            sum(
+                bool(row[field])
+                for row in rows
+                if row["pass"] == pass_name and row["variant"] == variant
+            )
+            for variant, field, _label in categories
+        ]
+        bars = axis.bar(
+            range(4), [count / 6 for count in counts], color=colors, width=0.72
+        )
+        axis.set_title(pass_name.capitalize())
+        axis.set_ylim(0, 1)
+        axis.set_xticks(range(4), [item[2] for item in categories], rotation=20)
+        axis.grid(axis="y", alpha=0.25)
+        for bar, count in zip(bars, counts, strict=True):
+            height = bar.get_height()
+            axis.annotate(
+                f"{count}/6",
+                (bar.get_x() + bar.get_width() / 2, height),
+                xytext=(0, 5 if height < 0.95 else -18),
+                textcoords="offset points",
+                ha="center",
+                va="bottom",
+                color="black" if height < 0.95 else "white",
+                fontweight="bold",
+            )
+    axes[0].set_ylabel("Checkpoint completion rate")
+    figure.suptitle("Parent-exit vs process-tree-aware completion")
+    figure.tight_layout()
+    figure.savefig(FIGURE_DIR / "completion_rates.png", dpi=180)
+    plt.close(figure)
+
+
+def calculate_metrics(rows: list[dict[str, Any]]) -> tuple[dict[str, Any], list[str]]:
+    dirty = [row for row in rows if row["variant"] == "dirty"]
+    clean = [row for row in rows if row["variant"] == "clean"]
+    failures = [
+        f"{row['pass']}/{row['fixture']}/{row['variant']}: {failure}"
+        for row in rows
+        for failure in row["failures"]
+    ]
+
+    digest_matches = 0
+    decision_matches = 0
+    for fixture in FIXTURES:
+        for variant in VARIANTS:
+            primary = next(
+                row
+                for row in rows
+                if row["pass"] == "primary"
+                and row["fixture"] == fixture
+                and row["variant"] == variant
+            )
+            replay = next(
+                row
+                for row in rows
+                if row["pass"] == "replay"
+                and row["fixture"] == fixture
+                and row["variant"] == variant
+            )
+            if primary["digests"] == replay["digests"] and primary["digests"]:
+                digest_matches += 1
+            else:
+                failures.append(f"digest mismatch: {fixture}/{variant}")
+            if (
+                primary["naive_complete"] == replay["naive_complete"]
+                and primary["tree_aware_complete"] == replay["tree_aware_complete"]
+            ):
+                decision_matches += 1
+            else:
+                failures.append(f"checkpoint decision mismatch: {fixture}/{variant}")
+
+    metrics: dict[str, Any] = {
+        "dirty_naive_accepted_count": sum(row["naive_complete"] for row in dirty),
+        "dirty_naive_checkpoint_rate": sum(row["naive_complete"] for row in dirty)
+        / 12,
+        "dirty_tree_aware_accepted_count": sum(
+            row["tree_aware_complete"] for row in dirty
+        ),
+        "dirty_tree_aware_checkpoint_rate": sum(
+            row["tree_aware_complete"] for row in dirty
+        )
+        / 12,
+        "clean_naive_accepted_count": sum(row["naive_complete"] for row in clean),
+        "clean_naive_checkpoint_rate": sum(row["naive_complete"] for row in clean)
+        / 12,
+        "clean_tree_aware_accepted_count": sum(
+            row["tree_aware_complete"] for row in clean
+        ),
+        "clean_tree_aware_checkpoint_rate": sum(
+            row["tree_aware_complete"] for row in clean
+        )
+        / 12,
+        "dirty_paired_monitor_gap": sum(
+            int(row["naive_complete"]) - int(row["tree_aware_complete"])
+            for row in dirty
+        )
+        / 12,
+        "dirty_min_live_group_member_count": min(
+            row["live_group_member_count"] for row in dirty
+        ),
+        "dirty_open_fixture_min_open_output_fd_count": min(
+            row["open_output_fd_count"]
+            for row in dirty
+            if row["fixture"] in {"F4", "F5", "F6"}
+        ),
+        "dirty_cpu_fixture_max_open_output_fd_count": max(
+            row["open_output_fd_count"]
+            for row in dirty
+            if row["fixture"] in {"F1", "F2", "F3"}
+        ),
+        "dirty_eventual_accepted_count": sum(
+            row["eventual_tree_aware_complete"] for row in dirty
+        ),
+        "dirty_eventual_acceptance_rate": sum(
+            row["eventual_tree_aware_complete"] for row in dirty
+        )
+        / 12,
+        "digest_match_pair_count": digest_matches,
+        "replay_determinism_rate": digest_matches / 12,
+        "checkpoint_decision_match_pair_count": decision_matches,
+        "checkpoint_decision_replay_rate": decision_matches / 12,
+        "execution_success_count": sum(row["success"] for row in rows),
+        "execution_target_count": 24,
+        "max_checkpoint_latency_seconds": max(
+            row["checkpoint_latency_seconds"] or 0.0 for row in rows
+        ),
+        "max_run_elapsed_wall_seconds": max(row["elapsed_wall_seconds"] for row in rows),
+    }
+    for pass_name in PASSES:
+        for variant in VARIANTS:
+            selected = [
+                row
+                for row in rows
+                if row["pass"] == pass_name and row["variant"] == variant
+            ]
+            for field, monitor in (
+                ("naive_complete", "naive"),
+                ("tree_aware_complete", "tree_aware"),
+            ):
+                count = sum(row[field] for row in selected)
+                metrics[f"{pass_name}_{variant}_{monitor}_accepted_count"] = count
+                metrics[f"{pass_name}_{variant}_{monitor}_checkpoint_rate"] = count / 6
+    return metrics, failures
+
+
+def thresholds_hold(metrics: dict[str, Any], timed_seconds: float) -> bool:
+    return bool(
+        metrics["dirty_naive_accepted_count"] == 12
+        and metrics["dirty_tree_aware_accepted_count"] == 0
+        and metrics["clean_naive_accepted_count"] == 12
+        and metrics["clean_tree_aware_accepted_count"] == 12
+        and metrics["dirty_paired_monitor_gap"] == 1.0
+        and metrics["dirty_min_live_group_member_count"] >= 1
+        and metrics["dirty_open_fixture_min_open_output_fd_count"] >= 1
+        and metrics["dirty_eventual_accepted_count"] == 12
+        and metrics["digest_match_pair_count"] == 12
+        and metrics["checkpoint_decision_match_pair_count"] == 12
+        and metrics["execution_success_count"] == 24
+        and timed_seconds <= 1_200.0
+        and all(
+            metrics[f"{pass_name}_dirty_naive_accepted_count"] == 6
+            and metrics[f"{pass_name}_dirty_tree_aware_accepted_count"] == 0
+            and metrics[f"{pass_name}_clean_naive_accepted_count"] == 6
+            and metrics[f"{pass_name}_clean_tree_aware_accepted_count"] == 6
+            for pass_name in PASSES
+        )
+    )
+
+
+def main() -> int:
+    if sys.version_info < (3, 11):
+        error = f"Python 3.11+ required, found {sys.version.split()[0]}"
+        write_infrastructure_failure({"python_version_ok": False}, error)
+        return 2
+
+    checks, error = infrastructure_checks()
+    if error is not None:
+        write_infrastructure_failure(checks, error)
+        return 2
+
+    build_image()
+    RUN_DIR.mkdir(exist_ok=True)
+    FIGURE_DIR.mkdir(exist_ok=True)
+
+    smoke = run_trial("smoke", "F1", "clean")
+    if not (
+        smoke["success"]
+        and smoke["naive_complete"]
+        and smoke["tree_aware_complete"]
+    ):
+        smoke_error = f"untimed F1-clean smoke test failed: {smoke['failures']}"
+        write_infrastructure_failure(checks, smoke_error)
+        return 2
+
+    timed_start = time.monotonic()
+    rows: list[dict[str, Any]] = []
+    for pass_name in PASSES:
+        for fixture in FIXTURES:
+            for variant in VARIANTS:
+                row = run_trial(pass_name, fixture, variant)
+                rows.append(row)
+                print(
+                    f"{pass_name:7s} {fixture} {variant:5s} "
+                    f"naive={int(row['naive_complete'])} "
+                    f"tree={int(row['tree_aware_complete'])} "
+                    f"live={row['live_group_member_count']} "
+                    f"open={row['open_output_fd_count']} "
+                    f"success={int(row['success'])}",
+                    flush=True,
+                )
+
+    metrics, failures = calculate_metrics(rows)
+    write_csv(rows)
+    make_figure(rows)
+    # Create both JSON artifacts before ending the clock; the final duration is
+    # filled in immediately afterward without rerunning any analysis.
+    provisional = {
+        "status": "measured",
+        "protocol": {
+            "passes": list(PASSES),
+            "fixtures": FIXTURES,
+            "variants": list(VARIANTS),
+            "image": IMAGE,
+        },
+        "smoke_test": smoke,
+        "runs": rows,
+        "metrics": metrics,
+        "failures": failures,
+        "timed_section_seconds": time.monotonic() - timed_start,
+    }
+    atomic_json(ROOT / "detailed_results.json", provisional)
+    atomic_json(ROOT / "results.json", {"status": "finalizing"})
+    timed_seconds = time.monotonic() - timed_start
+
+    supported = not failures and thresholds_hold(metrics, timed_seconds)
+    flat: dict[str, Any] = {
+        "status": "complete",
+        "infrastructure_failure": False,
+        "hypothesis_evaluated": True,
+        "hypothesis_supported": supported,
+        "hypothesis_result": "supported" if supported else "refuted",
+        "error": "" if not failures else "; ".join(failures),
+        "timed_section_started": True,
+        "timed_section_seconds": timed_seconds,
+        "timed_section_within_1200_seconds": timed_seconds <= 1_200.0,
+        "failed_run_count": sum(not row["success"] for row in rows),
+        "digest_mismatch_count": 12 - metrics["digest_match_pair_count"],
+    }
+    flat.update(checks)
+    flat.update(metrics)
+    atomic_json(ROOT / "results.json", flat)
+    provisional["timed_section_seconds"] = timed_seconds
+    provisional["hypothesis_supported"] = supported
+    provisional["hypothesis_result"] = "supported" if supported else "refuted"
+    atomic_json(ROOT / "detailed_results.json", provisional)
+
+    print("\nCompletion-monitor experiment finished")
+    print(
+        f"Ran 24 measured containers: dirty naive "
+        f"{metrics['dirty_naive_accepted_count']}/12, dirty tree-aware "
+        f"{metrics['dirty_tree_aware_accepted_count']}/12, clean naive "
+        f"{metrics['clean_naive_accepted_count']}/12, clean tree-aware "
+        f"{metrics['clean_tree_aware_accepted_count']}/12."
+    )
+    print(
+        f"Eventual dirty acceptance {metrics['dirty_eventual_accepted_count']}/12; "
+        f"digest matches {metrics['digest_match_pair_count']}/12; successful runs "
+        f"{metrics['execution_success_count']}/24; timed section {timed_seconds:.3f}s."
+    )
+    print(f"Hypothesis: {'SUPPORTED' if supported else 'REFUTED'}")
+    return 0 if supported else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
