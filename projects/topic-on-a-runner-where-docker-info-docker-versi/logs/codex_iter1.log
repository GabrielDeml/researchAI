@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+"""Designated parent and descendant roles for all six fixtures."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+
+TRIAL = Path("/trial")
+RELEASE = TRIAL / "release"
+
+
+FIXTURES = {
+    "F1": {"kind": "cpu", "shape": "single", "workers": 1},
+    "F2": {"kind": "cpu", "shape": "chain", "workers": 1},
+    "F3": {"kind": "cpu", "shape": "fanout", "workers": 3},
+    "F4": {"kind": "open", "shape": "single", "workers": 1},
+    "F5": {"kind": "open", "shape": "chain", "workers": 1},
+    "F6": {"kind": "open", "shape": "fanout", "workers": 2},
+}
+
+
+def atomic_bytes(path: Path, payload: bytes = b"") -> None:
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    with temporary.open("wb") as handle:
+        handle.write(payload)
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(temporary, path)
+
+
+def seed_prefix(seed: int, worker_index: int) -> bytes:
+    return seed.to_bytes(8, "big", signed=False) + worker_index.to_bytes(
+        4, "big", signed=False
+    )
+
+
+def cpu_worker(seed: int, worker_index: int, ready_name: str) -> int:
+    prefix = seed_prefix(seed, worker_index)
+    atomic_bytes(TRIAL / ready_name)
+    iteration = 0
+    while True:
+        for _ in range(10_000):
+            hashlib.sha256(prefix + iteration.to_bytes(8, "big")).digest()
+            iteration += 1
+        if RELEASE.exists():
+            break
+
+    # The workload duration is deliberately timing-dependent; its finalized
+    # result is deliberately deterministic for exact replay comparison.
+    result = hashlib.sha256(prefix + b"final-result-v1").hexdigest().encode("ascii")
+    atomic_bytes(TRIAL / f"result_{worker_index}.txt", result + b"\n")
+    return 0
+
+
+def deterministic_output(seed: int, worker_index: int) -> bytes:
+    prefix = seed_prefix(seed, worker_index)
+    blocks: list[bytes] = []
+    counter = 0
+    remaining = 65_536
+    while remaining:
+        block = hashlib.sha256(prefix + counter.to_bytes(8, "big")).digest()
+        take = min(remaining, len(block))
+        blocks.append(block[:take])
+        remaining -= take
+        counter += 1
+    return b"".join(blocks)
+
+
+def output_worker(seed: int, worker_index: int, ready_name: str) -> int:
+    output_path = TRIAL / f"output_{worker_index}.bin"
+    with output_path.open("wb") as handle:
+        handle.write(deterministic_output(seed, worker_index))
+        handle.flush()
+        os.fsync(handle.fileno())
+        atomic_bytes(TRIAL / ready_name)
+        while not RELEASE.exists():
+            time.sleep(0.01)
+    return 0
+
+
+def worker_command(kind: str, seed: int, index: int, ready_name: str) -> list[str]:
+    return [
+        sys.executable,
+        __file__,
+        "worker",
+        kind,
+        str(seed),
+        str(index),
+        ready_name,
+    ]
+
+
+def chain_node(kind: str, seed: int) -> int:
+    child = subprocess.Popen(worker_command(kind, seed, 0, "ready_worker_0"))
+    while not (TRIAL / "ready_worker_0").exists():
+        if child.poll() is not None:
+            return 70
+        time.sleep(0.005)
+    atomic_bytes(TRIAL / "ready_node_0")
+    while not RELEASE.exists():
+        if child.poll() is not None:
+            return 71
+        time.sleep(0.01)
+    return child.wait()
+
+
+def expected_artifacts(kind: str, workers: int) -> list[Path]:
+    stem = "result" if kind == "cpu" else "output"
+    suffix = "txt" if kind == "cpu" else "bin"
+    return [TRIAL / f"{stem}_{index}.{suffix}" for index in range(workers)]
+
+
+def designated_parent(fixture: str, variant: str, seed: int) -> int:
+    if fixture not in FIXTURES or variant not in {"dirty", "clean"}:
+        return 64
+    spec = FIXTURES[fixture]
+    kind = str(spec["kind"])
+    shape = str(spec["shape"])
+    workers = int(spec["workers"])
+    children: list[subprocess.Popen[bytes]] = []
+
+    if shape == "chain":
+        children.append(
+            subprocess.Popen([sys.executable, __file__, "chain", kind, str(seed)])
+        )
+        readiness = [TRIAL / "ready_node_0", TRIAL / "ready_worker_0"]
+    else:
+        for index in range(workers):
+            children.append(
+                subprocess.Popen(
+                    worker_command(kind, seed, index, f"ready_worker_{index}")
+                )
+            )
+        readiness = [TRIAL / f"ready_worker_{index}" for index in range(workers)]
+
+    while not all(path.exists() for path in readiness):
+        if any(child.poll() is not None for child in children):
+            return 72
+        time.sleep(0.005)
+    atomic_bytes(TRIAL / "all_ready")
+
+    if variant == "dirty":
+        return 0
+
+    atomic_bytes(RELEASE)
+    if any(child.wait() != 0 for child in children):
+        return 73
+    artifacts = expected_artifacts(kind, workers)
+    if not all(path.is_file() for path in artifacts):
+        return 74
+    if kind == "open" and not all(path.stat().st_size == 65_536 for path in artifacts):
+        return 75
+    return 0
+
+
+def main() -> int:
+    if len(sys.argv) == 4 and sys.argv[1] in FIXTURES:
+        return designated_parent(sys.argv[1], sys.argv[2], int(sys.argv[3]))
+    if len(sys.argv) == 6 and sys.argv[1] == "worker":
+        kind, seed, index, ready_name = sys.argv[2:]
+        if kind == "cpu":
+            return cpu_worker(int(seed), int(index), ready_name)
+        if kind == "open":
+            return output_worker(int(seed), int(index), ready_name)
+    if len(sys.argv) == 4 and sys.argv[1] == "chain":
+        return chain_node(sys.argv[2], int(sys.argv[3]))
+    return 64
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
