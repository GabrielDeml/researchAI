+#!/usr/bin/env python3
+"""In-container process-group and open-output completion probe."""
+
+from __future__ import annotations
+
+import glob
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def proc_state_and_group(pid: int) -> tuple[str, int]:
+    data = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
+    close_paren = data.rfind(")")
+    if close_paren < 0:
+        raise ValueError(f"malformed /proc/{pid}/stat")
+    fields = data[close_paren + 1 :].split()
+    return fields[0], int(fields[2])
+
+
+def main() -> int:
+    if len(sys.argv) != 4:
+        print("usage: probe.py PARENT_EXIT_CODE PGID OUTPUT_PATHS_JSON", file=sys.stderr)
+        return 64
+    parent_exit_code = int(sys.argv[1])
+    group_id = int(sys.argv[2])
+    outputs = set(json.loads(sys.argv[3]))
+
+    live_group_member_pids: list[int] = []
+    for proc_path in glob.glob("/proc/[0-9]*"):
+        pid = int(proc_path.rsplit("/", 1)[1])
+        try:
+            state, process_group = proc_state_and_group(pid)
+        except (FileNotFoundError, PermissionError, ProcessLookupError):
+            continue
+        if process_group == group_id and state != "Z":
+            live_group_member_pids.append(pid)
+
+    open_output_fds: list[dict[str, object]] = []
+    for fd_path in glob.glob("/proc/[0-9]*/fd/*"):
+        try:
+            target = os.readlink(fd_path)
+        except (FileNotFoundError, PermissionError, ProcessLookupError):
+            continue
+        if target in outputs:
+            parts = fd_path.split("/")
+            open_output_fds.append(
+                {"pid": int(parts[2]), "fd": int(parts[4]), "target": target}
+            )
+
+    live_group_member_pids.sort()
+    open_output_fds.sort(key=lambda item: (int(item["pid"]), int(item["fd"])))
+    result = {
+        "parent_exited_zero": parent_exit_code == 0,
+        "live_group_member_pids": live_group_member_pids,
+        "open_output_fds": open_output_fds,
+        "tree_aware_complete": (
+            parent_exit_code == 0
+            and not live_group_member_pids
+            and not open_output_fds
+        ),
+    }
+    print(json.dumps(result, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
