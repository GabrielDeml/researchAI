+    def state_manifest(self, state_dir: Path, log_dir: Path) -> None:
+        manifest: dict[str, Any] = {}
+        for path in sorted(state_dir.iterdir()) if state_dir.exists() else []:
+            if not path.is_file():
+                continue
+            data = path.read_bytes()
+            entry: dict[str, Any] = {"size": len(data), "sha256": hashlib.sha256(data).hexdigest()}
+            if len(data) <= 65536:
+                try:
+                    entry["text"] = data.decode("utf-8")
+                except UnicodeDecodeError:
+                    pass
+            manifest[path.name] = entry
+        atomic_write_json(log_dir / "state-files.json", manifest)
 
