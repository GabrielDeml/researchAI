+def exact_mcnemar(naive_only: int, aware_only: int) -> float:
+    discordant = naive_only + aware_only
+    if discordant == 0:
+        return 1.0
+    tail = min(naive_only, aware_only)
+    probability = sum(math.comb(discordant, k) for k in range(tail + 1)) / (2 ** discordant)
+    return min(1.0, 2.0 * probability)
 
