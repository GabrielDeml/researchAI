#!/usr/bin/env python3
"""Host runner for the strict Docker completion-monitor experiment."""

from __future__ import annotations

import csv
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import shutil
import statistics
import subprocess
import sys
import time
from typing import Any


ROOT = Path(__file__).resolve().parent
SRC = ROOT / "src"
RUNS = ROOT / "runs"
ARTIFACTS = ROOT / "artifacts"
QUARANTINE = ROOT / "plugin_quarantine"
FIGURES = ROOT / "figures"
ATTEMPTS = ROOT / "attempts"
BASE_TAG = "python:3.12-slim"
IMAGE_TAG = "completion-monitor-exp:1"
TIMED_LIMIT_S = 1200.0
EXECUTION_LIMIT_S = 20.0
POLL_S = 0.020
PLUGIN_DIRS = (
    Path.home() / ".docker/cli-plugins",
    Path("/usr/local/lib/docker/cli-plugins"),
    Path("/usr/local/libexec/docker/cli-plugins"),
    Path("/opt/homebrew/lib/docker/cli-plugins"),
    Path("/opt/homebrew/libexec/docker/cli-plugins"),
)
PLUGINS = ("docker-dev", "docker-feedback")
FIXTURES: dict[str, dict[str, Any]] = {
    "C1": {"kind": "compute", "seed": 1101, "parameter": 100_000},
    "C2": {"kind": "compute", "seed": 1102, "parameter": 150_000},
    "C3": {"kind": "compute", "seed": 1103, "parameter": 200_000},
    "O1": {"kind": "output", "seed": 2101, "parameter": 65_536},
    "O2": {"kind": "output", "seed": 2102, "parameter": 262_144},
    "O3": {"kind": "output", "seed": 2103, "parameter": 1_048_576},
}
SCENARIOS = [
    (fixture, mode)
    for fixture in ("C1", "C2", "C3", "O1", "O2", "O3")
    for mode in ("anomaly", "control")
]


def monotonic_ns() -> int:
    return time.clock_gettime_ns(time.CLOCK_MONOTONIC)


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{monotonic_ns()}.tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)


def atomic_touch(path: Path) -> int:
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{monotonic_ns()}.tmp")
    with temporary.open("wb") as handle:
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
    return monotonic_ns()


def append_jsonl(path: Path, value: Any) -> None:
    encoded = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, encoded)
        os.fsync(fd)
    finally:
        os.close(fd)


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_digest(value: dict[str, Any]) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def command_record(command: list[str], timeout: float = 60.0) -> dict[str, Any]:
    started = monotonic_ns()
    try:
        completed = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
            env={**os.environ, "PYTHONHASHSEED": "0"},
        )
        ended = monotonic_ns()
        return {
            "command": command,
            "stdout": completed.stdout,
            "stderr": completed.stderr,
            "exit_code": completed.returncode,
            "started_monotonic_ns": started,
            "ended_monotonic_ns": ended,
            "elapsed_seconds": (ended - started) / 1e9,
            "timeout": False,
        }
    except subprocess.TimeoutExpired as error:
        ended = monotonic_ns()
        return {
            "command": command,
            "stdout": error.stdout or "",
            "stderr": error.stderr or "",
            "exit_code": None,
            "started_monotonic_ns": started,
            "ended_monotonic_ns": ended,
            "elapsed_seconds": (ended - started) / 1e9,
            "timeout": True,
        }
    except OSError as error:
        ended = monotonic_ns()
        return {
            "command": command,
            "stdout": "",
            "stderr": f"{type(error).__name__}: {error}",
            "exit_code": None,
            "started_monotonic_ns": started,
            "ended_monotonic_ns": ended,
            "elapsed_seconds": (ended - started) / 1e9,
            "timeout": False,
        }


def archive_generated() -> None:
    ATTEMPTS.mkdir(exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for directory in (RUNS, ARTIFACTS):
        if directory.exists() and any(directory.iterdir()):
            destination = ATTEMPTS / f"{stamp}-{directory.name}"
            counter = 1
            while destination.exists():
                destination = ATTEMPTS / f"{stamp}-{counter}-{directory.name}"
                counter += 1
            directory.rename(destination)
        directory.mkdir(parents=True, exist_ok=True)
    QUARANTINE.mkdir(parents=True, exist_ok=True)
    FIGURES.mkdir(parents=True, exist_ok=True)


def audit_plugins() -> tuple[dict[str, Any], list[str]]:
    audit: dict[str, Any] = {
        "started_monotonic_ns": monotonic_ns(),
        "directories": [],
        "entries": [],
    }
    failures: list[str] = []
    for directory in PLUGIN_DIRS:
        audit["directories"].append(
            {
                "path": str(directory),
                "exists": directory.exists(),
                "readable": os.access(directory, os.R_OK) if directory.exists() else None,
                "writable": os.access(directory, os.W_OK) if directory.exists() else None,
            }
        )
        for name in PLUGINS:
            entry = directory / name
            if not os.path.lexists(entry):
                continue
            record: dict[str, Any] = {
                "path": str(entry),
                "name": name,
                "is_symlink": entry.is_symlink(),
                "action": "retained",
            }
            stale_reason: str | None = None
            try:
                lstat = entry.lstat()
                record["mode"] = oct(lstat.st_mode)
                if entry.is_symlink():
                    record["symlink_target"] = os.readlink(entry)
                    if not entry.exists():
                        stale_reason = "broken_symlink"
                if stale_reason is None and not os.access(entry, os.R_OK):
                    stale_reason = "unreadable_file"
                if stale_reason is None and entry.is_file() and not os.access(entry, os.X_OK):
                    stale_reason = "non_executable_regular_file"
            except OSError as error:
                stale_reason = "unreadable_file"
                record["inspection_error"] = f"{type(error).__name__}: {error}"
            record["stale_reason"] = stale_reason
            if stale_reason is not None:
                destination = QUARANTINE / name
                suffix = 1
                while os.path.lexists(destination):
                    destination = QUARANTINE / f"{name}.{suffix}"
                    suffix += 1
                record["quarantine_destination"] = str(destination)
                try:
                    try:
                        os.replace(entry, destination)
                    except OSError as replace_error:
                        if replace_error.errno != 18:  # errno.EXDEV
                            raise
                        shutil.move(str(entry), str(destination))
                    record["action"] = "moved"
                except OSError as error:
                    record["action"] = "retained_stale_unwritable"
                    record["move_error"] = f"{type(error).__name__}: {error}"
                    failures.append(
                        f"stale Docker CLI plugin could not be quarantined: {entry}: {error}"
                    )
            audit["entries"].append(record)
    audit["ended_monotonic_ns"] = monotonic_ns()
    audit["moved_count"] = sum(item["action"] == "moved" for item in audit["entries"])
    audit["retained_count"] = sum(item["action"].startswith("retained") for item in audit["entries"])
    audit["valid"] = not failures
    atomic_json(ARTIFACTS / "plugin_audit.json", audit)
# Docker completion-monitor experiment

This workspace implements the strict 24-execution experiment comparing a
parent-exit completion decision (`NAIVE_ACCEPT`) with a PID-reuse-safe,
process-tree-aware decision (`TREE_ACCEPT`). Six deterministic orphan-work
fixtures and six clean controls run in primary and replay passes.

## Run

The runner never pulls an image. `python:3.12-slim` must already exist locally,
and Docker must be reachable without `sudo`.

```sh
python3 -m venv .venv
.venv/bin/pip install -r requirements.txt
PYTHONHASHSEED=0 MPLBACKEND=Agg .venv/bin/python experiment.py
```

The pre-timing protocol audits the two named stale Docker plugins, runs all
Docker gates, verifies the local base image architecture, builds with
`--pull=false --network=none`, and pins every trial to the resulting immutable
image ID. A failed gate writes `invalid_not_evaluated` and does not create a
zero-second timed section.

Outputs are written to:

- `results.json`: flat scalar headline metrics
- `artifacts/preflight.json` and `artifacts/plugin_audit.json`: complete gates
