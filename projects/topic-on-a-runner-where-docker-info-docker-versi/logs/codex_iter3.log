+                item["issue"] = f"cannot execute entry {entry.path}"
+        except OSError as error:
+            item["issue"] = f"cannot inspect/read entry {entry.path}: {type(error).__name__}: {error}"
+        if "issue" in item:
+            record["issues"].append(item["issue"])
+        record["entries"].append(item)
+    return record
 
