+                "ended_monotonic_ns": experiment.timed_end_ns,
+            },
+            "metrics": values,
+            "failed_conditions": failed,
+            "executions": experiment.executions,
+        })
+        write_flat_results(ROOT / "results.json", values)
+        disposition = "SUPPORTED" if values["hypothesis_supported"] else "REFUTED"
+        print(
+            "Ran 24 serial Docker executions (12 primary, 12 replay) with shared naive/tree monitoring.\n"
+            f"Completed {values['completed_executions']}/24 in {values['timed_section_seconds']:.3f}s; "
+            f"timeouts={values['timeout_count']}, cleanups={values['cleanup_count']}.\n"
+            f"Primary adversarial naive/aware={values['primary_naive_adversarial_accept_count']}/6 vs "
+            f"{values['primary_aware_adversarial_accept_count']}/6, p={values['primary_mcnemar_p_value']:.5f}; "
+            f"replay={values['replay_naive_adversarial_accept_count']}/6 vs "
+            f"{values['replay_aware_adversarial_accept_count']}/6, p={values['replay_mcnemar_p_value']:.5f}.\n"
+            f"Controls accepted by both: primary {values['primary_aware_control_accept_count']}/6, "
+            f"replay {values['replay_aware_control_accept_count']}/6; replay agreement "
+            f"{values['replay_agreement_count']}/12. Hypothesis {disposition}.",
+            flush=True,
+        )
+        return 0 if values["hypothesis_supported"] else 1
+    except Exception as error:
+        message = f"{type(error).__name__}: {error}"
+        values = preflight_failure_values(experiment, message)
+        write_flat_results(ROOT / "results.json", values)
+        if experiment.result_dir.exists():
+            atomic_write_json(experiment.detailed_path, {
+                "hypothesis_evaluated": False,
+                "hypothesis_supported": False,
+                "error": message,
+                "preflight": experiment.preflight,
+                "executions": experiment.executions,
+            })
+        print(f"Experiment could not complete: {message}", flush=True)
+        return 2
 
 
