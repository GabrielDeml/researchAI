+    def run_schedule(self) -> None:
+        schedule = [
+            (fixture, class_name)
+            for fixture in FIXTURES
+            for class_name in ("adversarial", "control")
+        ]
+        self.timed_start_ns = monotonic_ns()
+        stop_scheduling = False
+        for phase in ("primary", "replay"):
+            for ordinal, (fixture, class_name) in enumerate(schedule, 1):
+                if (monotonic_ns() - self.timed_start_ns) / 1e9 >= TIMED_LIMIT_SECONDS:
+                    stop_scheduling = True
+                    break
+                record = self.execute_one(phase, fixture, class_name, ordinal)
+                self.executions.append(record)
+                self.write_csv()
+                print(
+                    f"{phase} {ordinal:02d}/12 {fixture['fixture']} {class_name}: "
+                    f"complete={record['complete']} semantic={record['semantic_valid']} "
+                    f"delay={record['aware_delay_after_parent_exit_s']:.3f}s",
+                    flush=True,
+                )
+            if stop_scheduling:
+                break
+        self.timed_end_ns = monotonic_ns()
 
