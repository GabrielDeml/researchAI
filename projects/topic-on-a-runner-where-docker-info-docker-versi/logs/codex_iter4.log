+def attempt_exact_socket() -> dict[str, Any]:
+    """Start Docker Desktop on macOS and make only the mandated endpoint usable."""
+    socket = Path("/var/run/docker.sock")
+    evidence: dict[str, Any] = {
+        "platform": platform.system(),
