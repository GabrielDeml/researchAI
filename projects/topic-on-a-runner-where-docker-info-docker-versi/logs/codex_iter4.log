+    socket = Path("/var/run/docker.sock")
+    evidence: dict[str, Any] = {
+        "platform": platform.system(),
+        "required_endpoint": DOCKER_HOST,
+        "socket_initially_exists": socket.exists(),
+        "actions": [],
