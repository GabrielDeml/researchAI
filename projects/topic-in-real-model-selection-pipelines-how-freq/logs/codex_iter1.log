+    selection_odds_ratio = baseline_odds / comparison_odds
+
+    fixture_summary = build_fixture_summary(records_df)
+    stratum_order = ["A-B=+0.10", "A-B=+0.02", "A-B=-0.02", "A-B=-0.10"]
+    stratum_shifts = {
+        stratum: float(
