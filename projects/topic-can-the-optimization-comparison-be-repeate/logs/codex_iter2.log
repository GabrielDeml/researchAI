   387	    d_replicates = np.median(deltas[indices], axis=1)
   388	    q_replicates = np.mean(q_values[indices], axis=1)
   389	    d_ci = tuple(
   390	        float(value)
   391	        for value in np.quantile(
   392	            d_replicates, [0.025, 0.975], method="linear"
   393	        )
   394	    )
   395	    q_ci = tuple(
   396	        float(value)
   397	        for value in np.quantile(
   398	            q_replicates, [0.025, 0.975], method="linear"
   399	        )
   400	    )
   401	    return float(np.median(deltas)), d_ci, float(np.mean(q_values)), q_ci
