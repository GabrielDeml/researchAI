+#!/usr/bin/env python3
+"""Preregistered calibration-optimism and batch-size experiment.
+
+This script deliberately keeps every design constant at module scope.  It writes
+the preregistration and calibration selection checkpoint before evaluating any
+held-out observation, then repeats the whole deterministic computation in memory
+and checks byte-identical tabular/summary serialization.
+"""
+
+from __future__ import annotations
+
+import json
+import platform
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+import pandas as pd
+
+
+MASTER_SEED = 20250308
+BOOTSTRAP_D_SEED = 20250309
+BOOTSTRAP_DELTA_SEED = 20250310
+PLOT_JITTER_SEED = 20250311
+N_SPLITS = 40
+N_OBSERVATIONS = 16
+N_BOOTSTRAP = 10_000
+N_BITS = 20
+TARGET_SUCCESS_RATE = 0.50
+OPTIMISM_THRESHOLD = 0.08
+BATCH_SIZE = 16
+POPULATION_GRID = (8, 16, 32)
+MUTATION_GRID = (0.025, 0.05, 0.10, 0.20)
+BUDGET_GRID = (64, 128, 256, 512)
+MAX_BUDGET = max(BUDGET_GRID)
+BIT_MASK = (1 << N_BITS) - 1
+
+ROOT = Path(__file__).resolve().parent
+RESULTS_DIR = ROOT / "results"
+FIGURES_DIR = ROOT / "figures"
+
+
+@dataclass(frozen=True)
+class RandomPlan:
+    target: int
+    initial_population: np.ndarray
+    tournaments: np.ndarray
+    crossover_masks: np.ndarray
+    mutation_uniforms: np.ndarray
+
+
+def package_versions() -> dict[str, str]:
+    return {
+        "python": platform.python_version(),
+        "numpy": np.__version__,
+        "pandas": pd.__version__,
+        "matplotlib": matplotlib.__version__,
+    }
+
+
+def observation_seed(split: int, partition: int, observation: int) -> np.random.SeedSequence:
+    return np.random.SeedSequence([MASTER_SEED, split, partition, observation])
+
+
+def booleans_to_masks(draws: np.ndarray) -> np.ndarray:
+    """Pack rows of 20 booleans into unsigned 20-bit integer masks."""
+    powers = np.left_shift(np.uint32(1), np.arange(N_BITS, dtype=np.uint32))
+    return (draws.astype(np.uint32) @ powers).astype(np.uint32)
+
+
+def build_plan(split: int, partition: int, observation: int, population_size: int) -> RandomPlan:
+    # Re-spawning from the observation SeedSequence for every configuration is
+    # intentional: equal-P configurations receive identical plans.
+    target_ss, initial_ss, tournament_ss, crossover_ss, mutation_ss = observation_seed(
+        split, partition, observation
+    ).spawn(5)
+    target_rng = np.random.Generator(np.random.PCG64(target_ss))
+    initial_rng = np.random.Generator(np.random.PCG64(initial_ss))
+    tournament_rng = np.random.Generator(np.random.PCG64(tournament_ss))
+    crossover_rng = np.random.Generator(np.random.PCG64(crossover_ss))
+    mutation_rng = np.random.Generator(np.random.PCG64(mutation_ss))
+
+    target = int(target_rng.integers(0, 1 << N_BITS, dtype=np.uint32))
+    initial = initial_rng.integers(
+        0, 1 << N_BITS, size=population_size, dtype=np.uint32
+    )
+    n_offspring = MAX_BUDGET - population_size
+    tournaments = tournament_rng.integers(
+        0, population_size, size=(n_offspring, 4), dtype=np.int32
+    )
+    crossover_draws = crossover_rng.random((n_offspring, N_BITS)) < 0.5
+    crossover_masks = booleans_to_masks(crossover_draws)
+    mutation_uniforms = mutation_rng.random((n_offspring, N_BITS))
+    return RandomPlan(target, initial, tournaments, crossover_masks, mutation_uniforms)
+
+
+def fitness(individual: int, target: int) -> int:
+    return N_BITS - (individual ^ target).bit_count()
+
+
+def initial_state(plan: RandomPlan) -> tuple[np.ndarray, np.ndarray, int | None]:
+    population = plan.initial_population.copy()
+    fitnesses = np.fromiter(
+        (fitness(int(value), plan.target) for value in population),
+        dtype=np.int16,
+        count=len(population),
+    )
+    matches = np.flatnonzero(population == plan.target)
+    first_success = int(matches[0] + 1) if len(matches) else None
+    return population, fitnesses, first_success
+
+
+def mutation_masks(uniforms: np.ndarray, mutation_rate: float) -> np.ndarray:
+    return booleans_to_masks(uniforms < mutation_rate)
+
+
+def select_parent(population: np.ndarray, fitnesses: np.ndarray, first: int, second: int) -> int:
+    selected = first if fitnesses[first] >= fitnesses[second] else second
+    return int(population[selected])
+
+
+def make_child(
+    population: np.ndarray,
+    fitnesses: np.ndarray,
+    tournament_row: np.ndarray,
+    crossover_mask: int,
+    mutation_mask: int,
+) -> int:
+    parent_1 = select_parent(
+        population, fitnesses, int(tournament_row[0]), int(tournament_row[1])
+    )
+    parent_2 = select_parent(
+        population, fitnesses, int(tournament_row[2]), int(tournament_row[3])
+    )
+    child = (parent_1 & crossover_mask) | (parent_2 & (BIT_MASK ^ crossover_mask))
+    return child ^ mutation_mask
+
+
+def replace_if_eligible(
+    population: np.ndarray, fitnesses: np.ndarray, child: int, child_fitness: int
+) -> None:
+    replacement_index = int(np.argmin(fitnesses))
+    if child_fitness >= int(fitnesses[replacement_index]):
+        population[replacement_index] = child
+        fitnesses[replacement_index] = child_fitness
+
+
+def run_serial(plan: RandomPlan, mutation_rate: float, budget: int) -> tuple[int, int]:
+    population, fitnesses, first_success = initial_state(plan)
+    population_size = len(population)
+    assert population_size <= budget
+    if first_success is not None:
+        assert first_success <= budget
+        return 1, first_success
+
+    masks = mutation_masks(plan.mutation_uniforms[: budget - population_size], mutation_rate)
+    evaluations_used = population_size
+    for offspring_index in range(budget - population_size):
+        child = make_child(
+            population,
+            fitnesses,
+            plan.tournaments[offspring_index],
+            int(plan.crossover_masks[offspring_index]),
+            int(masks[offspring_index]),
+        )
+        evaluations_used += 1
+        child_fitness = fitness(child, plan.target)
+        if child == plan.target:
+            assert evaluations_used <= budget
+            return 1, evaluations_used
+        replace_if_eligible(population, fitnesses, child, child_fitness)
+
+    assert evaluations_used == budget
+    return 0, evaluations_used
+
+
+def run_serial_all_budgets(plan: RandomPlan, mutation_rate: float) -> dict[int, tuple[int, int]]:
+    """One maximum-budget trajectory, reported at every budget prefix."""
+    population, fitnesses, first_success = initial_state(plan)
+    population_size = len(population)
+    masks = mutation_masks(plan.mutation_uniforms, mutation_rate)
+    success_evaluation = first_success
+
+    if success_evaluation is None:
+        for offspring_index in range(MAX_BUDGET - population_size):
+            child = make_child(
+                population,
+                fitnesses,
+                plan.tournaments[offspring_index],
+                int(plan.crossover_masks[offspring_index]),
+                int(masks[offspring_index]),
+            )
+            evaluation = population_size + offspring_index + 1
+            child_fitness = fitness(child, plan.target)
+            if child == plan.target:
+                success_evaluation = evaluation
+                break
+            replace_if_eligible(population, fitnesses, child, child_fitness)
+
+    outcomes: dict[int, tuple[int, int]] = {}
+    for budget in BUDGET_GRID:
+        success = int(success_evaluation is not None and success_evaluation <= budget)
+        evaluations_used = min(success_evaluation, budget) if success_evaluation is not None else budget
+        assert evaluations_used <= budget
+        outcomes[budget] = (success, int(evaluations_used))
+    return outcomes
+
+
+def run_batch(plan: RandomPlan, mutation_rate: float, budget: int) -> tuple[int, int]:
+    population, fitnesses, first_success = initial_state(plan)
+    population_size = len(population)
+    assert population_size <= budget
+    if first_success is not None:
+        return 1, first_success
+
+    n_offspring = budget - population_size
+    masks = mutation_masks(plan.mutation_uniforms[:n_offspring], mutation_rate)
+    any_success = False
+    evaluations_used = population_size
+
+    for batch_start in range(0, n_offspring, BATCH_SIZE):
+        batch_end = min(batch_start + BATCH_SIZE, n_offspring)
+        frozen_population = population.copy()
+        frozen_fitnesses = fitnesses.copy()
+        children: list[tuple[int, int]] = []
+        for offspring_index in range(batch_start, batch_end):
+            child = make_child(
+                frozen_population,
+                frozen_fitnesses,
+                plan.tournaments[offspring_index],
+                int(plan.crossover_masks[offspring_index]),
+                int(masks[offspring_index]),
+            )
+            child_fitness = fitness(child, plan.target)
+            children.append((child, child_fitness))
+            any_success = any_success or child == plan.target
+            evaluations_used += 1
+
+        # The entire batch is evaluated against the frozen population before
+        # creation-order replacement is applied to the live population.
+        for child, child_fitness in children:
+            replace_if_eligible(population, fitnesses, child, child_fitness)
+        if any_success:
+            assert evaluations_used <= budget
+            return 1, evaluations_used
+
+    assert evaluations_used == budget
+    return 0, evaluations_used
+
+
+def write_csv(frame: pd.DataFrame, path: Path) -> bytes:
+    text = frame.to_csv(index=False, lineterminator="\n", float_format="%.12g")
+    data = text.encode("utf-8")
+    path.write_bytes(data)
+    return data
+
+
+def csv_bytes(frame: pd.DataFrame) -> bytes:
+    return frame.to_csv(index=False, lineterminator="\n", float_format="%.12g").encode("utf-8")
+
+
+def canonical_json_bytes(value: object) -> bytes:
+    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n").encode("utf-8")
+
+
+def preregistration() -> dict[str, object]:
+    return {
+        "master_seed": MASTER_SEED,
+        "fixed_grid": {
+            "population_sizes": list(POPULATION_GRID),
+            "mutation_rates": list(MUTATION_GRID),
+            "evaluation_budgets": list(BUDGET_GRID),
+        },
+        "selection_target": TARGET_SUCCESS_RATE,
+        "selection_tiebreak": ["lower_budget", "lower_population", "lower_mutation_rate"],
+        "primary_estimand": "median(h_s)-median(a_s)",
+        "primary_sample_size_splits": N_SPLITS,
+        "observations_per_partition_per_split": N_OBSERVATIONS,
+        "primary_confidence_interval": "paired split bootstrap percentile 95%, 10000 resamples, seed 20250309",
+        "primary_decision_rule": "support iff D >= 0.08; otherwise refute",
+        "secondary_estimand": "mean(batch_success-serial_success)",
+        "secondary_paired_sample_size": N_SPLITS * N_OBSERVATIONS,
+        "secondary_confidence_interval": "cluster bootstrap percentile 95%, 10000 resamples, seed 20250310",
+        "secondary_decision_rule": "batch superior iff CI low > 0; serial superior iff CI high < 0; otherwise no detectable difference",
+        "package_versions": package_versions(),
+    }
+
+
+def calibrate() -> tuple[pd.DataFrame, pd.DataFrame]:
+    rows: list[dict[str, int | float]] = []
+    selected_rows: list[dict[str, int | float]] = []
+    fixed_grid = {
+        (population, mutation, budget)
+        for population in POPULATION_GRID
+        for mutation in MUTATION_GRID
+        for budget in BUDGET_GRID
+    }
+
+    for split in range(N_SPLITS):
+        successes = {configuration: 0 for configuration in fixed_grid}
+        observation_count = 0
+        for observation in range(N_OBSERVATIONS):
+            observation_count += 1
+            for population in POPULATION_GRID:
+                plan = build_plan(split, 0, observation, population)
+                for mutation in MUTATION_GRID:
+                    outcomes = run_serial_all_budgets(plan, mutation)
+                    for budget, (success, evaluations_used) in outcomes.items():
+                        assert evaluations_used <= budget
+                        successes[(population, mutation, budget)] += success
+        assert observation_count == N_OBSERVATIONS
+
+        for population in POPULATION_GRID:
+            for mutation in MUTATION_GRID:
+                for budget in BUDGET_GRID:
+                    success_count = successes[(population, mutation, budget)]
+                    rate = success_count / N_OBSERVATIONS
+                    assert 0.0 <= rate <= 1.0
+                    rows.append(
+                        {
+                            "split": split,
+                            "population_size": population,
+                            "mutation_rate": mutation,
+                            "evaluation_budget": budget,
+                            "calibration_observations": N_OBSERVATIONS,
+                            "calibration_successes": success_count,
+                            "calibration_success_rate": rate,
+                            "target_deviation": abs(rate - TARGET_SUCCESS_RATE),
+                        }
+                    )
+
+        split_rows = [row for row in rows if row["split"] == split]
+        chosen = min(
+            split_rows,
+            key=lambda row: (
+                row["target_deviation"],
+                row["evaluation_budget"],
+                row["population_size"],
+                row["mutation_rate"],
+            ),
+        )
+        chosen_configuration = (
+            int(chosen["population_size"]),
+            float(chosen["mutation_rate"]),
+            int(chosen["evaluation_budget"]),
+        )
+        assert chosen_configuration in fixed_grid
+        selected_rows.append(
+            {
+                "split": split,
+                "population_size": chosen_configuration[0],
+                "mutation_rate": chosen_configuration[1],
+                "evaluation_budget": chosen_configuration[2],
+                "calibration_successes": int(chosen["calibration_successes"]),
+                "c_s": float(chosen["calibration_success_rate"]),
+                "a_s": float(chosen["target_deviation"]),
+            }
+        )
+
+    configuration_results = pd.DataFrame(rows)
+    selected = pd.DataFrame(selected_rows)
+    assert len(configuration_results) == N_SPLITS * len(fixed_grid)
+    assert len(selected) == N_SPLITS
+    return configuration_results, selected
+
+
+def validate(selected: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
+    paired_rows: list[dict[str, int | float]] = []
+    split_rows: list[dict[str, int | float]] = []
+
+    for selected_row in selected.itertuples(index=False):
+        split = int(selected_row.split)
+        population = int(selected_row.population_size)
+        mutation = float(selected_row.mutation_rate)
+        budget = int(selected_row.evaluation_budget)
+        assert (population, mutation, budget) in {
+            (p, m, b) for p in POPULATION_GRID for m in MUTATION_GRID for b in BUDGET_GRID
+        }
+        serial_successes = 0
+        batch_successes = 0
+        observation_count = 0
+
+        for observation in range(N_OBSERVATIONS):
+            observation_count += 1
+            plan = build_plan(split, 1, observation, population)
+            serial_success, serial_evaluations = run_serial(plan, mutation, budget)
+            batch_success, batch_evaluations = run_batch(plan, mutation, budget)
+            assert serial_evaluations <= budget
+            assert batch_evaluations <= budget
+            serial_successes += serial_success
+            batch_successes += batch_success
+            paired_rows.append(
+                {
+                    "split": split,
+                    "observation": observation,
+                    "population_size": population,
+                    "mutation_rate": mutation,
+                    "evaluation_budget": budget,
+                    "serial_success": serial_success,
+                    "batch16_success": batch_success,
+                    "batch_minus_serial": batch_success - serial_success,
+                    "serial_evaluations_used": serial_evaluations,
+                    "batch16_evaluations_used": batch_evaluations,
+                }
+            )
+        assert observation_count == N_OBSERVATIONS
+
+        validation_rate = serial_successes / N_OBSERVATIONS
+        batch_rate = batch_successes / N_OBSERVATIONS
+        h_s = abs(validation_rate - TARGET_SUCCESS_RATE)
+        assert all(0.0 <= rate <= 1.0 for rate in (validation_rate, batch_rate, h_s))
+        split_rows.append(
+            {
+                "split": split,
+                "population_size": population,
+                "mutation_rate": mutation,
+                "evaluation_budget": budget,
+                "calibration_successes": int(selected_row.calibration_successes),
+                "validation_serial_successes": serial_successes,
+                "validation_batch16_successes": batch_successes,
+                "c_s": float(selected_row.c_s),
+                "v_s": validation_rate,
+                "batch16_rate": batch_rate,
+                "a_s": float(selected_row.a_s),
+                "h_s": h_s,
+                "h_minus_a": h_s - float(selected_row.a_s),
+            }
+        )
+
+    paired = pd.DataFrame(paired_rows)
+    split_results = pd.DataFrame(split_rows)
+    counts = paired.groupby("split", sort=True).size().to_numpy()
+    assert len(counts) == N_SPLITS and np.all(counts == N_OBSERVATIONS)
+    assert len(paired) == N_SPLITS * N_OBSERVATIONS
+    return split_results, paired
+
+
+def bootstrap_d(a_values: np.ndarray, h_values: np.ndarray) -> tuple[float, float, float]:
+    d_value = float(np.median(h_values) - np.median(a_values))
+    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_D_SEED))
+    indices = rng.integers(0, N_SPLITS, size=(N_BOOTSTRAP, N_SPLITS))
+    replicates = np.median(h_values[indices], axis=1) - np.median(a_values[indices], axis=1)
+    low, high = np.quantile(replicates, [0.025, 0.975], method="linear")
+    return d_value, float(low), float(high)
+
+
+def bootstrap_delta(paired: pd.DataFrame) -> tuple[float, float, float]:
+    cluster_effects = (
+        paired.groupby("split", sort=True)["batch_minus_serial"].mean().to_numpy(dtype=float)
+    )
+    assert len(cluster_effects) == N_SPLITS
+    delta = float(paired["batch_minus_serial"].mean())
+    rng = np.random.Generator(np.random.PCG64(BOOTSTRAP_DELTA_SEED))
+    indices = rng.integers(0, N_SPLITS, size=(N_BOOTSTRAP, N_SPLITS))
+    replicates = cluster_effects[indices].mean(axis=1)
+    low, high = np.quantile(replicates, [0.025, 0.975], method="linear")
+    return delta, float(low), float(high)
+
+
+def summarize(split_results: pd.DataFrame, paired: pd.DataFrame) -> dict[str, object]:
+    a_values = split_results["a_s"].to_numpy(dtype=float)
+    h_values = split_results["h_s"].to_numpy(dtype=float)
+    d_value, d_low, d_high = bootstrap_d(a_values, h_values)
+    delta, delta_low, delta_high = bootstrap_delta(paired)
+    primary_decision = "supported" if d_value >= OPTIMISM_THRESHOLD else "refuted"
+    if delta_low > 0:
+        batch_decision = "batch-size-16 superior"
+    elif delta_high < 0:
+        batch_decision = "serial superior"
+    else:
+        batch_decision = "no detectable difference"
+
+    frequency_frame = (
+        split_results.groupby(
+            ["population_size", "mutation_rate", "evaluation_budget"], sort=True
+        )
+        .size()
+        .reset_index(name="count")
+    )
+    frequencies = {
+        f"P{int(row.population_size)}_m{float(row.mutation_rate):g}_B{int(row.evaluation_budget)}": int(row.count)
+        for row in frequency_frame.itertuples(index=False)
+    }
+    summary: dict[str, object] = {
+        "D": d_value,
+        "D_ci_95": [d_low, d_high],
+        "optimism_threshold": OPTIMISM_THRESHOLD,
+        "threshold_decision": primary_decision,
+        "Delta": delta,
+        "Delta_ci_95": [delta_low, delta_high],
+        "batch_decision": batch_decision,
+        "selected_configuration_frequencies": frequencies,
+        "diagnostics": {
+            "median_c_s": float(split_results["c_s"].median()),
+            "median_v_s": float(split_results["v_s"].median()),
+            "median_a_s": float(split_results["a_s"].median()),
+            "median_h_s": float(split_results["h_s"].median()),
+            "splits_h_greater_a": int((split_results["h_s"] > split_results["a_s"]).sum()),
+        },
+        "sample_sizes": {
+            "splits": N_SPLITS,
+            "calibration_observations": N_SPLITS * N_OBSERVATIONS,
+            "validation_pairs": len(paired),
+            "bootstrap_resamples": N_BOOTSTRAP,
+        },
+        "package_versions": package_versions(),
+    }
+    rates = split_results[["c_s", "v_s", "batch16_rate", "a_s", "h_s"]].to_numpy()
+    assert np.all((rates >= 0.0) & (rates <= 1.0))
+    return summary
+
+
+def flat_results(summary: dict[str, object]) -> dict[str, int | float | str | bool]:
+    diagnostics = summary["diagnostics"]
+    sample_sizes = summary["sample_sizes"]
+    versions = summary["package_versions"]
+    assert isinstance(diagnostics, dict)
+    assert isinstance(sample_sizes, dict)
+    assert isinstance(versions, dict)
+    return {
+        "primary_D": float(summary["D"]),
+        "primary_ci_low": float(summary["D_ci_95"][0]),
+        "primary_ci_high": float(summary["D_ci_95"][1]),
+        "primary_threshold": OPTIMISM_THRESHOLD,
+        "primary_hypothesis_supported": summary["threshold_decision"] == "supported",
+        "primary_decision": str(summary["threshold_decision"]),
+        "batch_Delta": float(summary["Delta"]),
+        "batch_ci_low": float(summary["Delta_ci_95"][0]),
+        "batch_ci_high": float(summary["Delta_ci_95"][1]),
+        "batch_decision": str(summary["batch_decision"]),
+        "median_calibration_success_rate": float(diagnostics["median_c_s"]),
+        "median_validation_success_rate": float(diagnostics["median_v_s"]),
+        "median_calibration_target_deviation": float(diagnostics["median_a_s"]),
+        "median_validation_target_deviation": float(diagnostics["median_h_s"]),
+        "splits_validation_deviation_greater": int(diagnostics["splits_h_greater_a"]),
+        "n_splits": int(sample_sizes["splits"]),
+        "n_calibration_observations": int(sample_sizes["calibration_observations"]),
+        "n_validation_pairs": int(sample_sizes["validation_pairs"]),
+        "n_bootstrap_resamples": int(sample_sizes["bootstrap_resamples"]),
+        "selected_unique_configurations": len(summary["selected_configuration_frequencies"]),
+        "master_seed": MASTER_SEED,
+        "python_version": str(versions["python"]),
+        "numpy_version": str(versions["numpy"]),
+        "pandas_version": str(versions["pandas"]),
+        "matplotlib_version": str(versions["matplotlib"]),
+        "reproducibility_check_passed": True,
+    }
+
+
+def compute_experiment(checkpoint: Callable[[pd.DataFrame, pd.DataFrame], None] | None = None):
+    configuration_results, selected = calibrate()
+    validation_results: list[object] = []
+    assert not validation_results, "Validation data must not exist when selection is executed"
+    if checkpoint is not None:
+        checkpoint(configuration_results, selected)
+    split_results, paired = validate(selected)
+    summary = summarize(split_results, paired)
+    return configuration_results, split_results, paired, summary
+
+
+def create_figure(split_results: pd.DataFrame, summary: dict[str, object]) -> None:
+    split_ids = split_results["split"].to_numpy()
+    a_values = split_results["a_s"].to_numpy(dtype=float)
+    h_values = split_results["h_s"].to_numpy(dtype=float)
+    jitter_rng = np.random.Generator(np.random.PCG64(PLOT_JITTER_SEED))
+
+    fig, axes = plt.subplots(1, 2, figsize=(12, 5.2))
+    left, right = axes
+    for split, a_value, h_value in zip(split_ids, a_values, h_values):
+        left.plot([split, split], [a_value, h_value], color="0.72", linewidth=1, zorder=1)
+    left.scatter(split_ids, a_values, color="#1f77b4", s=28, label="Calibration $a_s$", zorder=2)
+    left.scatter(split_ids, h_values, color="#ff7f0e", s=28, label="Validation $h_s$", zorder=3)
+    left.axhline(0.0, color="black", linewidth=1)
+    left.axhline(OPTIMISM_THRESHOLD, color="black", linestyle="--", linewidth=1)
+    left.set_xlabel("Split")
+    left.set_ylabel("Absolute deviation from 0.50")
+    left.set_title("Paired target deviations by split")
+    left.legend(frameon=False)
+
+    calibration_x = 0 + jitter_rng.uniform(-0.12, 0.12, size=N_SPLITS)
+    validation_x = 1 + jitter_rng.uniform(-0.12, 0.12, size=N_SPLITS)
+    right.scatter(calibration_x, a_values, color="#1f77b4", alpha=0.8, s=28)
+    right.scatter(validation_x, h_values, color="#ff7f0e", alpha=0.8, s=28)
+    right.hlines(np.median(a_values), -0.24, 0.24, color="#1f77b4", linewidth=4)
+    right.hlines(np.median(h_values), 0.76, 1.24, color="#ff7f0e", linewidth=4)
+    right.axhline(0.0, color="black", linewidth=1)
+    right.axhline(OPTIMISM_THRESHOLD, color="black", linestyle="--", linewidth=1)
+    right.set_xticks([0, 1], ["Calibration $a_s$", "Validation $h_s$"])
+    right.set_ylabel("Absolute deviation from 0.50")
+    right.set_title("Empirical distributions and medians")
+    d_low, d_high = summary["D_ci_95"]
+    right.text(
+        0.04,
+        0.96,
+        f"D = {summary['D']:.4f}\n95% bootstrap CI [{d_low:.4f}, {d_high:.4f}]",
+        transform=right.transAxes,
+        ha="left",
+        va="top",
+        bbox={"facecolor": "white", "edgecolor": "0.8", "alpha": 0.9},
+    )
+    fig.tight_layout()
+    fig.savefig(RESULTS_DIR / "calibration_optimism.png", dpi=160)
+    fig.savefig(FIGURES_DIR / "calibration_optimism.png", dpi=160)
+    plt.close(fig)
+
+
+def main() -> None:
+    if tuple(map(int, platform.python_version_tuple()[:2])) < (3, 11):
+        raise RuntimeError("Python 3.11 or newer is required")
+    RESULTS_DIR.mkdir(exist_ok=True)
+    FIGURES_DIR.mkdir(exist_ok=True)
+    (RESULTS_DIR / "preregistration.json").write_bytes(canonical_json_bytes(preregistration()))
+
+    checkpoint_bytes: dict[str, bytes] = {}
+
+    def checkpoint(configuration_results: pd.DataFrame, selected: pd.DataFrame) -> None:
+        # These files are intentionally committed to disk before validate() is called.
+        checkpoint_bytes["configuration_results.csv"] = write_csv(
+            configuration_results, RESULTS_DIR / "configuration_results.csv"
+        )
+        checkpoint_bytes["selected_configurations_prevalidation.csv"] = write_csv(
+            selected, RESULTS_DIR / "selected_configurations_prevalidation.csv"
+        )
+
+    configuration_results, split_results, paired, summary = compute_experiment(checkpoint)
+    first_serialized = {
+        "configuration_results.csv": checkpoint_bytes["configuration_results.csv"],
+        "split_results.csv": write_csv(split_results, RESULTS_DIR / "split_results.csv"),
+        "paired_validation.csv": write_csv(paired, RESULTS_DIR / "paired_validation.csv"),
+        "summary.json": canonical_json_bytes(summary),
+    }
+    (RESULTS_DIR / "summary.json").write_bytes(first_serialized["summary.json"])
+
+    # Full second computation from the master seeds.  Comparing exact bytes is
+    # stronger than approximate numeric equality and guards every CSV field and
+    # every summary metric against accidental nondeterminism.
+    repeat_configuration, repeat_splits, repeat_paired, repeat_summary = compute_experiment()
+    repeated_serialized = {
+        "configuration_results.csv": csv_bytes(repeat_configuration),
+        "split_results.csv": csv_bytes(repeat_splits),
+        "paired_validation.csv": csv_bytes(repeat_paired),
+        "summary.json": canonical_json_bytes(repeat_summary),
+    }
+    assert first_serialized == repeated_serialized, "Complete rerun was not byte-identical"
+
+    flat = flat_results(summary)
+    (ROOT / "results.json").write_bytes(canonical_json_bytes(flat))
+    create_figure(split_results, summary)
+
+    print(
+        "Ran 40 deterministic calibration-validation splits (640 observations per partition), "
+        "48 fixed serial configurations, and 640 paired serial/batch-16 validations."
+    )
+    print(
+        f"Calibration optimism D={summary['D']:.6f}, 95% CI "
+        f"[{summary['D_ci_95'][0]:.6f}, {summary['D_ci_95'][1]:.6f}]: "
+        f"hypothesis {summary['threshold_decision']} at D >= {OPTIMISM_THRESHOLD:.2f}."
+    )
+    print(
+        f"Batch effect Delta={summary['Delta']:.6f}, 95% cluster-bootstrap CI "
+        f"[{summary['Delta_ci_95'][0]:.6f}, {summary['Delta_ci_95'][1]:.6f}]: "
+        f"{summary['batch_decision']}."
+    )
+    print("A full recomputation reproduced byte-identical CSV numeric fields and summary metrics.")
+
+
+if __name__ == "__main__":
+    main()
