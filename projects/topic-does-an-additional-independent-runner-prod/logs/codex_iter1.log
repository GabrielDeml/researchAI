+_WORKSPACE = Path(__file__).resolve().parent
+os.environ.setdefault("MPLCONFIGDIR", str(_WORKSPACE / ".matplotlib"))
+os.environ.setdefault("XDG_CACHE_HOME", str(_WORKSPACE / ".cache"))
