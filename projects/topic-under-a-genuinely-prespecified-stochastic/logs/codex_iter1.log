+SHAPE = 5.0
+LOCATION = -1.0
+SCALE = 1.5
+CUTOFFS = np.array([0.30 + 0.04 * j for j in range(11)], dtype=float)
+EPSABS = 1e-12
+EPSREL = 1e-12
+QUAD_LIMIT = 500
+WIDE_GAP = 0.001
+TIE_COUNT_THRESHOLD = 75
+WIDE_PROP_THRESHOLD = 0.80
