+    center = (proportion + z * z / (2.0 * trials)) / denominator
+    half_width = (
+        z
+        * math.sqrt(proportion * (1.0 - proportion) / trials + z * z / (4.0 * trials * trials))
+        / denominator
+    )
+    return (center - half_width, center + half_width)
+
