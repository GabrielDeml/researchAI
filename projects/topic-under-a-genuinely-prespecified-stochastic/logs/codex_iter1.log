+def skew_normal_density(x: float) -> float:
+    """Density of skew-normal(shape=5, location=-1, scale=1.5)."""
+    z = (x - LOCATION) / SCALE
+    return float(2.0 * norm.pdf(z) * norm.cdf(SHAPE * z) / SCALE)
+
