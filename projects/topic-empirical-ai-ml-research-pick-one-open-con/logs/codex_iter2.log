    n_core: float
    train_centered_logit_rms: float
    test_centered_logit_rms: float


class GrokkingTransformer(nn.Module):
    def __init__(self) -> None:
        super().__init__()
        # nn.Embedding, nn.MultiheadAttention, nn.Linear, and nn.LayerNorm all
        # retain their PyTorch default initialization.
        self.token_embedding = nn.Embedding(VOCAB_SIZE, D_MODEL)
        self.position_embedding = nn.Embedding(SEQ_LEN, D_MODEL)
        self.ln1 = nn.LayerNorm(D_MODEL)
        self.attention = nn.MultiheadAttention(
            D_MODEL, N_HEADS, dropout=0.0, batch_first=True
        )
        self.ln2 = nn.LayerNorm(D_MODEL)
        self.ff1 = nn.Linear(D_MODEL, D_FF)
        self.ff2 = nn.Linear(D_FF, D_MODEL)
        self.output = nn.Linear(D_MODEL, N_CLASSES, bias=False)
        self.register_buffer("positions", torch.arange(SEQ_LEN), persistent=False)
        self.center_output_rows()

    @torch.no_grad()
    def center_output_rows(self) -> None:
        self.output.weight.sub_(self.output.weight.mean(dim=0, keepdim=True))

    def hidden(self, tokens: torch.Tensor) -> torch.Tensor:
        x = self.token_embedding(tokens) + self.position_embedding(self.positions)[None]
        qkv = self.ln1(x)
        attn, _ = self.attention(qkv, qkv, qkv, need_weights=False)
        x = x + attn
        x = x + self.ff2(F.gelu(self.ff1(self.ln2(x))))
        return x[:, -1, :]

    def forward(self, tokens: torch.Tensor) -> torch.Tensor:
        return F.linear(self.hidden(tokens), self.output.weight)


def configure_determinism() -> None:
    if os.environ.get("PYTHONHASHSEED") != "0":
        raise RuntimeError("Run with PYTHONHASHSEED=0")
    torch.set_num_threads(4)
    # Inter-op threads may only be configured once in a process.
    try:
        torch.set_num_interop_threads(1)
    except RuntimeError:
        pass
    torch.use_deterministic_algorithms(True)


def seed_everything(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)


def make_dataset() -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
    pairs = np.array([(a, b) for a in range(P) for b in range(P)], dtype=np.int64)
    labels = (pairs[:, 0] + pairs[:, 1]) % P
    sequences = np.column_stack(
        [pairs[:, 0], pairs[:, 1], np.full(P * P, EQ_TOKEN, dtype=np.int64)]
    )
    permutation = np.random.default_rng(2025).permutation(P * P)
    train_idx, test_idx = permutation[:TRAIN_SIZE], permutation[TRAIN_SIZE:]
    return (
        torch.from_numpy(sequences[train_idx]).long(),
        torch.from_numpy(labels[train_idx]).long(),
        torch.from_numpy(sequences[test_idx]).long(),
        torch.from_numpy(labels[test_idx]).long(),
    )


def core_norm(model: nn.Module) -> float:
    # Accumulate in float64 to report an accurate scalar while parameters remain
    # float32, as required.
    with torch.no_grad():
        return float(
            sum((parameter.detach().double().square().sum() for parameter in model.parameters()),
                start=torch.zeros((), dtype=torch.float64)).item()
        )


def build_optimizer(model: nn.Module, weight_decay: float) -> torch.optim.AdamW:
    decayed: list[nn.Parameter] = []
    not_decayed: list[nn.Parameter] = []
    for parameter in model.parameters():
        (decayed if parameter.ndim >= 2 else not_decayed).append(parameter)
    return torch.optim.AdamW(
        [
            {"params": decayed, "weight_decay": weight_decay},
            {"params": not_decayed, "weight_decay": 0.0},
        ],
        lr=0.001,
        betas=(0.9, 0.98),
        eps=1e-8,
    )


@torch.no_grad()
def evaluate(
    model: GrokkingTransformer,
    step: int,
    train_x: torch.Tensor,
    train_y: torch.Tensor,
    test_x: torch.Tensor,
    test_y: torch.Tensor,
) -> EvalRecord:
    model.eval()
    train_logits = model(train_x)
    test_logits = model(test_x)

    def accuracy(logits: torch.Tensor, labels: torch.Tensor) -> float:
        return float((logits.argmax(dim=-1) == labels).float().mean().item())

    def centered_rms(logits: torch.Tensor) -> float:
        centered = logits - logits.mean(dim=-1, keepdim=True)
        return float(centered.square().mean().sqrt().item())

    return EvalRecord(
        step=step,
        train_cross_entropy=float(F.cross_entropy(train_logits, train_y).item()),
        train_accuracy=accuracy(train_logits, train_y),
        test_accuracy=accuracy(test_logits, test_y),
        n_core=core_norm(model),
        train_centered_logit_rms=centered_rms(train_logits),
        test_centered_logit_rms=centered_rms(test_logits),
    )


def optimizer_step(
    model: GrokkingTransformer,
    optimizer: torch.optim.AdamW,
    train_x: torch.Tensor,
    train_y: torch.Tensor,
) -> None:
    model.train()
    optimizer.zero_grad(set_to_none=True)
    loss = F.cross_entropy(model(train_x), train_y)
    loss.backward()
    optimizer.step()
    model.center_output_rows()


def sustained_grokking_step(history: list[EvalRecord]) -> int | None:
    for start in range(0, len(history) - 4):
        window = history[start : start + 5]
        if all(record.test_accuracy >= 0.95 for record in window):
            return window[0].step
    return None


def write_history(path: Path, histories: dict[int, list[EvalRecord]], stage: str) -> None:
    fields = ["stage", "seed", *EvalRecord.__dataclass_fields__.keys()]
    with path.open("w", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=fields)
        writer.writeheader()
        for seed, history in histories.items():
            for record in history:
                writer.writerow({"stage": stage, "seed": seed, **asdict(record)})


def run_calibration(
    seed: int,
    data: tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor],
) -> tuple[list[EvalRecord], int | None]:
    seed_everything(seed)
    model = GrokkingTransformer()
    optimizer = build_optimizer(model, weight_decay=1.0)
    history = [evaluate(model, 0, *data)]
    g: int | None = None
    for step in range(1, CALIBRATION_MAX_STEPS + 1):
        optimizer_step(model, optimizer, data[0], data[1])
        if step % EVAL_EVERY == 0:
            history.append(evaluate(model, step, *data))
            g = sustained_grokking_step(history)
            if g is not None:
                break
    return history, g


# Softmax-invisible norm-threshold grokking experiment

This workspace contains a deterministic CPU implementation of the specified
modular-addition experiment. It uses Python 3.11, PyTorch, NumPy, and
Matplotlib.

Run the complete experiment from this directory with:

```bash
PYTHONHASHSEED=0 .venv/bin/python experiment.py
