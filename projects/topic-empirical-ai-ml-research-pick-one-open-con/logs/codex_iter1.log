+#!/usr/bin/env python3
+"""Deterministic modular-addition grokking norm-threshold experiment.
+
+This implements the complete protocol in the task description.  All training is
+CPU, float32, full batch, and deterministic; audit arithmetic is float64.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import csv
+import json
+import math
+import os
+import random
+import time
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Iterable
+
+os.environ.setdefault("PYTHONHASHSEED", "0")
+os.environ.setdefault("MPLCONFIGDIR", os.path.join(os.path.dirname(os.path.abspath(__file__)), ".mplconfig"))
+os.environ.setdefault("XDG_CACHE_HOME", os.path.join(os.path.dirname(os.path.abspath(__file__)), ".cache"))
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+P = 23
+N_CLASSES = 23
+VOCAB_SIZE = 24
+EQ_TOKEN = 23
+SEQ_LEN = 3
+D_MODEL = 48
+N_HEADS = 4
+D_FF = 96
+TRAIN_SIZE = 212
+EVAL_EVERY = 25
+CALIBRATION_MAX_STEPS = 15_000
+CHECKPOINT_MAX_STEPS = 15_000
+FORK_STEPS = 4_000
+CALIBRATION_SEEDS = (11, 22, 33, 44)
+EXPERIMENTAL_SEEDS = (101, 202, 303, 404)
+ROOT = Path(__file__).resolve().parent
+
+
+@dataclass
+class EvalRecord:
+    step: int
+    train_cross_entropy: float
+    train_accuracy: float
+    test_accuracy: float
+    n_core: float
+    train_centered_logit_rms: float
+    test_centered_logit_rms: float
+
+
+class GrokkingTransformer(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        # nn.Embedding, nn.MultiheadAttention, nn.Linear, and nn.LayerNorm all
+        # retain their PyTorch default initialization.
+        self.token_embedding = nn.Embedding(VOCAB_SIZE, D_MODEL)
+        self.position_embedding = nn.Embedding(SEQ_LEN, D_MODEL)
+        self.ln1 = nn.LayerNorm(D_MODEL)
+        self.attention = nn.MultiheadAttention(
+            D_MODEL, N_HEADS, dropout=0.0, batch_first=True
+        )
+        self.ln2 = nn.LayerNorm(D_MODEL)
+        self.ff1 = nn.Linear(D_MODEL, D_FF)
+        self.ff2 = nn.Linear(D_FF, D_MODEL)
+        self.output = nn.Linear(D_MODEL, N_CLASSES, bias=False)
+        self.register_buffer("positions", torch.arange(SEQ_LEN), persistent=False)
+        self.center_output_rows()
+
+    @torch.no_grad()
+    def center_output_rows(self) -> None:
+        self.output.weight.sub_(self.output.weight.mean(dim=0, keepdim=True))
+
+    def hidden(self, tokens: torch.Tensor) -> torch.Tensor:
+        x = self.token_embedding(tokens) + self.position_embedding(self.positions)[None]
+        qkv = self.ln1(x)
+        attn, _ = self.attention(qkv, qkv, qkv, need_weights=False)
+        x = x + attn
+        x = x + self.ff2(F.gelu(self.ff1(self.ln2(x))))
+        return x[:, -1, :]
+
+    def forward(self, tokens: torch.Tensor) -> torch.Tensor:
+        return F.linear(self.hidden(tokens), self.output.weight)
+
+
+def configure_determinism() -> None:
+    if os.environ.get("PYTHONHASHSEED") != "0":
+        raise RuntimeError("Run with PYTHONHASHSEED=0")
+    torch.set_num_threads(4)
+    # Inter-op threads may only be configured once in a process.
+    try:
+        torch.set_num_interop_threads(1)
+    except RuntimeError:
+        pass
+    torch.use_deterministic_algorithms(True)
+
+
+def seed_everything(seed: int) -> None:
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+
+
+def make_dataset() -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    pairs = np.array([(a, b) for a in range(P) for b in range(P)], dtype=np.int64)
+    labels = (pairs[:, 0] + pairs[:, 1]) % P
+    sequences = np.column_stack(
+        [pairs[:, 0], pairs[:, 1], np.full(P * P, EQ_TOKEN, dtype=np.int64)]
+    )
+    permutation = np.random.default_rng(2025).permutation(P * P)
+    train_idx, test_idx = permutation[:TRAIN_SIZE], permutation[TRAIN_SIZE:]
+    return (
+        torch.from_numpy(sequences[train_idx]).long(),
+        torch.from_numpy(labels[train_idx]).long(),
+        torch.from_numpy(sequences[test_idx]).long(),
+        torch.from_numpy(labels[test_idx]).long(),
+    )
+
+
+def core_norm(model: nn.Module) -> float:
+    # Accumulate in float64 to report an accurate scalar while parameters remain
+    # float32, as required.
+    with torch.no_grad():
+        return float(
+            sum((parameter.detach().double().square().sum() for parameter in model.parameters()),
+                start=torch.zeros((), dtype=torch.float64)).item()
+        )
+
+
+def build_optimizer(model: nn.Module, weight_decay: float) -> torch.optim.AdamW:
+    decayed: list[nn.Parameter] = []
+    not_decayed: list[nn.Parameter] = []
+    for parameter in model.parameters():
+        (decayed if parameter.ndim >= 2 else not_decayed).append(parameter)
+    return torch.optim.AdamW(
+        [
+            {"params": decayed, "weight_decay": weight_decay},
+            {"params": not_decayed, "weight_decay": 0.0},
+        ],
+        lr=0.001,
+        betas=(0.9, 0.98),
+        eps=1e-8,
+    )
+
+
+@torch.no_grad()
+def evaluate(
+    model: GrokkingTransformer,
+    step: int,
+    train_x: torch.Tensor,
+    train_y: torch.Tensor,
+    test_x: torch.Tensor,
+    test_y: torch.Tensor,
+) -> EvalRecord:
+    model.eval()
+    train_logits = model(train_x)
+    test_logits = model(test_x)
+
+    def accuracy(logits: torch.Tensor, labels: torch.Tensor) -> float:
+        return float((logits.argmax(dim=-1) == labels).float().mean().item())
+
+    def centered_rms(logits: torch.Tensor) -> float:
+        centered = logits - logits.mean(dim=-1, keepdim=True)
+        return float(centered.square().mean().sqrt().item())
+
+    return EvalRecord(
+        step=step,
+        train_cross_entropy=float(F.cross_entropy(train_logits, train_y).item()),
+        train_accuracy=accuracy(train_logits, train_y),
+        test_accuracy=accuracy(test_logits, test_y),
+        n_core=core_norm(model),
+        train_centered_logit_rms=centered_rms(train_logits),
+        test_centered_logit_rms=centered_rms(test_logits),
+    )
+
+
+def optimizer_step(
+    model: GrokkingTransformer,
+    optimizer: torch.optim.AdamW,
+    train_x: torch.Tensor,
+    train_y: torch.Tensor,
+) -> None:
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    loss = F.cross_entropy(model(train_x), train_y)
+    loss.backward()
+    optimizer.step()
+    model.center_output_rows()
+
+
+def sustained_grokking_step(history: list[EvalRecord]) -> int | None:
+    for start in range(0, len(history) - 4):
+        window = history[start : start + 5]
+        if all(record.test_accuracy >= 0.95 for record in window):
+            return window[0].step
+    return None
+
+
+def write_history(path: Path, histories: dict[int, list[EvalRecord]], stage: str) -> None:
+    fields = ["stage", "seed", *EvalRecord.__dataclass_fields__.keys()]
+    with path.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for seed, history in histories.items():
+            for record in history:
+                writer.writerow({"stage": stage, "seed": seed, **asdict(record)})
+
+
+def run_calibration(
+    seed: int,
+    data: tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor],
+) -> tuple[list[EvalRecord], int | None]:
+    seed_everything(seed)
+    model = GrokkingTransformer()
+    optimizer = build_optimizer(model, weight_decay=1.0)
+    history = [evaluate(model, 0, *data)]
+    g: int | None = None
+    for step in range(1, CALIBRATION_MAX_STEPS + 1):
+        optimizer_step(model, optimizer, data[0], data[1])
+        if step % EVAL_EVERY == 0:
+            history.append(evaluate(model, step, *data))
+            g = sustained_grokking_step(history)
+            if g is not None:
+                break
+    return history, g
+
+
+def record_at(history: list[EvalRecord], step: int) -> EvalRecord:
+    matches = [record for record in history if record.step == step]
+    if len(matches) != 1:
+        raise RuntimeError(f"Expected one history row at step {step}, found {len(matches)}")
+    return matches[0]
+
+
+def find_checkpoint(
+    seed: int,
+    threshold: float,
+    data: tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor],
+) -> tuple[dict[str, Any] | None, list[EvalRecord]]:
+    seed_everything(seed)
+    model = GrokkingTransformer()
+    optimizer = build_optimizer(model, weight_decay=1.0)
+    history: list[EvalRecord] = []
+    for step in range(0, CHECKPOINT_MAX_STEPS + 1):
+        if step % EVAL_EVERY == 0:
+            record = evaluate(model, step, *data)
+            history.append(record)
+            if (
+                record.train_accuracy == 1.0
+                and record.train_cross_entropy <= 0.02
+                and record.test_accuracy < 0.95
+                and record.n_core <= threshold
+                and 2.0 * record.n_core > threshold
+            ):
+                checkpoint = {
+                    "seed": seed,
+                    "step": step,
+                    "record": asdict(record),
+                    "model_state": copy.deepcopy(model.state_dict()),
+                    "optimizer_state": copy.deepcopy(optimizer.state_dict()),
+                }
+                return checkpoint, history
+        if step < CHECKPOINT_MAX_STEPS:
+            optimizer_step(model, optimizer, data[0], data[1])
+    return None, history
+
+
+@torch.no_grad()
+def audit_intervention(
+    model: GrokkingTransformer,
+    a: torch.Tensor,
+    all_x: torch.Tensor,
+    n_core: float,
+) -> tuple[float, float, float, float]:
+    model.eval()
+    hidden = model.hidden(all_x).double()
+    core_logits = F.linear(hidden, model.output.weight.double())
+    common_shift = hidden @ a.double()
+    effective_logits = core_logits + common_shift[:, None]
+    softmax_error = float(
+        (torch.softmax(effective_logits, dim=-1) - torch.softmax(core_logits, dim=-1))
+        .abs()
+        .max()
+        .item()
+    )
+    centered_core = core_logits - core_logits.mean(dim=-1, keepdim=True)
+    centered_effective = effective_logits - effective_logits.mean(dim=-1, keepdim=True)
+    centered_error = float((centered_effective - centered_core).abs().max().item())
+    initial_n_int = n_core + N_CLASSES * float(a.double().square().sum().item())
+    norm_error = abs(initial_n_int / (2.0 * n_core) - 1.0)
+    return softmax_error, centered_error, norm_error, initial_n_int
+
+
+def clone_fork(
+    checkpoint: dict[str, Any],
+) -> tuple[GrokkingTransformer, torch.optim.AdamW]:
+    model = GrokkingTransformer()
+    model.load_state_dict(checkpoint["model_state"])
+    optimizer = build_optimizer(model, weight_decay=1.0)
+    optimizer.load_state_dict(checkpoint["optimizer_state"])
+    for group in optimizer.param_groups:
+        group["weight_decay"] = 0.0
+    return model, optimizer
+
+
+def same_core_state(a: GrokkingTransformer, b: GrokkingTransformer) -> bool:
+    return all(torch.equal(x, y) for x, y in zip(a.state_dict().values(), b.state_dict().values()))
+
+
+def run_forks(
+    checkpoint: dict[str, Any],
+    threshold: float,
+    data: tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor],
+) -> dict[str, Any]:
+    seed = int(checkpoint["seed"])
+    checkpoint_step = int(checkpoint["step"])
+    checkpoint_n_core = float(checkpoint["record"]["n_core"])
+    baseline_model, baseline_optimizer = clone_fork(checkpoint)
+    intervention_model, intervention_optimizer = clone_fork(checkpoint)
+    if not same_core_state(baseline_model, intervention_model):
+        raise RuntimeError("Fork model copies differ at checkpoint")
+
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(10_000 + seed)
+    a = torch.randn(D_MODEL, generator=generator, dtype=torch.float64)
+    a /= torch.linalg.vector_norm(a)
+    a *= math.sqrt(checkpoint_n_core / N_CLASSES)
+    all_x = torch.cat([data[0], data[2]], dim=0)
+    softmax_error, centered_error, norm_error, initial_n_int = audit_intervention(
+        intervention_model, a, all_x, checkpoint_n_core
+    )
+
+    baseline_history = [evaluate(baseline_model, checkpoint_step, *data)]
+    intervention_history = [evaluate(intervention_model, checkpoint_step, *data)]
+    intervention_n_int = [initial_n_int]
+    crossing_step: int | None = None
+    frozen = False
+
+    for post_step in range(1, FORK_STEPS + 1):
+        # Both copies execute the same sequence of core-model operations.
+        optimizer_step(baseline_model, baseline_optimizer, data[0], data[1])
+        optimizer_step(intervention_model, intervention_optimizer, data[0], data[1])
+
+        current_core_norm = core_norm(intervention_model)
+        current_n_int = current_core_norm + N_CLASSES * float(a.square().sum().item())
+        if not frozen:
+            if current_n_int > threshold:
+                a.mul_(0.99)
+                current_n_int = current_core_norm + N_CLASSES * float(a.square().sum().item())
+            if current_n_int <= threshold:
+                crossing_step = post_step
+                frozen = True
+
+        if post_step % EVAL_EVERY == 0:
+            absolute_step = checkpoint_step + post_step
+            baseline_history.append(evaluate(baseline_model, absolute_step, *data))
+            intervention_history.append(evaluate(intervention_model, absolute_step, *data))
+            intervention_n_int.append(current_n_int)
+            if not same_core_state(baseline_model, intervention_model):
+                raise RuntimeError(f"Core fork states diverged for seed {seed} at {post_step}")
+
+    baseline_g = sustained_grokking_step(baseline_history)
+    intervention_g = sustained_grokking_step(intervention_history)
+    baseline_delay = None if baseline_g is None else baseline_g - checkpoint_step
+    intervention_delay = None if intervention_g is None else intervention_g - checkpoint_step
+    relative_shift = (
+        None
+        if baseline_delay in (None, 0) or intervention_delay is None
+        else abs(intervention_delay - baseline_delay) / baseline_delay
+    )
+    return {
+        "seed": seed,
+        "checkpoint_step": checkpoint_step,
+        "threshold": threshold,
+        "checkpoint_n_core": checkpoint_n_core,
+        "initial_n_int": initial_n_int,
+        "threshold_crossing_delay": crossing_step,
+        "baseline_grokking_delay": baseline_delay,
+        "intervention_grokking_delay": intervention_delay,
+        "relative_grokking_shift": relative_shift,
+        "softmax_invariance_error": softmax_error,
+        "centered_logit_invariance_error": centered_error,
+        "norm_doubling_relative_error": norm_error,
+        "baseline_history": baseline_history,
+        "intervention_history": intervention_history,
+        "intervention_n_int": intervention_n_int,
+    }
+
+
+def write_results_csv(results: list[dict[str, Any]]) -> None:
+    fields = [
+        "seed",
+        "checkpoint_step",
+        "threshold",
+        "checkpoint_n_core",
+        "initial_n_int",
+        "threshold_crossing_delay",
+        "baseline_grokking_delay",
+        "intervention_grokking_delay",
+        "relative_grokking_shift",
+        "softmax_invariance_error",
+        "centered_logit_invariance_error",
+        "norm_doubling_relative_error",
+    ]
+    with (ROOT / "results.csv").open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for result in results:
+            writer.writerow({field: result[field] for field in fields})
+
+
+def write_unavailable_results_csv(error: str) -> None:
+    """Preserve the requested one-row-per-experimental-seed CSV on early failure."""
+    fields = [
+        "seed", "checkpoint_step", "threshold", "checkpoint_n_core", "initial_n_int",
+        "threshold_crossing_delay", "baseline_grokking_delay",
+        "intervention_grokking_delay", "relative_grokking_shift",
+        "softmax_invariance_error", "centered_logit_invariance_error",
+        "norm_doubling_relative_error", "error",
+    ]
+    with (ROOT / "results.csv").open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for seed in EXPERIMENTAL_SEEDS:
+            writer.writerow({"seed": seed, "error": error})
+
+
+def make_calibration_failure_figure(
+    histories: dict[int, list[EvalRecord]], error: str
+) -> None:
+    """Write an honest diagnostic in place of the unavailable fork figure."""
+    (ROOT / "figures").mkdir(exist_ok=True)
+    fig, (accuracy_ax, norm_ax) = plt.subplots(2, 1, figsize=(11, 8), sharex=True)
+    colors = plt.get_cmap("tab10").colors
+    for color, (seed, history) in zip(colors, histories.items()):
+        steps = [record.step for record in history]
+        accuracy_ax.plot(steps, [record.test_accuracy for record in history], color=color,
+                         label=f"calibration seed {seed}")
+        norm_ax.plot(steps, [record.n_core for record in history], color=color,
+                     label=f"calibration seed {seed}")
+    accuracy_ax.axhline(0.95, color="black", linewidth=1.0, alpha=0.7)
+    accuracy_ax.set_ylabel("Test accuracy")
+    accuracy_ax.set_ylim(-0.01, 1.02)
+    accuracy_ax.legend(loc="best")
+    norm_ax.set_xlabel("Optimizer step")
+    norm_ax.set_ylabel("Core squared norm")
+    norm_ax.legend(loc="best")
+    fig.suptitle("Protocol terminated before threshold/forks: " + error)
+    fig.tight_layout()
+    fig.savefig(ROOT / "figures" / "norm_threshold_intervention.png", dpi=180)
+    plt.close(fig)
+
+
+def write_fork_histories(results: list[dict[str, Any]]) -> None:
+    fields = ["seed", "fork", "post_checkpoint_step", *EvalRecord.__dataclass_fields__.keys(), "total_norm"]
+    with (ROOT / "fork_histories.csv").open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields)
+        writer.writeheader()
+        for result in results:
+            checkpoint_step = result["checkpoint_step"]
+            for fork_name, history in (
+                ("baseline", result["baseline_history"]),
+                ("intervention", result["intervention_history"]),
+            ):
+                for index, record in enumerate(history):
+                    total_norm = (
+                        record.n_core
+                        if fork_name == "baseline"
+                        else result["intervention_n_int"][index]
+                    )
+                    writer.writerow(
+                        {
+                            "seed": result["seed"],
+                            "fork": fork_name,
+                            "post_checkpoint_step": record.step - checkpoint_step,
+                            **asdict(record),
+                            "total_norm": total_norm,
+                        }
+                    )
+
+
+def make_figure(results: list[dict[str, Any]], threshold: float) -> None:
+    (ROOT / "figures").mkdir(exist_ok=True)
+    fig, (accuracy_ax, norm_ax) = plt.subplots(2, 1, figsize=(11, 9), sharex=True)
+    colors = plt.get_cmap("tab10").colors
+    for color, result in zip(colors, results):
+        seed = result["seed"]
+        checkpoint_step = result["checkpoint_step"]
+        base = result["baseline_history"]
+        intervention = result["intervention_history"]
+        x = [record.step - checkpoint_step for record in base]
+        accuracy_ax.plot(x, [record.test_accuracy for record in base], color=color,
+                         linestyle="-", label=f"seed {seed} baseline")
+        accuracy_ax.plot(x, [record.test_accuracy for record in intervention], color=color,
+                         linestyle="--", label=f"seed {seed} intervention")
+        norm_ax.plot(x, [record.n_core for record in base], color=color, linestyle="-")
+        norm_ax.plot(x, result["intervention_n_int"], color=color, linestyle="--")
+        crossing = result["threshold_crossing_delay"]
+        if crossing is not None:
+            accuracy_ax.axvline(crossing, color=color, linewidth=1.0, alpha=0.55)
+            norm_ax.axvline(crossing, color=color, linewidth=1.0, alpha=0.55)
+    accuracy_ax.axhline(0.95, color="black", linewidth=1.0, alpha=0.7)
+    norm_ax.axhline(threshold, color="black", linewidth=1.0, alpha=0.7, label="threshold T")
+    accuracy_ax.set_ylabel("Test accuracy")
+    accuracy_ax.set_ylim(-0.01, 1.02)
+    accuracy_ax.set_title("Matched no-decay forks: solid baseline, dashed invisible intervention")
+    accuracy_ax.legend(ncol=2, fontsize=8, loc="lower right")
+    norm_ax.set_xlabel("Post-checkpoint optimizer steps")
+    norm_ax.set_ylabel("Total squared norm")
+    norm_ax.set_title("Core norm (baseline) and intervention total norm")
+    norm_ax.legend(loc="best")
+    fig.tight_layout()
+    fig.savefig(ROOT / "figures" / "norm_threshold_intervention.png", dpi=180)
+    plt.close(fig)
+
+
+def write_flat_json(
+    calibration_g: dict[int, int],
+    threshold_samples: dict[int, float],
+    threshold: float,
+    results: list[dict[str, Any]],
+    decision: str,
+    elapsed_seconds: float,
+) -> None:
+    relative_shifts = [float(result["relative_grokking_shift"]) for result in results]
+    payload: dict[str, Any] = {
+        "decision": decision,
+        "hypothesis_supported": decision == "supported",
+        "fitted_norm_threshold_T": threshold,
+        "mean_relative_grokking_shift": float(np.mean(relative_shifts)),
+        "max_relative_grokking_shift": float(np.max(relative_shifts)),
+        "max_softmax_invariance_error": max(result["softmax_invariance_error"] for result in results),
+        "max_centered_logit_invariance_error": max(result["centered_logit_invariance_error"] for result in results),
+        "max_norm_doubling_relative_error": max(result["norm_doubling_relative_error"] for result in results),
+        "elapsed_seconds": elapsed_seconds,
+        "python_version": ".".join(map(str, os.sys.version_info[:3])),
+        "torch_version": torch.__version__,
+        "numpy_version": np.__version__,
+        "calibration_seed_count": len(calibration_g),
+        "experimental_seed_count": len(results),
+    }
+    for seed in CALIBRATION_SEEDS:
+        payload[f"calibration_grokking_step_seed_{seed}"] = calibration_g[seed]
+        payload[f"threshold_sample_seed_{seed}"] = threshold_samples[seed]
+    for result in results:
+        seed = result["seed"]
+        payload[f"checkpoint_step_seed_{seed}"] = result["checkpoint_step"]
+        payload[f"checkpoint_n_core_seed_{seed}"] = result["checkpoint_n_core"]
+        payload[f"initial_n_int_seed_{seed}"] = result["initial_n_int"]
+        payload[f"threshold_crossing_delay_seed_{seed}"] = result["threshold_crossing_delay"]
+        payload[f"baseline_grokking_delay_seed_{seed}"] = result["baseline_grokking_delay"]
+        payload[f"intervention_grokking_delay_seed_{seed}"] = result["intervention_grokking_delay"]
+        payload[f"relative_grokking_shift_seed_{seed}"] = result["relative_grokking_shift"]
+        payload[f"softmax_invariance_error_seed_{seed}"] = result["softmax_invariance_error"]
+        payload[f"centered_logit_invariance_error_seed_{seed}"] = result["centered_logit_invariance_error"]
+        payload[f"norm_doubling_relative_error_seed_{seed}"] = result["norm_doubling_relative_error"]
+    if any(isinstance(value, (dict, list, tuple)) for value in payload.values()):
+        raise RuntimeError("results.json must be flat")
+    (ROOT / "results.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+
+
+def fail(error: str, started: float, summary: str | None = None, **metrics: Any) -> None:
+    payload: dict[str, Any] = {
+        "decision": "refuted under this protocol",
+        "hypothesis_supported": False,
+        "error": error,
+        "elapsed_seconds": time.monotonic() - started,
+        **metrics,
+    }
+    payload = {key: value for key, value in payload.items() if not isinstance(value, (dict, list, tuple))}
+    (ROOT / "results.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    key_numbers = summary or ", ".join(f"{key}={value}" for key, value in metrics.items())
+    print(
+        f"Completed deterministic protocol through its first required failure gate. "
+        f"{key_numbers}. Decision=refuted under this protocol ({error}).",
+        flush=True,
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--smoke", action="store_true", help="Run deterministic model/step smoke test only")
+    args = parser.parse_args()
+    started = time.monotonic()
+    configure_determinism()
+    data = make_dataset()
+    assert data[0].shape == (212, 3) and data[2].shape == (317, 3)
+
+    if args.smoke:
+        seed_everything(11)
+        model = GrokkingTransformer()
+        optimizer = build_optimizer(model, weight_decay=1.0)
+        before = evaluate(model, 0, *data)
+        optimizer_step(model, optimizer, data[0], data[1])
+        after = evaluate(model, 1, *data)
+        row_mean = float(model.output.weight.mean(dim=0).abs().max().item())
+        print(json.dumps({"before_loss": before.train_cross_entropy, "after_loss": after.train_cross_entropy,
+                          "max_output_column_mean": row_mean}))
+        return 0
+
+    calibration_histories: dict[int, list[EvalRecord]] = {}
+    calibration_g: dict[int, int] = {}
+    threshold_samples: dict[int, float] = {}
+    failed_calibration_seeds: list[int] = []
+    for seed in CALIBRATION_SEEDS:
+        history, g = run_calibration(seed, data)
+        calibration_histories[seed] = history
+        write_history(ROOT / "calibration_histories.csv", calibration_histories, "calibration")
+        if g is None:
+            failed_calibration_seeds.append(seed)
+            print(
+                f"calibration seed={seed} did not grok; "
+                f"best_test={max(record.test_accuracy for record in history):.9g}",
+                flush=True,
+            )
+            continue
+        if g < 250:
+            failed_calibration_seeds.append(seed)
+            print(f"calibration seed={seed} grokked too early for g-250 sample", flush=True)
+            continue
+        calibration_g[seed] = g
+        threshold_samples[seed] = record_at(history, g - 250).n_core
+        print(f"calibration seed={seed} g={g} T_sample={threshold_samples[seed]:.9g}", flush=True)
+    if failed_calibration_seeds:
+        failed_text = ",".join(map(str, failed_calibration_seeds))
+        error = f"calibration seeds {failed_text} did not provide valid grokking thresholds"
+        metrics: dict[str, Any] = {
+            "failed_calibration_count": len(failed_calibration_seeds),
+            "completed_calibration_count": len(calibration_histories),
+        }
+        summaries: list[str] = []
+        for seed, history in calibration_histories.items():
+            best = max(record.test_accuracy for record in history)
+            final = history[-1]
+            g = sustained_grokking_step(history)
+            metrics[f"calibration_grokking_step_seed_{seed}"] = -1 if g is None else g
+            metrics[f"calibration_best_test_accuracy_seed_{seed}"] = best
+            metrics[f"calibration_final_test_accuracy_seed_{seed}"] = final.test_accuracy
+            metrics[f"calibration_final_train_accuracy_seed_{seed}"] = final.train_accuracy
+            metrics[f"calibration_final_train_cross_entropy_seed_{seed}"] = final.train_cross_entropy
+            metrics[f"calibration_final_n_core_seed_{seed}"] = final.n_core
+            metrics[f"calibration_steps_completed_seed_{seed}"] = final.step
+            summaries.append(f"seed {seed}: best_test={best:.6g}, final_test={final.test_accuracy:.6g}")
+        write_unavailable_results_csv(error)
+        make_calibration_failure_figure(calibration_histories, error)
+        fail(error, started, summary="; ".join(summaries), **metrics)
+        return 0
+    threshold = float(np.median(list(threshold_samples.values())))
+    print(f"fitted threshold T={threshold:.9g}", flush=True)
+
+    checkpoints: dict[int, dict[str, Any]] = {}
+    search_histories: dict[int, list[EvalRecord]] = {}
+    (ROOT / "checkpoints").mkdir(exist_ok=True)
+    for seed in EXPERIMENTAL_SEEDS:
+        checkpoint, history = find_checkpoint(seed, threshold, data)
+        search_histories[seed] = history
+        write_history(ROOT / "checkpoint_search_histories.csv", search_histories, "checkpoint_search")
+        if checkpoint is None:
+            fail(f"experimental seed {seed} had no valid checkpoint by step 15000", started,
+                 fitted_norm_threshold_T=threshold)
+            return 0
+        checkpoints[seed] = checkpoint
+        torch.save(checkpoint, ROOT / "checkpoints" / f"seed_{seed}.pt")
+        print(f"checkpoint seed={seed} step={checkpoint['step']} N_core={checkpoint['record']['n_core']:.9g}", flush=True)
+
+    results: list[dict[str, Any]] = []
+    for seed in EXPERIMENTAL_SEEDS:
+        result = run_forks(checkpoints[seed], threshold, data)
+        results.append(result)
+        print(
+            f"fork seed={seed} crossing={result['threshold_crossing_delay']} "
+            f"d_base={result['baseline_grokking_delay']} d_int={result['intervention_grokking_delay']} "
+            f"r={result['relative_grokking_shift']}", flush=True
+        )
+
+    write_results_csv(results)
+    write_fork_histories(results)
+    make_figure(results, threshold)
+
+    failures: list[str] = []
+    for result in results:
+        seed = result["seed"]
+        if result["softmax_invariance_error"] > 1e-10:
+            failures.append(f"seed {seed} softmax audit failed")
+        if result["centered_logit_invariance_error"] > 1e-10:
+            failures.append(f"seed {seed} centered-logit audit failed")
+        if result["norm_doubling_relative_error"] > 1e-6:
+            failures.append(f"seed {seed} norm-doubling audit failed")
+        crossing = result["threshold_crossing_delay"]
+        if crossing is None or crossing > 1000:
+            failures.append(f"seed {seed} threshold crossing failed")
+        if result["baseline_grokking_delay"] is None or result["intervention_grokking_delay"] is None:
+            failures.append(f"seed {seed} sustained grokking missing")
+        if result["relative_grokking_shift"] is None or result["relative_grokking_shift"] >= 0.10:
+            failures.append(f"seed {seed} relative shift was not below 0.10")
+    decision = "supported" if not failures else "refuted under this protocol"
+    elapsed = time.monotonic() - started
+    # Every scalar below comes from the just-completed run.
+    write_flat_json(calibration_g, threshold_samples, threshold, results, decision, elapsed)
+    shifts = [result["relative_grokking_shift"] for result in results]
+    print(
+        f"Completed 4 calibrations, 4 matched checkpoints, audits, and 8 no-decay "
+        f"fork continuations. T={threshold:.9g}; r={shifts}; mean={np.mean(shifts):.6g}; "
+        f"max={np.max(shifts):.6g}; decision={decision}; elapsed={elapsed:.1f}s.",
+        flush=True,
+    )
+    if failures:
+        print("Failures: " + "; ".join(failures), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
