+          "minimum": 0
+        },
+        "format": {
+          "enum": ["csv", "npy"]
+        }
+      }
+    },
+    "csvFile": {
+      "allOf": [
+        { "$ref": "#/$defs/commonFileFields" },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "path",
+            "sha256",
+            "size_bytes",
+            "format",
+            "columns",
+            "data_rows"
+          ],
+          "properties": {
+            "path": { "type": "string", "pattern": "\\.csv$" },
+            "sha256": { "type": "string" },
+            "size_bytes": { "type": "integer" },
+            "format": { "const": "csv" },
+            "columns": {
+              "type": "array",
+              "minItems": 1,
+              "uniqueItems": true,
+              "items": { "type": "string", "minLength": 1 }
+            },
+            "data_rows": { "type": "integer", "minimum": 0 }
+          }
+        }
+      ]
+    },
+    "npyFile": {
+      "allOf": [
+        { "$ref": "#/$defs/commonFileFields" },
+        {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "path",
+            "sha256",
+            "size_bytes",
+            "format",
+            "dtype",
+            "shape"
+          ],
+          "properties": {
+            "path": { "const": "heatmap_matrix.npy" },
+            "sha256": { "type": "string" },
+            "size_bytes": { "type": "integer" },
+            "format": { "const": "npy" },
+            "dtype": { "type": "string", "minLength": 1 },
+            "shape": {
+              "type": "array",
+              "minItems": 2,
+              "maxItems": 2,
+              "items": { "type": "integer", "minimum": 0 }
+            }
+          }
+        }
+      ]
+    }
+  }
+}
