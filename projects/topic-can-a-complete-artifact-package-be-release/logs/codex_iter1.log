+    "generator": {
+      "const": "synthetic-cross-file-validation-v1"
+    },
+    "files": {
+      "type": "array",
+      "minItems": 5,
+      "maxItems": 5,
+      "uniqueItems": true,
+      "items": {
+        "oneOf": [
+          {
+            "$ref": "#/$defs/csvFile"
+          },
+          {
+            "$ref": "#/$defs/npyFile"
+          }
+        ]
+      }
+    },
+    "relational_rules": {
+      "type": "array",
+      "prefixItems": [
+        { "const": "R1" },
+        { "const": "R2" },
+        { "const": "R3" },
+        { "const": "R4" },
+        { "const": "R5" },
+        { "const": "R6" },
+        { "const": "R7" },
+        { "const": "R8" }
+      ],
+      "items": false,
+      "minItems": 8,
+      "maxItems": 8
+    }
+  },
+  "$defs": {
+    "commonFileFields": {
+      "type": "object",
+      "required": ["path", "sha256", "size_bytes", "format"],
+      "properties": {
+        "path": {
+          "enum": [
+            "observations.csv",
+            "per_seed.csv",
+            "summary.csv",
+            "heatmap_cells.csv",
+            "heatmap_matrix.npy"
+          ]
+        },
+        "sha256": {
+          "type": "string",
+          "pattern": "^[0-9a-f]{64}$"
+        },
+        "size_bytes": {
