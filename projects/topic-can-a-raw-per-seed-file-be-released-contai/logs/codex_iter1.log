+        "initialization_failed": int(initialization_accepted < INITIALIZATION_TARGET),
+        "offspring_target": OFFSPRING_TARGET,
+        "offspring_accepted": 0,
+        "offspring_attempts": 0,
+        "offspring_misses": 0,
