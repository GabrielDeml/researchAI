+    misses = int(metrics["initialization_misses"]) + int(metrics["offspring_misses"])
+    metrics["duplicate_ratio"] = misses / denominator if denominator else 0.0
+    return metrics
+
+
+def run_generational(rng: np.random.Generator) -> RunMetrics:
